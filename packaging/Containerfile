FROM docker.io/library/golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/exocompd ./cmd/exocomp

FROM ghcr.io/astral-sh/uv:0.9.7 AS uv

FROM registry.fedoraproject.org/fedora-minimal:44 AS runtime
# uv provisions the Python/ansible toolchain per ADR 0006 (uv python install
# plus a constraints-pinned tool install); that layer lands in a later
# milestone — only the pinned uv binary ships in M0.
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=build /out/exocompd /usr/local/bin/exocompd
RUN mkdir -p /var/lib/exocomp && chown 1000:1000 /var/lib/exocomp
VOLUME ["/var/lib/exocomp"]
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/exocompd"]
