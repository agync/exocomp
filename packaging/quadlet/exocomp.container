[Unit]
Description=exocomp control plane
After=exocomp.volume

[Container]
Image=localhost/exocomp:latest
ContainerName=exocomp
Volume=exocomp.volume:/var/lib/exocomp
# The per-job run directory (dataDir/run) holds each job's private tree — where
# a captured secret is staged to a 0600 KUBECONFIG file (bootstrap-first Phase
# 3). A tmpfs mounted at this child of the data volume shadows the durable
# volume for that subtree, so a staged bearer lives in RAM and never lands on
# disk. noswap keeps it out of swap too; without it the RAM-only guarantee does
# not hold. The daemon refuses file staging unless this mount is present, so it
# is load-bearing, not an optimisation.
#
# CAVEAT (validated 2026-08-24, podman 5.8.1 lima + 5.8.4 host): the `noswap`
# option is refused on ROOTLESS tmpfs mounts — podman errors "the 'noswap'
# option is only allowed with rootful tmpfs mounts". With the rootless
# UserNS=keep-id posture below, this line prevents the container from starting.
# A rootless deployment must drop `,noswap` (the DEK mlock and at-rest
# encryption remain), or run the unit rootful. Held for the owner; not silently
# changed here so the RAM-only intent stays visible.
Tmpfs=/var/lib/exocomp/run:size=16m,mode=0700,noswap
UserNS=keep-id
# Per-job resource caps (docs/design/byo-runner.md §6) are OPT-IN and OFF in this
# default deployment: it stays rootless and capless, and a job that requests caps
# is REFUSED rather than run uncapped (fail-closed). Enforcing caps needs a
# writable cgroup v2 subtree the daemon can create child cgroups in, which this
# rootless keep-id container does not get — validated 2026-08-24: a keep-id
# non-root process is denied writes to /sys/fs/cgroup even with --systemd=always.
# To turn caps on, use the owner-approved root-in-container model: remove the
# `UserNS=keep-id` line above and add
#   PodmanArgs=--systemd=always
# so podman mounts /sys/fs/cgroup read-write and PID 1 runs as uid 0 inside the
# rootless user namespace (still no host root). The daemon then vacates its own
# cgroup and writes memory.max / memory.swap.max / cpu.max per job. `exocomp
# doctor` reports whether this is in effect under "per-job caps".
# The data dir is <XDG_DATA_HOME>/exocomp, which is the mount above.
Environment=XDG_DATA_HOME=/var/lib
# host.key at rest (finding E1): systemd decrypts the encrypted credential into
# $CREDENTIALS_DIRECTORY/host.key at start, using a secret
# (/var/lib/systemd/credential.secret, or the TPM) that never enters the data
# volume. A stolen volume holds only host.key.cred, which is useless without it.
# install.sh writes host.key.cred with `systemd-creds encrypt` and deletes the
# plaintext key; the daemon reads the credential in preference to any file.
LoadCredentialEncrypted=host.key:/var/lib/exocomp/host.key.cred
# Named rather than inherited from the image: the unit says what it runs.
Exec=serve

[Service]
# The generated unit is Type=notify by default; conmon supplies READY=1,
# so this works even though exocompd does not call sd_notify yet (M0).
Restart=always
RestartSec=5
MemoryMax=1.5G

[Install]
WantedBy=default.target
