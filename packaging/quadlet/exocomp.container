[Unit]
Description=exocomp control plane
After=exocomp.volume

[Container]
Image=localhost/exocomp:latest
ContainerName=exocomp
Volume=exocomp.volume:/var/lib/exocomp
UserNS=keep-id
# The data dir is <XDG_DATA_HOME>/exocomp, which is the mount above.
Environment=XDG_DATA_HOME=/var/lib
# Named rather than inherited from the image: the unit says what it runs.
Exec=serve

[Service]
# The generated unit is Type=notify by default; conmon supplies READY=1,
# so this works even though exocompd does not call sd_notify yet (M0).
Restart=always
RestartSec=5
MemoryMax=1.5G

[Install]
WantedBy=default.target
