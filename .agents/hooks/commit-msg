#!/bin/sh
# Dispatches to the pre-commit framework's commit-msg stage, declared in
# .pre-commit-config.yaml. Installed via `git config core.hooksPath
# .agents/hooks`; git passes the message file as $1.
set -eu

if ! command -v pre-commit >/dev/null 2>&1; then
    echo "commit-msg: pre-commit not installed — run 'pip install pre-commit'" >&2
    exit 1
fi

exec pre-commit run --hook-stage commit-msg --commit-msg-filename "$1"
