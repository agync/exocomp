#!/bin/sh
# Enforces AGENTS.md invariant 9: conventional style, <=52 char title,
# no trailers, no emoji. Installed via `git config core.hooksPath .agents/hooks`.
set -eu

msg_file=$1
subject=$(head -n 1 "$msg_file")

fail() {
    echo "commit-msg: $1" >&2
    exit 1
}

subject_len=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$subject_len" -gt 52 ]; then
    fail "title exceeds 52 chars ($subject_len): $subject"
fi

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|chore|docs|refactor|test|perf|build)(\([a-z0-9./-]+\))?: .+'; then
    fail "title must match ^(feat|fix|chore|docs|refactor|test|perf|build)(scope): summary, got: $subject"
fi

if grep -Eq '^(Co-Authored-By|Co-authored-by|Signed-off-by|Claude-Session|Generated-with|Generated with):?' "$msg_file"; then
    fail "message contains a disallowed trailer (Co-Authored-By/Signed-off-by/Claude-Session/Generated-with)"
fi

# Conservative check for the common "AI slop" emoji: robot, sparkles, rocket
# and a few celebratory glyphs — not a full unicode-emoji class.
if grep -qP '[\x{1F916}\x{2728}\x{1F680}\x{1F31F}\x{2705}\x{274C}\x{1F389}\x{1F4A1}]' "$msg_file" 2>/dev/null; then
    fail "message contains an emoji"
fi

exit 0
