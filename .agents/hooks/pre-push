#!/bin/sh
# Dispatches to the pre-commit framework's pre-push stage, declared in
# .pre-commit-config.yaml. Runs `make check-race` (the full -race suite) and
# the hygiene hooks against the working tree. Installed via `git config
# core.hooksPath .agents/hooks`.
set -eu

if ! command -v pre-commit >/dev/null 2>&1; then
    echo "pre-push: pre-commit not installed — run 'pip install pre-commit'" >&2
    exit 1
fi

exec pre-commit run --hook-stage pre-push
