#!/bin/sh
# Dispatches to the pre-commit framework's pre-commit stage, declared in
# .pre-commit-config.yaml. Runs `make check` (the fast per-commit gate) and
# the hygiene hooks against the working tree — the repo expects no unstaged
# edits at commit time. Installed via `git config core.hooksPath .agents/hooks`.
set -eu

if ! command -v pre-commit >/dev/null 2>&1; then
    echo "pre-commit: pre-commit not installed — run 'pip install pre-commit'" >&2
    exit 1
fi

exec pre-commit run --hook-stage pre-commit
