package web

// workspaceDetail is one workspace's page: identity + state facts up top, then
// the Plan verb (runs-in-server), the read-only Plans tray-table (SPEC §2.2:
// one apply affordance on the latest SAVED non-stale row, truthful
// LIFECYCLE/CHANGES/VERDICT columns), and the Backend card whose block carries
// a reference, never the bearer (SPEC §2.4: reveal is a separate, logged,
// timed action; copy never includes the value). The row's view items (Saved
// plans, Backend config) live here (R8/v0.6); the list row opens this page and
// keeps only the Plan/Apply glyphs.
templ workspaceDetail(vm workspaceDetailVM) {
	@layout(vm.Page) {
		@breadcrumb(breadcrumbCrumb{Label: "Workspaces", Href: urlWithBase(vm.Page.Base, "/workspaces")}, breadcrumbCrumb{Label: vm.Row.Name})
		<div class="card span2 mt18">
			<div class="detailmeta">
				@chip(vm.Row.TypeClass(), vm.Row.TypeLabel())
				@chip(vm.Row.StateClass(), vm.Row.StateLabel())
			</div>
			<div class="config detail-tiles">
				<div class="tile">
					<span>Dir</span>
					<b class="mono">{ vm.TileDir() }</b>
				</div>
				<a class="tile" href="#tofu-state">
					<span>Backend</span>
					<b class="mono">{ vm.TileBackend() }</b>
					<span class="tmeta">http · loopback</span>
				</a>
				<div class={ "tile", templ.KV("wait", vm.TileProviderWait()) }>
					<span>Provider mirror</span>
					<b>{ vm.TileProvider() }</b>
				</div>
				<a class="tile" href="#tofu-state">
					<span>Tofu state</span>
					<b>{ vm.TileState() }</b>
					<span class="tmeta">browse →</span>
				</a>
			</div>
			if vm.Operator && !vm.Row.StateOnly() {
				<div class="rowactions">
					<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/workspaces/" + vm.Row.Name + "/plan")) } class="inline-form">
						<button type="submit" class="btn">Plan</button>
					</form>
					<a class="btn danger" href={ templ.SafeURL("?destroy=1") } data-modal-open="ws-destroy-confirm">Destroy</a>
					@formStatus(false, vm.PlanErr)
				</div>
			}
		</div>
		<div class="card span2 mt18">
			<div class="kicker">Saved plans</div>
			<h3>Plans</h3>
			if !vm.Operator {
				<p class="meta">Read-only: registering state, planning, or applying needs an operator token.</p>
			} else if vm.Row.StateOnly() {
				<p class="meta">This workspace is state-only — an external tofu plans and applies it.</p>
			} else if len(vm.Row.Plans) == 0 {
				<p class="meta">No saved plans yet — run Plan to save one.</p>
			} else {
				<p class="meta">{ itoa(int64(len(vm.Row.Plans))) } { plural(len(vm.Row.Plans), "plan", "plans") } · newest first · latest is applicable</p>
				<div class="tray-table plans">
					<div class="row tt-col">
						<span>PLAN</span>
						<span>SERIAL</span>
						<span>SEALED</span>
						<span>CHANGES · VERDICT</span>
						<span>LIFECYCLE</span>
						<span class="th-actions">ACTIONS</span>
					</div>
					for _, plan := range vm.Row.Plans {
						<div class={ "row", templ.KV("applicable", plan.Applicable()) }>
							<span class="mono">#{ itoa(plan.ID) }</span>
							<span class="mono">{ itoa64(plan.PlanSerial) }</span>
							<span class="mono">{ plan.Sealed }</span>
							<div class="cv">
								if plan.Changes.Present {
									<span class="counters">
										<span class="n-add">{ "+" + itoa(int64(plan.Changes.Create)) }</span>
										<span class="n-chg">{ "~" + itoa(int64(plan.Changes.Update)) }</span>
										<span class="n-del">{ "−" + itoa(int64(plan.Changes.Destroy)) }</span>
									</span>
									<span class="res">{ plan.Changes.Resources }</span>
									if plan.Changes.Drift {
										<span class="drift">· drift</span>
									}
								} else {
									<span class="quiet">—</span>
								}
								if plan.Verdict.Present {
									<span class={ "verdict", plan.Verdict.Class() }>{ plan.Verdict.Label() }</span>
								} else {
									<span class="quiet">—</span>
								}
							</div>
<div class="lifecycle">
							@chip(plan.LifecycleClass(), plan.Lifecycle)
							if plan.ConsumedBy != 0 {
								<a class="mono" href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/jobs/" + itoa(plan.ConsumedBy))) }>#{ itoa(plan.ConsumedBy) }</a>
							}
							if plan.Stale {
								<span class="stale">{ "stale · serial " + itoa64(vm.Row.Serial) }</span>
							}
						</div>
						<div class="actions">
								if plan.Applicable() {
									<a class="verb primary" href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/workspaces/" + vm.Row.Name + "/plans/" + itoa(plan.ID))) } aria-label={ "Apply plan #" + itoa(plan.ID) } title={ "Apply plan #" + itoa(plan.ID) }>
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphApply }></path></svg>
									</a>
								}
								<a class="verb" href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/workspaces/" + vm.Row.Name + "/plans/" + itoa(plan.ID))) } aria-label={ "Diff plan #" + itoa(plan.ID) } title="Diff">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphDiff }></path></svg>
								</a>
							</div>
						</div>
					}
				</div>
				<p class="meta mt8">a Policy verdict rides on the plan: deny · require-approval</p>
			}
		</div>
		<div class="cards mt18">
		<div class="card backend">
			<div class="kicker">Backend config</div>
			<h3>Backend</h3>
			if vm.Row.Backend.Address == "" {
				<p class="meta">No recorded state backend address yet — start `exocomp serve`, or pass --address to `workspace add --state-only`.</p>
			} else {
				<p class="meta">Paste into an external tofu root, then `tofu init`. The bearer is a reference — the value comes from the sealed secret at init time.</p>
				<div class="backend-tools">
					<p class="mono hint">tofu init -backend-config=&lt;(exocomp workspace backend { vm.Row.Name } --config)</p>
					if vm.Operator {
						<button type="button" class="verb" id="be-reveal" data-action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/workspaces/" + vm.Row.Name + "/backend/reveal")) } aria-label="Reveal bearer" title="Reveal bearer">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphReveal }></path><circle cx="12" cy="12" r="2.5"></circle></svg>
						</button>
					}
				</div>
				@codeblock("backend config", vm.Row.Backend.HCL())
				<div class="backend-foot">
					<span class="bearer" id="be-bearer">bearer ••••••••••••••••••••••••••••••••••••••••••••</span>
					<span class="note" id="be-note">reveal logs an event · copy never includes it</span>
				</div>
				<script>
				(function () {
					var btn = document.getElementById("be-reveal");
					if (!btn) return;
					var out = document.getElementById("be-bearer");
					var note = document.getElementById("be-note");
					var timer = null;
					function hide() {
						if (timer) { clearTimeout(timer); timer = null; }
						out.textContent = "bearer ••••••••••••••••••••••••••••••••••••••••••••";
						note.textContent = "reveal logs an event · copy never includes it";
						btn.setAttribute("aria-label", "Reveal bearer");
						btn.setAttribute("title", "Reveal bearer");
					}
					btn.addEventListener("click", function () {
						fetch(btn.getAttribute("data-action"), {
							method: "POST",
							credentials: "same-origin",
							headers: { "Accept": "text/plain" }
						}).then(function (resp) {
							if (!resp.ok) throw new Error(String(resp.status));
							return resp.text();
						}).then(function (token) {
							out.textContent = "bearer " + token;
							note.textContent = "revealed · logged to events · hides in 30s";
							btn.setAttribute("aria-label", "Hide bearer");
							btn.setAttribute("title", "Hide bearer");
							if (timer) clearTimeout(timer);
							timer = setTimeout(hide, 30000);
						}).catch(function () {
							note.textContent = "reveal refused — reload and try again";
						});
					});
				})();
				</script>
			}
		</div>
		<div class="card state-tray" id="tofu-state">
			<div class="kicker">Tofu state</div>
			<h3>State</h3>
			if len(vm.StateTray) == 0 {
				<p class="meta">No state stored yet — this workspace holds no tfstate.</p>
			} else {
				<p class="meta">{ itoa(int64(len(vm.StateTray))) } { plural(len(vm.StateTray), "serial", "serials") } · newest first · <span class="ws-encrypted"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphLock }></path></svg>ENCRYPTED AT REST</span></p>
				<div class="tray-table state">
					<div class="row tt-col state">
						<span>SERIAL</span>
						<span>WRITTEN BY</span>
						<span>WHEN</span>
						<span class="th-actions">DIFF</span>
					</div>
					for _, row := range vm.StateTray {
						<div class="row state">
							<span class="mono">serial { itoa64(row.Serial) }</span>
							<span>
								if row.Adoption {
									<span class="adoption">workspace adopt · migrated from backend</span>
								} else if row.JobID != 0 {
									<a class="mono" href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/jobs/" + itoa64(row.JobID))) }>job #{ itoa64(row.JobID) }</a>
								} else {
									<span class="quiet">outside exocomp</span>
								}
							</span>
							<span class="mono">{ row.When }</span>
							<span class="actions">
								if row.Browseable() {
									<a class="verb" href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/workspaces/" + vm.Row.Name + "/plans/" + itoa64(row.BrowseID))) } aria-label={ "Browse serial " + itoa64(row.Serial) + " diff" } title="Browse diff">
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphDiff }></path></svg>
									</a>
								} else {
									<span class="quiet">no sealed diff</span>
								}
							</span>
						</div>
					}
				</div>
				<p class="meta mt8">read-only · the adoption is the first serial</p>
			}
		</div>
		</div>
	if vm.Operator && !vm.Row.StateOnly() {
			<dialog class="modal plan-confirm" id="ws-destroy-confirm" aria-labelledby="ws-destroy-title" open?={ vm.Destroy }>
				<div class="modal-head">
					<div class="kicker">{ vm.DestroyKicker() }</div>
					<h2 id="ws-destroy-title">Destroy every resource on { vm.Row.Name }</h2>
					<button type="button" class="modal-close" data-modal-dismiss aria-label="Close">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"></path></svg>
					</button>
				</div>
				<div class="modal-body">
					<div class="destroy-block" role="alert">
						<div class="block-head"><span class="keyword">Destroys — no undo</span></div>
						<p class="meta">tofu destroy tears down every resource this workspace manages — the whole state, not one plan's subset. The job runs through the same queue as a plan or an apply, confirmed by this dialog only.</p>
					</div>
					@formStatus(false, vm.DestroyErr)
					<div class="actions">
						<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/workspaces/" + vm.Row.Name + "/destroy")) } class="inline-form">
							<input type="hidden" name="confirmed" value="1"/>
							<button type="submit" class="btn danger">Queue destroy — { vm.Row.Name }</button>
						</form>
						<button type="button" class="btn" data-modal-dismiss>Cancel</button>
					</div>
				</div>
			</dialog>
		}
	}
}
