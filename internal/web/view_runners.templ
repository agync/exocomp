package web

// modeChip states a runner's build mode: cached builds the image once and
// reuses it until the recipe changes (byo-runner.md §2 Model A, the fast
// steady state); onthefly rebuilds every run against the layer cache (Model
// B). Never colour-only — the label always names the mode.
templ modeChip(r runnerRow) {
	if r.OnTheFly() {
		<span class="chip wait"><span class="dot"></span>ONTHEFLY</span>
	} else {
		<span class="chip ok"><span class="dot"></span>CACHED</span>
	}
}

// runnersList is the runners surface: the registered execution-environment
// recipes (byo-runner.md §2) — build mode, base image, package/ansible-core
// pins, the resource caps the deferred container tier would enforce, and the
// content hash that gates the build cache. A runner definition holds no
// secret material, so an operator gets add/rm controls here
// (runners_write.go); the bootstrap script body is deliberately absent from
// every row (`exocomp runner show` is the surface that prints it), and
// `exocomp runner import` stays CLI-only. A runner is registered for the
// deferred container tier and executes nothing today.
templ runnersList(vm runnersVM) {
	@layout(vm.Page) {
		if vm.Operator {
			@modal("runners-add", "Add a runner") {
				<p class="meta">Mirrors <code>exocomp runner add</code>: a base image plus either a bootstrap script or a Containerfile path — not both. Container tier deferred: this registers a definition, nothing builds or runs it.</p>
				<form method="post" action={ urlWithBase(vm.Page.Base, "/runners/add") } class="writeform" id="runner-add-form" novalidate data-runner-form>
					@fieldInput(vm.Form.nameField())
					<label class="field">
						<span class="label">Mode</span>
						<select class="control" id="rn-mode" name="mode" aria-invalid?={ vm.Form.effective().ErrMode != "" } aria-describedby="rn-mode-meta" autofocus?={ vm.Form.effective().FirstInvalid == "mode" }>
							<option value="cached" selected?={ vm.Form.modeIs("cached") }>cached</option>
							<option value="onthefly" selected?={ vm.Form.modeIs("onthefly") }>onthefly</option>
						</select>
						<span id="rn-mode-meta" class={ "meta", templ.KV("is-error", vm.Form.effective().ErrMode != "") }>
							if vm.Form.effective().ErrMode != "" {
								<span class="msg">{ vm.Form.effective().ErrMode }</span>
							} else {
								Mode is cached or onthefly.
							}
						</span>
					</label>
					@fieldInput(vm.Form.baseField())
					<label class="field">
						<span class="label">Bootstrap script (Model A; excludes Containerfile)</span>
						<textarea class="control" id="rn-bootstrap" name="bootstrap" rows="6" spellcheck="false" placeholder="#!/bin/sh&#10;dnf install -y sshpass rsync" aria-describedby="rn-bootstrap-meta">{ vm.Form.effective().Bootstrap }</textarea>
						<span id="rn-bootstrap-meta" class={ "meta", templ.KV("is-error", vm.Form.effective().ErrBootstrap != "") }>
							if vm.Form.effective().ErrBootstrap != "" {
								<span class="msg">{ vm.Form.effective().ErrBootstrap }</span>
							} else {
								The script that builds the image (Model A).
							}
						</span>
					</label>
					@fieldInput(vm.Form.containerfileField())
					@fieldInput(vm.Form.packagesField())
					@fieldInput(vm.Form.ansibleField())
					@fieldInput(vm.Form.memoryField())
					@fieldInput(vm.Form.cpuField())
					@formStatus(vm.Form.Pending(), vm.Form.ErrFormText(), "Adding runner")
					<div class="actions"><button type="submit" class="btn primary" disabled?={ vm.Form.Pending() }>Add runner</button></div>
				</form>
				if vm.Form != nil {
					// A JS-off refusal re-renders the whole page; open the dialog and
					// focus the first invalid control after it is in the DOM.
					<script>
					exoModalOpen("runners-add");
					var rnBad = document.querySelector('#runners-add [aria-invalid="true"]');
					if (rnBad) rnBad.focus();
					</script>
				}
				@runnerFormJS()
			}
		}
		if vm.Notice != "" {
			<p class="error" role="alert">▲ { vm.Notice }</p>
		}
		<div class="card span2 mt18 tray">
			<div class="kicker">Container tier deferred</div>
			<h3>All runners</h3>
			if !vm.Operator {
				<p class="meta">Read-only: managing runners needs an operator token.</p>
			}
			<p class="meta">Full detail (bootstrap script body, import) stays on <code>exocomp runner show|import</code>. Container tier deferred — definitions only.</p>
			if len(vm.Runners) == 0 {
				<p class="meta">No runners registered — they are runner definitions only; add one with <code>exocomp runner add</code>.</p>
			} else {
				<div class="tablewrap stackable">
					<table>
						<thead>
							<tr>
								<th scope="col">Name</th>
								<th scope="col">Mode</th>
								<th scope="col">Base</th>
								<th scope="col">Packages</th>
								<th scope="col">ansible-core</th>
								<th scope="col">Caps</th>
								<th scope="col">Hash</th>
								<th scope="col">Created</th>
								if vm.Operator {
									<th scope="col">Actions</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, rn := range vm.Runners {
								<tr>
									<td data-label="Name">{ rn.Name }</td>
									<td data-label="Mode">@modeChip(rn)
</td>
									<td class="mono wrap" data-label="Base">{ orDash(rn.Base) }</td>
									<td data-label="Packages">{ rn.PackagesSummary() }</td>
									<td class="mono" data-label="ansible-core">{ orDash(rn.AnsibleCore) }</td>
									<td data-label="Caps">{ rn.Caps() }</td>
									<td class="mono" data-label="Hash">{ rn.Short() }</td>
									<td class="mono" data-label="Created">{ rn.Created }</td>
									if vm.Operator {
										<td data-label="Actions">
											<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/runners/" + rn.Name + "/rm")) } class="inline-form" data-confirm={ "Remove runner " + rn.Name + "?" }>
												<button type="submit" class="btn danger">Remove</button>
											</form>
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// runnerFormJS is the add-runner form's progressive enhancement, mirroring the
// netgroup/source/check/schedule/policy forms: novalidate (the daemon is
// authoritative), submit intercepted and POSTed with fetch — a 422 swaps the
// form fragment in place with the server-rendered refusals (JS-off gets the
// same bytes as a full re-render), anything else follows the redirect and its
// success flash. The name re-validates on blur and clears when right; the
// primary disables only while submitting.
templ runnerFormJS() {
	<script>
	(function () {
		function runnerFormWire() {
			var form = document.getElementById("runner-add-form");
			if (!form || form.dataset.runnerWired) return;
			form.dataset.runnerWired = "1";

			function restoreMeta(input) {
				input.removeAttribute("aria-invalid");
				var meta = document.getElementById(input.getAttribute("aria-describedby"));
				if (!meta) return;
				meta.classList.remove("is-error");
				switch (input.name) {
				case "name":
					meta.textContent = "A lowercase letter or digit, then letters, digits, dots, hyphens, underscores.";
					break;
				case "base":
					meta.textContent = "A base image reference, like registry.fedoraproject.org/fedora-minimal:44.";
					break;
				}
			}

			// showError paints a refusal on a field without changing its geometry
			// (the meta line always exists), mirroring the server's human copy.
			function showError(input, msg) {
				input.setAttribute("aria-invalid", "true");
				var meta = document.getElementById(input.getAttribute("aria-describedby"));
				if (meta) {
					meta.classList.add("is-error");
					meta.textContent = "▲ " + msg;
				}
			}

			// validateField runs the same client rules the server holds to — a
			// name shape refusal — on blur so a mistake surfaces before submit.
			// Empty is left alone (that's a submit-time required check); the
			// daemon stays authoritative on the model matrix, so submit still
			// asks the server.
			function validateField(input) {
				if (input.value.trim() === "") return;
				var v = input.value.trim();
				if (input.name === "name" && !/^[a-z0-9][a-z0-9._-]*$/.test(v)) {
					showError(input, "Names start with a lowercase letter or digit and hold letters, digits, dots, hyphens and underscores.");
					return;
				}
				restoreMeta(input);
			}

			form.addEventListener("submit", function (e) {
				e.preventDefault();
				var primary = form.querySelector('button[type="submit"]');
				var status = form.querySelector(".form-status");
				primary.disabled = true;
				status.innerHTML = '<span class="dot"></span>Adding runner';
				fetch(form.getAttribute("action"), {
					method: "POST",
					body: new FormData(form),
					credentials: "same-origin",
					headers: { "Accept": "text/html" }
				}).then(function (resp) {
					if (resp.status === 422) {
						return resp.text().then(function (html) {
							var doc = new DOMParser().parseFromString(html, "text/html");
							var next = doc.getElementById("runner-add-form");
							if (!next) return;
							form.outerHTML = next.outerHTML;
							form = document.getElementById("runner-add-form");
							form.dataset.runnerRefused = "1";
							runnerFormWire();
							var bad = form.querySelector('[aria-invalid="true"]');
							if (bad) bad.focus();
						});
					}
					var loc = resp.headers.get("Location");
					if (loc) { window.location = loc; return; }
					window.location.reload();
				}).catch(function () {
					primary.disabled = false;
					status.textContent = "";
				});
			});

			// Validate on blur always (not just after a refusal) so a mistake
			// surfaces as soon as the operator leaves the field.
			form.addEventListener("blur", function (e) {
				var input = e.target.closest('input[name="name"], input[name="base"]');
				if (!input) return;
				validateField(input);
			}, true);
		}
		runnerFormWire();
	})();
	</script>
}
