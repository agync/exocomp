package web

// checksList is the checks surface: named probe sets whose per-target answers
// flip into reactive events on a transition (docs/architecture/reactive.md
// "Checks"). Each row lists its targets with the status the sweep last
// observed, the netgroup the probed address belongs to (home/away — none for
// an http target), and how long ago that status changed. The location claim
// is the target tile's second line — a fixed netgroup slot (SPEC §5.1): route
// glyph + "on {netgroup}" (a link → Netgroups) · age, so it reads down the
// column; an UNOBSERVED target explains itself in the same slot ("on
// {netgroup} · away — not probed from here"). A check carries no secret
// material, so — like schedules — the write controls here are plain
// operator-scope: no reauth, no confirm_token.
templ checksList(vm checksVM) {
	@layout(vm.Page) {
		<p class="meta">
			A check watches reachability; nothing fires until a rule matches — rules
			are written on the CLI and read at <a href={ urlWithBase(vm.Page.Base, "/rules") }>/rules</a>.
		</p>
		@checksSurface(vm)
		@checksTabJS()
	}
}

// checksSurface is the /checks surface region the tab strip's client-side swap
// moves (m79): the tab strip and the active panel, rendered without the layout
// chrome. The full page embeds it (checksList) and the fragment handler renders
// it alone for the tab-swap fetch, so the two renders cannot drift. Region id
// "checks-surface" is the swap contract: the strip links carry data-tab, and
// the fragment's aria-selected is server-set so the active tab rides the swap.
// The one-shot scripts the region carries (the add-form wire functions, the
// select enhancer) are re-wired by the swap JS per the form-fragment precedent.
templ checksSurface(vm checksVM) {
	<div id="checks-surface">
		<div class="tabs segmented" role="tablist" aria-label="Checks">
			<a class="tab" data-tab="probes" href={ urlWithBase(vm.Page.Base, "/checks") } role="tab" aria-selected={ boolAttr(vm.Tab != "netgroups") }>Probes</a>
			<a class="tab" data-tab="netgroups" href={ urlWithBase(vm.Page.Base, "/checks?tab=netgroups") } role="tab" aria-selected={ boolAttr(vm.Tab == "netgroups") }>Netgroups</a>
		</div>
		if vm.Tab == "netgroups" {
			@netgroupsPanel(vm.Netgroups, vm.Operator, vm.NetgroupForm, vm.Page.Base)
		} else {
			if vm.Operator {
				@modal("checks-add", "Add a check") {
					<p class="meta">Mirrors <code>exocomp check add</code>: targets are <code>name=ip:port</code> (tcp), <code>name=ip</code> (ping), or <code>name=url</code> (http, optional expected status). Kind ping needs a host that can actually send ICMP.</p>
					<form method="post" action={ urlWithBase(vm.Page.Base, "/checks/add") } class="writeform" id="check-add-form" novalidate data-check-form>
						@fieldInput(vm.Form.nameField())
						<label class="field">
							<span class="label">Kind</span>
							<select class="control" id="ck-kind" name="kind" aria-invalid?={ vm.Form.effective().ErrKind != "" } aria-describedby="ck-kind-meta" autofocus?={ vm.Form.effective().FirstInvalid == "kind" }>
								<option value="tcp" selected?={ vm.Form.kindSelected("tcp") }>tcp</option>
								<option value="ping" selected?={ vm.Form.kindSelected("ping") }>ping</option>
								<option value="http" selected?={ vm.Form.kindSelected("http") }>http</option>
							</select>
							<span id="ck-kind-meta" class={ "meta", templ.KV("is-error", vm.Form.effective().ErrKind != "") }>
								if vm.Form.effective().ErrKind != "" {
									<span class="msg">{ vm.Form.effective().ErrKind }</span>
								} else {
									Kind is tcp, ping or http.
								}
							</span>
						</label>
						@fieldInput(vm.Form.intervalField())
						<label class="field">
							<span class="label">Targets</span>
							for i, t := range vm.Form.targetInputs() {
								<input class="control" name="target" type="text" spellcheck="false" autocomplete="off" placeholder={ targetPlaceholder(i) } value={ t } aria-invalid?={ vm.Form.effective().ErrTarget != "" } aria-describedby="ck-target-meta"/>
							}
							<span id="ck-target-meta" class={ "meta", templ.KV("is-error", vm.Form.effective().ErrTarget != "") }>
								if vm.Form.effective().ErrTarget != "" {
									<span class="msg">
										if vm.Form.effective().ErrTargetItem != "" {
											<span class="item">{ vm.Form.effective().ErrTargetItem }</span>
										}
										{ vm.Form.effective().ErrTarget }
									</span>
								} else {
									Targets are name=spec — like laptop=192.168.1.50:22, name=ip (ping) or name=url (http).
								}
							</span>
						</label>
						<button type="button" class="btn" id="ck-add-target">Add target</button>
						@fieldInput(vm.Form.expectField())
						@formStatus(vm.Form.Pending(), vm.Form.ErrFormText(), "Adding check")
						<div class="actions"><button type="submit" class="btn primary" disabled?={ vm.Form.Pending() }>Add check</button></div>
					</form>
					if vm.Form != nil {
						// A JS-off refusal re-renders the whole page; open the dialog and
						// focus the first invalid control after it is in the DOM.
						<script>
						exoModalOpen("checks-add");
						var ckBad = document.querySelector('#checks-add [aria-invalid="true"]');
						if (ckBad) ckBad.focus();
						</script>
					}
					@checkFormJS()
				}
			}
			if !vm.Operator {
				<p class="meta">Read-only: managing checks needs an operator token.</p>
			}
			if len(vm.Checks) == 0 {
				<div class="card span2 mt18"><p class="meta">No checks registered — add one.</p></div>
			} else {
				<ul class="checkcards">
					for _, ck := range vm.Checks {
						<li class={ "checkcard", templ.KV("disabled", !ck.Enabled) }>
							<header>
								<a class="mono" href={ urlWithBase(vm.Page.Base, "/events?source=check") }>{ ck.Name }</a>
								<span class="meta mono">{ ck.Kind } · every { ck.Interval }</span>
								@enabledChip(ck.Enabled, false)
								if summary := ck.DownSummary(); summary != "" {
									<span class="meta mono fail-text">{ summary }</span>
								}
							</header>
							<ul class="targetgrid">
								for _, t := range ck.Targets {
									<li class={ "target", templ.KV("down", t.IsDown()) }>
										<div class="thead">
											<span class="mono">{ t.Name }</span>
											<span class="meta mono">{ t.Spec() }{ t.ExpectNote() }</span>
										</div>
										<div class="tstate">
											if t.IsUp() || t.IsDown() {
												@chip(t.StatusClass(), t.StatusLabel())
												if t.URL == "" {
													<div class="where">
														<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphRoute }></path></svg>
														if t.Netgroup == "" || t.Netgroup == "away" {
															<span class="mono">on away</span>
														} else {
															<a class="mono" href={ urlWithBase(vm.Page.Base, "/netgroups") }>on { t.Netgroup }</a>
														}
														if t.Changed != "" {
															<span class="meta mono">· { t.Changed } ago</span>
														}
													</div>
												}
											} else {
												<span class="chip dim"><span class="dot"></span>UNOBSERVED</span>
												if t.URL == "" {
													<div class="where">
														<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphRoute }></path></svg>
														<span class="away">{ "on " + t.WhereLocation() + " · away — not probed from here" }</span>
													</div>
												} else {
													<span class="meta">never seen yet — first result decides</span>
												}
											}
										</div>
									</li>
								}
							</ul>
							if vm.Operator {
								<div class="checkactions">
									@rowActions(checkRowActions(ck), vm.Page.Base)
								</div>
							}
						</li>
					}
				</ul>
			}
		}
	</div>
}

// checksTabJS is the checks tab strip's progressive enhancement (m79): the
// data-tab links stay full-load anchors without JS, and with JS a click
// fetches the same ?tab= URL with an X-Requested-With: fragment header and
// swaps the #checks-surface region in place. The active tab's aria-selected
// rides the server-rendered region, so the swap moves the tab state with it.
// The fetch is a GET, so a swap never carries a refusal or a write, and the
// fragment is a partial render with no flash element, so a swap cannot re-fire
// a consumed flash. The click path is delegated on document, so it survives
// region swaps; the region's own one-shot scripts are re-wired per the
// form-fragment precedent (the wire functions are dataset-guarded and the
// select enhancer walks a root, so re-running both is idempotent). The
// pushState keeps the address in sync with the visible tab, so refresh and
// share behave exactly as the JS-off full load would.
templ checksTabJS() {
	<script>
	(function () {
		function swapTab(href) {
			return fetch(href, {
				credentials: "same-origin",
				headers: { "Accept": "text/html", "X-Requested-With": "fragment" }
			}).then(function (resp) {
				if (!resp.ok) return false;
				return resp.text().then(function (html) {
					var doc = new DOMParser().parseFromString(html, "text/html");
					var next = doc.getElementById("checks-surface");
					var region = document.getElementById("checks-surface");
					if (!next || !region) return false;
					region.outerHTML = next.outerHTML;
					region = document.getElementById("checks-surface");
					if (window.exoWireCheckForm) window.exoWireCheckForm();
					if (window.exoWireNetgroupForm) window.exoWireNetgroupForm();
					if (window.exoEnhanceSelects) window.exoEnhanceSelects(region);
					return true;
				});
			});
		}
		var busy = false;
		document.addEventListener("click", function (e) {
			var tab = e.target.closest("a[data-tab]");
			if (!tab || busy) return;
			if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			if (tab.getAttribute("aria-selected") === "true") return;
			e.preventDefault();
			busy = true;
			var href = tab.getAttribute("href");
			swapTab(href).then(function (ok) {
				if (ok) { history.pushState(null, "", href); busy = false; }
				else { busy = false; window.location = href; }
			}).catch(function () {
				busy = false;
				window.location = href;
			});
		});
		window.addEventListener("popstate", function () {
			var href = location.pathname + location.search;
			swapTab(href).then(function (ok) {
				if (!ok) location.reload();
			}).catch(function () { location.reload(); });
		});
	})();
	</script>
}

// checkFormJS is the check-add form's progressive enhancement, mirroring the
// netgroup/source forms: novalidate (the daemon is authoritative), submit
// intercepted and POSTed with fetch — a 422 swaps the form fragment in place
// with the server-rendered refusals (JS-off gets the same bytes as a full
// re-render), anything else follows the redirect and its success flash. After
// a refusal a field re-validates on blur and clears when right; the primary
// disables only while submitting. The Add target control lives here too so a
// 422-swapped fragment re-wires it. The wire function is exposed as
// exoWireCheckForm so the checks tab strip's swap (checksTabJS) can re-wire a
// freshly swapped-in form the same way a 422 swap does.
templ checkFormJS() {
	<script>
	(function () {
		function checkFormWire() {
			var form = document.getElementById("check-add-form");
			if (!form || form.dataset.checkWired) return;
			form.dataset.checkWired = "1";

			function restoreMeta(input) {
				input.removeAttribute("aria-invalid");
				var meta = document.getElementById(input.getAttribute("aria-describedby"));
				if (!meta) return;
				meta.classList.remove("is-error");
				switch (input.name) {
				case "name":
					meta.textContent = "Letters, digits, dots, hyphens, underscores.";
					break;
				case "interval":
					meta.textContent = "A Go duration — 5m, 90s, 1h.";
					break;
				case "expect":
					meta.textContent = "A whole status code, like 200 or 404.";
					break;
				case "target":
					meta.textContent = "Targets are name=spec — like laptop=192.168.1.50:22, name=ip (ping) or name=url (http).";
					break;
				}
			}

			// showError paints a refusal on a field without changing its geometry
			// (the meta line always exists), mirroring the server's human copy.
			function showError(input, msg) {
				input.setAttribute("aria-invalid", "true");
				var meta = document.getElementById(input.getAttribute("aria-describedby"));
				if (meta) {
					meta.classList.add("is-error");
					meta.textContent = "▲ " + msg;
				}
			}

			// validateField runs the same client rules the server holds to — a
			// name shape or interval-unit refusal — on blur so a mistake
			// surfaces before submit. Empty is left alone (that's a
			// submit-time required check); the daemon stays authoritative on
			// uniqueness, target shape, and the ping capability, so submit
			// still asks the server.
			function validateField(input) {
				if (input.value.trim() === "") return;
				var v = input.value.trim();
				if (input.name === "name") {
					if (!/^[A-Za-z0-9_.-]+$/.test(v)) {
						showError(input, "Names can't have spaces or special characters.");
						return;
					}
				} else if (input.name === "interval") {
					if (!/^[0-9.]/.test(v)) {
						showError(input, "The interval needs a unit — like 5m, 90s or 1h.");
						return;
					}
				} else if (input.name === "expect") {
					if (!/^\d+$/.test(v)) {
						showError(input, "The expected status is a whole number, like 200.");
						return;
					}
				} else if (input.name === "target") {
					if (!/=/.test(v) || v.indexOf("=") === 0) {
						showError(input, "Targets are name=spec — like laptop=192.168.1.50:22.");
						return;
					}
				}
				restoreMeta(input);
			}

			// The four baseline target rows stay the JS-off baseline; Add target
			// grows the form past them, capped so the DOM cannot grow unbounded.
			var addBtn = document.getElementById("ck-add-target");
			if (addBtn) {
				addBtn.addEventListener("click", function () {
					var inputs = form.querySelectorAll('input[name="target"]');
					if (inputs.length >= 10) return;
					var last = inputs[inputs.length - 1];
					var clone = last.cloneNode(false);
					clone.value = "";
					last.after(clone);
					clone.focus();
				});
			}

			form.addEventListener("submit", function (e) {
				e.preventDefault();
				var primary = form.querySelector('button[type="submit"]');
				var status = form.querySelector(".form-status");
				primary.disabled = true;
				status.innerHTML = '<span class="dot"></span>Adding check';
				fetch(form.getAttribute("action"), {
					method: "POST",
					body: new FormData(form),
					credentials: "same-origin",
					headers: { "Accept": "text/html" }
				}).then(function (resp) {
					if (resp.status === 422) {
						return resp.text().then(function (html) {
							var doc = new DOMParser().parseFromString(html, "text/html");
							var next = doc.getElementById("check-add-form");
							if (!next) return;
							form.outerHTML = next.outerHTML;
							form = document.getElementById("check-add-form");
							form.dataset.checkRefused = "1";
							checkFormWire();
							var bad = form.querySelector('[aria-invalid="true"]');
							if (bad) bad.focus();
						});
					}
					var loc = resp.headers.get("Location");
					if (loc) { window.location = loc; return; }
					window.location.reload();
				}).catch(function () {
					primary.disabled = false;
					status.textContent = "";
				});
			});

			// Validate on blur always (not just after a refusal) so a mistake
			// surfaces as soon as the operator leaves the field.
			form.addEventListener("blur", function (e) {
				var input = e.target.closest('input[name="name"], input[name="interval"], input[name="expect"], input[name="target"]');
				if (!input) return;
				validateField(input);
			}, true);
		}
		window.exoWireCheckForm = checkFormWire;
		checkFormWire();
	})();
	</script>
}
