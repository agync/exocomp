package web

// checksList is the checks surface: named probe sets whose per-target answers
// flip into reactive events on a transition (docs/architecture/reactive.md
// "Checks"). Each row lists its targets with the status the sweep last
// observed, the netgroup the probed address belongs to (home/away — none for
// an http target), and how long ago that status changed. A check carries no
// secret material, so — like schedules — the write controls here are plain
// operator-scope: no reauth, no confirm_token.
templ checksList(vm checksVM) {
	@layout(vm.Page) {
		if vm.Operator && vm.Tab == "probes" {
			@modal("checks-add", "Add a check") {
				<p class="meta">Mirrors <code>exocomp check add</code>: targets are <code>name=ip:port</code> (tcp), <code>name=ip</code> (ping), or <code>name=url</code> (http, optional expected status). Kind ping needs a host that can actually send ICMP.</p>
				<form method="post" action="/checks/add" class="writeform">
					<label for="ck-name">Name</label>
					<input id="ck-name" name="name" type="text" required autocomplete="off" pattern="[A-Za-z0-9._-]+"/>
					<label for="ck-kind">Kind</label>
					<select id="ck-kind" name="kind">
						<option value="tcp" selected>tcp</option>
						<option value="ping">ping</option>
						<option value="http">http</option>
					</select>
					<label for="ck-interval">Interval (Go duration, e.g. 5m)</label>
					<input id="ck-interval" name="interval" type="text" required autocomplete="off" placeholder="5m"/>
					<label for="ck-target">Targets (<code>name=ip:port</code>, <code>name=ip</code>, or <code>name=url</code>; repeat as needed)</label>
					<input id="ck-target" name="target" type="text" autocomplete="off" placeholder="laptop=192.168.1.50:22"/>
					<input name="target" type="text" autocomplete="off" placeholder="nas=192.168.1.60:22"/>
					<input name="target" type="text" autocomplete="off" placeholder="web=https://web.lan/health"/>
					<input name="target" type="text" autocomplete="off"/>
					<button type="button" class="btn" id="ck-add-target">Add target</button>
					<label for="ck-expect">HTTP expected status (optional, http kind only)</label>
					<input id="ck-expect" name="expect" type="number" min="100" max="599" autocomplete="off" placeholder="200"/>
					<div class="actions"><button type="submit" class="btn primary">Add check</button></div>
					<script>
					(function () {
						var btn = document.getElementById("ck-add-target");
						var form = btn && btn.closest("form");
						if (!btn || !form) return;
						// The four baseline inputs stay the JS-off baseline; this grows the
						// form past them, capped so the DOM cannot grow unbounded.
						btn.addEventListener("click", function () {
							var inputs = form.querySelectorAll('input[name="target"]');
							if (inputs.length >= 10) return;
							var last = inputs[inputs.length - 1];
							var clone = last.cloneNode(false);
							clone.value = "";
							last.after(clone);
							clone.focus();
						});
					})();
					</script>
				</form>
			}
		}
		<p class="meta">
			A check watches reachability; nothing fires until a rule matches — rules
			are written on the CLI and read at <a href="/rules">/rules</a>.
		</p>
		<div class="tabs segmented" role="tablist" aria-label="Checks">
			<a class="tab" href="/checks" role="tab" aria-selected={ boolAttr(vm.Tab != "netgroups") }>Probes</a>
			<a class="tab" href="/checks?tab=netgroups" role="tab" aria-selected={ boolAttr(vm.Tab == "netgroups") }>Netgroups</a>
		</div>
		if vm.Tab == "netgroups" {
			@netgroupsPanel(vm.Netgroups, vm.Operator)
		} else {
			if !vm.Operator {
				<p class="meta">Read-only: managing checks needs an operator token.</p>
			}
			if len(vm.Checks) == 0 {
				<div class="card span2 mt18"><p class="meta">No checks registered — add one.</p></div>
			} else {
				<ul class="checkcards">
					for _, ck := range vm.Checks {
						<li class={ "checkcard", templ.KV("disabled", !ck.Enabled) }>
							<header>
								<a class="mono" href="/events?source=check">{ ck.Name }</a>
								<span class="meta mono">{ ck.Kind } · every { ck.Interval }</span>
								@enabledChip(ck.Enabled, false)
								if summary := ck.DownSummary(); summary != "" {
									<span class="meta mono fail-text">{ summary }</span>
								}
								if vm.Operator {
									<span class="spacer"></span>
									if ck.Enabled {
										<form method="post" action={ templ.SafeURL("/checks/" + ck.Name + "/disable") } class="inline-form">
											<button type="submit" class="btn quiet">Disable</button>
										</form>
									} else {
										<form method="post" action={ templ.SafeURL("/checks/" + ck.Name + "/enable") } class="inline-form">
											<button type="submit" class="btn quiet">Enable</button>
										</form>
									}
									<form method="post" action={ templ.SafeURL("/checks/" + ck.Name + "/rm") } class="inline-form" data-confirm={ "Remove check " + ck.Name + "?" }>
										<input type="hidden" name="confirmed" value="1"/>
										<button type="submit" class="btn danger">Remove…</button>
									</form>
								}
							</header>
							<ul class="targetgrid">
								for _, t := range ck.Targets {
									<li class={ "target", templ.KV("down", t.IsDown()) }>
										<div class="thead">
											<span class="mono">{ t.Name }</span>
											<span class="meta mono">{ t.Spec() }{ t.ExpectNote() }</span>
											if t.Changed != "" {
												<span class="meta mono tend">{ t.Changed } ago</span>
											}
										</div>
										<div class="tstate">
											if t.IsUp() || t.IsDown() {
												@chip(t.StatusClass(), t.StatusLabel())
												if t.URL == "" {
													if t.Netgroup == "" || t.Netgroup == "away" {
														<span class="meta">address not on any netgroup (away)</span>
													} else {
														<span class="meta">address is on <b>{ t.Netgroup }</b></span>
													}
												}
											} else {
												<span class="chip dim"><span class="dot"></span>UNOBSERVED</span>
												<span class="meta">never seen yet — first result decides</span>
											}
										</div>
									</li>
								}
							</ul>
						</li>
					}
				</ul>
			}
		}
	}
}