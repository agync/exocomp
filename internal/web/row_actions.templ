package web

// rowActions renders a resource row's actions cell. The first two non-menu
// actions are the verb glyphs; any remaining actions go in the chevron menu.
// A glyph that POSTs is a form submit (the glyph button submits its form); a
// glyph that opens a modal is a data-modal-open trigger. JS-off: the chevron
// is a <details> whose summary toggles the item list inline (POST and link
// items work; modal items are inert without JS, same as data-modal-open
// today); a selectInit-style upgrade turns it into the floating menu with
// Esc/arrows/Enter and above-flip. base re-prefixes the root-absolute Form
// actions; a.Href arrives already prefixed from the Go constructors.
templ rowActions(acts []rowAction, base string) {
	<div class="rowacts">
		for _, a := range rowGlyphs(acts) {
			if a.Label != "" {
				if a.Form != "" {
					<form method="post" action={ templ.SafeURL(urlWithBase(base, a.Form)) } class="inline-form">
						for k, v := range a.Hidden {
							<input type="hidden" name={ k } value={ v }/>
						}
						<button type="submit" class="raglyph-label" aria-label={ a.Name } title={ a.Name }>{ a.Label }</button>
					</form>
				} else {
					<a class="raglyph-label" href={ templ.SafeURL(a.Href) } aria-label={ a.Name } title={ a.Name }>{ a.Label }</a>
				}
			} else if a.Form != "" && a.Confirm != "" {
				<form method="post" action={ templ.SafeURL(urlWithBase(base, a.Form)) } class="inline-form" data-confirm={ a.Confirm }>
					for k, v := range a.Hidden {
						<input type="hidden" name={ k } value={ v }/>
					}
					<button type="submit" class="raglyph" aria-label={ a.Name } title={ a.Name }>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ a.Path }></path></svg>
					</button>
				</form>
			} else if a.Form != "" {
				<form method="post" action={ templ.SafeURL(urlWithBase(base, a.Form)) } class="inline-form">
					for k, v := range a.Hidden {
						<input type="hidden" name={ k } value={ v }/>
					}
					<button type="submit" class="raglyph" aria-label={ a.Name } title={ a.Name }>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ a.Path }></path></svg>
					</button>
				</form>
			} else {
				<button type="button" class="raglyph" aria-label={ a.Name } title={ a.Name } data-modal-open={ a.Modal }>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ a.Path }></path></svg>
				</button>
			}
		}
		if rowMenuCount(acts) > 0 {
			<details class="ramenu">
				<summary class="rachev" aria-label="More actions" title="More actions">
					<span class="rachev-word">More</span>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphChevron }></path></svg>
				</summary>
				<ul class="ramenu-panel" role="menu">
					for i, a := range rowMenu(acts) {
						// A destructive item's rule: the danger item gets a real
						// role=separator divider before it, never a stray dash
						// item; a lone danger menu draws no leading divider.
						if a.Danger && i > 0 {
							<li class="ramenu-sep" role="separator"></li>
						}
						<li class={ "ramenu-item", templ.KV("danger", a.Danger) } role="menuitem">
							if a.Form != "" && a.Confirm != "" {
								<form method="post" action={ templ.SafeURL(urlWithBase(base, a.Form)) } class="inline-form" data-confirm={ a.Confirm }>
									for k, v := range a.Hidden {
										<input type="hidden" name={ k } value={ v }/>
									}
									<button type="submit" class="ramenu-btn">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ a.Path }></path></svg>
										{ a.Name }
										if a.Count != "" {
											<span class="ramenu-count">{ a.Count }</span>
										}
									</button>
								</form>
							} else if a.Form != "" {
								<form method="post" action={ templ.SafeURL(urlWithBase(base, a.Form)) } class="inline-form">
									for k, v := range a.Hidden {
										<input type="hidden" name={ k } value={ v }/>
									}
									<button type="submit" class="ramenu-btn">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ a.Path }></path></svg>
										{ a.Name }
										if a.Count != "" {
											<span class="ramenu-count">{ a.Count }</span>
										}
									</button>
								</form>
							} else if a.Modal != "" {
								<button type="button" class="ramenu-btn" data-modal-open={ a.Modal }>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ a.Path }></path></svg>
									{ a.Name }
									if a.Count != "" {
										<span class="ramenu-count">{ a.Count }</span>
									}
								</button>
							} else {
								<a class="ramenu-btn" href={ templ.SafeURL(a.Href) }>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ a.Path }></path></svg>
									{ a.Name }
									if a.Count != "" {
										<span class="ramenu-count">{ a.Count }</span>
									}
								</a>
							}
						</li>
					}
				</ul>
			</details>
		}
	</div>
	if r := rowActsRefusal(acts); r != "" {
		// A refused row verb re-renders the whole surface with the refusal on
		// the row (forms/SPEC.md): a ▲ status line where the operator acted,
		// never a flash. No Retry link — the verb button is right there.
		<div class="form-status is-error" role="alert"><span class="msg">{ r }</span></div>
	}
}

// rowActsRefusal returns the row's refusal sentence — the first action's
// non-empty Refusal, empty at rest. rowActions renders it as the row's ▲
// status line; a row can only carry the one refusal of its last refused verb.
func rowActsRefusal(acts []rowAction) string {
	for _, a := range acts {
		if a.Refusal != "" {
			return a.Refusal
		}
	}
	return ""
}

// rowGlyphs returns the row's verb-glyph actions: the first two non-menu
// actions. Fewer than three actions → glyphs only.
func rowGlyphs(acts []rowAction) []rowAction {
	var out []rowAction
	for _, a := range acts {
		if a.Menu {
			continue
		}
		out = append(out, a)
		if len(out) == 2 {
			break
		}
	}
	return out
}

// rowMenu returns the actions that go in the chevron menu: everything past the
// first two glyphs, plus every Menu-flagged action, in order, destructive
// items last.
func rowMenu(acts []rowAction) []rowAction {
	var out, danger []rowAction
	glyphSlots := 2
	for _, a := range acts {
		if a.Menu || glyphSlots == 0 {
			if a.Danger {
				danger = append(danger, a)
			} else {
				out = append(out, a)
			}
			continue
		}
		glyphSlots--
	}
	return append(out, danger...)
}

// rowMenuCount reports whether the chevron menu should render at all.
func rowMenuCount(acts []rowAction) int {
	return len(rowMenu(acts))
}
