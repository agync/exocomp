package web

// jobsList is the one list every execution path shares: manual runs, scheduled
// runs, backups, applies. One list, one detail view (the brief's "everything is
// a job"). The rows are the two-line grid (2a): a PLAYBOOK / TRIGGER / STATE /
// RAN cell pair each, the STATE cell carrying the one-fact reason line on
// FAILED and DEGRADED.
templ jobsList(vm dashboardVM) {
	@layout(vm.Page) {
		<div class="card span2 mt18 jobslist">
			<div class="kicker">Run ledger</div>
			<h3>All jobs</h3>
			<div class="listmeta">
				<span class="mono">{ itoa(int64(len(vm.Queue))) } · newest first</span>
				<input id="jobs-filter" type="search" autocomplete="off" placeholder="filter" aria-label="Filter jobs"/>
			</div>
			if len(vm.Queue) == 0 {
				<p class="meta">No jobs yet. They appear when a schedule, rule or manual run fires.</p>
			} else {
				<div class="jobshead" aria-hidden="true">
					<span>#</span><span>Playbook</span><span>Trigger</span><span>State</span><span>Ran</span>
				</div>
				for _, j := range vm.Queue {
					@jobsRow(j)
				}
			}
		</div>
		<script>
		(function () {
			var input = document.getElementById("jobs-filter");
			if (!input) return;
			window.exoFilterJobs = function () {
				var q = input.value.trim().toLowerCase();
				var rows = document.querySelectorAll(".jobs-row");
				for (var i = 0; i < rows.length; i++) {
					rows[i].style.display = (q === "" || rows[i].textContent.toLowerCase().indexOf(q) !== -1) ? "" : "none";
				}
			};
			input.addEventListener("input", window.exoFilterJobs);
		})();
		</script>
	}
}

// jobsRow is one two-line row of the jobs list: the whole row is the link to
// the job's detail page, and each cell is a primary line over a meta line on
// shared baselines.
templ jobsRow(j jobRow) {
	<a class="jobs-row" href={ templ.SafeURL("/jobs/" + itoa64(j.ID)) }>
		<span class="num">{ itoa64(j.ID) }</span>
		<span class="cell">
			<b class="mono">{ j.Title }</b>
			<small class="mono">{ j.SourceMeta }</small>
		</span>
		<span class="cell">
			<b>{ j.TriggerLabel }</b>
			<small class="mono">{ j.TriggerMeta }</small>
		</span>
		<span class="cell cell--state">
			@chip(j.StateClass(), string(j.State))
			if j.Reason != "" {
				<span class={ j.ReasonClass() }>{ j.Reason }</span>
			}
		</span>
		<span class="cell">
			<b class="mono">{ j.Duration }</b>
			<small class="mono">{ j.FinishedRel }</small>
		</span>
	</a>
}

// jobDetail streams a job's event tail. The pre-rendered events are what the
// server has already seen; the SSE connection appends the rest. The log region
// is announced politely and never steals focus (a11y hard requirement).
templ jobDetail(vm jobDetailVM) {
	@layout(vm.Page) {
		@breadcrumb(breadcrumbCrumb{Label: "Jobs", Href: "/jobs"}, breadcrumbCrumb{Label: "#" + itoa64(vm.Job.ID)})
		<div class="pageheader">
			<p class="meta mono">
				{ vm.Job.Title }
				if vm.RunCard.CheckMode {
					· check
				}
			</p>
			<div class="actions ml-auto">
				<a class="btn" href={ templ.SafeURL("/jobs/" + itoa64(vm.Job.ID) + "/raw") } target="_blank" rel="noopener" aria-label="View raw log in new tab" title="View raw log in new tab">Raw log</a>
				if vm.Operator && vm.Job.State.Terminal() {
					if vm.Rerunnable {
						<button type="button" class="btn primary" data-modal-open="job-rerun">Rerun</button>
					}
					if vm.CanSchedule {
						<button
							type="button"
							class="btn gap6"
							data-modal-open="job-schedule"
							disabled?={ !vm.Job.Succeeded() }
							title={ scheduleTitle(vm.Job) }
						>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
								<path d={ iconSchedules }></path>
							</svg>
							Schedule
						</button>
					}
				}
			</div>
		</div>
		@runCard(vm)
		if vm.Verdict != nil {
			@verdictBand(vm)
		}
		if vm.FiredRule != "" {
			<p class="meta mt8">
				fired by rule <a href="/rules">{ vm.FiredRule }</a>
				if vm.TriggerEvent != nil {
					· event <a href={ templ.SafeURL("/events/" + itoa64(vm.TriggerEvent.ID)) }>#{ itoa64(vm.TriggerEvent.ID) }</a>
					(<span class="mono">{ vm.TriggerEvent.Source }</span> { vm.TriggerEvent.Name }) at { vm.TriggerEvent.Time }
				}
			</p>
		}
		@outputCard(vm)
		if vm.Operator && vm.Job.State.Terminal() && vm.Rerunnable {
			@rerunDialog(vm)
		}
		if vm.Operator && vm.CanSchedule {
			@modal("job-schedule", "Schedule this job") {
				<p class="meta">Creates a recurring <span class="mono">shell</span> schedule that replays this job's exact command on a cron. Kind is fixed at shell — a schedule keeps no vault, run-secrets, or working-directory binding a playbook/command job may have used.</p>
				<form method="post" action={ scheduleAction(vm.Job.ID) } class="writeform">
					<label for="js-name">Name</label>
					<input id="js-name" name="name" type="text" required autocomplete="off" pattern="[A-Za-z0-9._-]+"/>
					<label for="js-cron">Cron expression</label>
					<input id="js-cron" name="cron" type="text" required autocomplete="off" placeholder="0 */5 * * * * or @every 5m"/>
					<label>Kind</label>
					<p class="meta mono">shell</p>
					<label>Command (read-only, from this job)</label>
					<p class="meta mono">{ joinArgv(vm.Job.Argv) }</p>
					<div class="actions"><button type="submit" class="btn primary">Add schedule</button></div>
				</form>
			}
		}
		<p class="meta" id="jobs-stale" role="alert" hidden>Live updates stopped — reload to reconnect.</p>
		if !vm.Job.State.Terminal() {
			@jobStream(vm.Job.ID, vm.LastSeq)
		}
	}
}

// runCard is the job detail's lead block (2.1): the chip row (state, degraded
// host count, tool, check mode, rerun-of link), the "Queued by ..." sentence,
// the verdict number, and the RUN CONFIGURATION tile grid. The card wears the
// terminal state's inset ring through data-state.
templ runCard(vm jobDetailVM) {
	<article class="run-card" data-state={ string(vm.RunCard.State) }>
		<div class="chips">
			@chip(vm.Job.StateClass(), string(vm.Job.State))
			if vm.RunCard.DegradedChip != "" {
				<span class="chip chip--degraded"><span class="dot"></span>{ vm.RunCard.DegradedChip }</span>
			}
			<span class="chip dim"><span class="dot"></span>{ vm.RunCard.Tool }</span>
			if vm.RunCard.CheckMode {
				<span class="chip dim"><span class="dot"></span>check mode</span>
			}
			if vm.RunCard.RerunOf > 0 {
				<a class="chip chip--dashed" href={ templ.SafeURL("/jobs/" + itoa64(vm.RunCard.RerunOf)) }>rerun of #{ itoa64(vm.RunCard.RerunOf) }</a>
			}
		</div>
		<div class="runhead">
			<div class="runid">
				<div class="runtitle">
					<span class="title mono">{ vm.RunCard.Title }</span>
					<span class="jobid">job #{ itoa64(vm.RunCard.JobID) }</span>
				</div>
				<p class="sentence">{ vm.RunCard.Sentence }</p>
			</div>
			<div class="verdictcol">
				if vm.RunCard.Verdict != "" {
					<div class="verdict">
						{ vm.RunCard.Verdict }
						if vm.RunCard.Tolerated {
							<span class="tolerated">tolerated</span>
						}
					</div>
				}
				if vm.RunCard.RanLine != "" {
					<p class="ranline">{ vm.RunCard.RanLine }</p>
				}
			</div>
		</div>
		<div class="kicker">RUN CONFIGURATION</div>
		<div class="config">
			for _, t := range vm.RunCard.Tiles {
				@configTileBox(t)
			}
		</div>
	</article>
}

// configTileBox is one RUN CONFIGURATION tile: a label over a value, the value a
// link when the tile resolves somewhere, and the wait ring when it is the
// cause tile (the Tolerate tile on a degraded run).
templ configTileBox(t configTile) {
	<div class={ "tile", templ.KV("is-cause", t.Cause), templ.KV("wait", t.Wait) }>
		<span>{ t.Label }</span>
		if t.Link != "" {
			<b><a href={ templ.SafeURL(t.Link) }>{ t.Value }</a></b>
		} else {
			<b>{ t.Value }</b>
		}
	</div>
}

// verdictBand is the FAILED/DEGRADED block (2.2): the keyword line, the one
// sentence, the HOST table, and the invariant-3 verbs. It is never rendered on
// a healthy run — quiet is the design.
templ verdictBand(vm jobDetailVM) {
	<div class={ "verdict-band mt14", "verdict-band--" + vm.Verdict.BandClass }>
		<div class="bandhead">
			<span class="keyword">{ vm.Verdict.Keyword }</span>
			<a class="jump" href="#log">jump to recap in log ↓</a>
		</div>
		<p class="sentence">{ vm.Verdict.Sentence }</p>
		if len(vm.Verdict.Hosts) > 0 {
			<div class="host-table">
				<div class="hhead" aria-hidden="true">
					<span>HOST</span><span>RESULT</span><span>RECAP</span>
				</div>
				for _, h := range vm.Verdict.Hosts {
					@verdictHost(h)
				}
			</div>
		}
		if vm.Verdict.Verb != "" {
			<div class="bandverbs">
				<a href={ templ.SafeURL(vm.Verdict.VerbHref) }>{ vm.Verdict.Verb }</a>
				if vm.Verdict.VerbMeta != "" {
					<p class="meta mono">{ vm.Verdict.VerbMeta }</p>
				}
				if vm.Verdict.VerbSecond != "" {
					<a href={ templ.SafeURL(vm.Verdict.VerbSecondHref) }>{ vm.Verdict.VerbSecond }</a>
				}
			</div>
		}
	</div>
}

// verdictHost is one row of the verdict band's host table: host · result
// (state-coloured dot + keyword) · per-host recap.
templ verdictHost(h jobVerdictHost) {
	<div class="hrow">
		<span class="host">{ h.Host }</span>
		<span class={ "result", h.Class }><span class="dot"></span>{ h.Result }</span>
		<span class="recap">{ h.Recap }</span>
	</div>
}

// outputCard is the retuned log tail (2.3, J6): the Output header with the
// line meta, the ENDED pill, the filter input (placeholder only), the wrap
// toggle, and the log with the run's state bands re-rendered from copy.
templ outputCard(vm jobDetailVM) {
	<div class="card mt14">
		<div class="outputbar">
			<span class="outputtitle">Output</span>
			<span class="outputmeta mono">{ outputMeta(len(vm.Events), vm.Job.State.Terminal()) }</span>
			<div class="logtools ml-auto">
				if vm.Job.State.Terminal() {
					<span class="pill">ENDED · nothing to follow</span>
				}
				<input id="log-search" type="search" autocomplete="off" placeholder="filter log" aria-label="Filter log"/>
				<button type="button" class="logwrap" id="logwrap" aria-pressed="true">wrap</button>
			</div>
		</div>
		<pre id="log" class="log" role="log" aria-live="polite" aria-label="Job log">
			for _, e := range vm.Events {
				if e.Band != "" {
					<div class={ "logband", e.BandClass }><span class="ts">{ e.Ts }</span> { e.Band }</div>
				} else {
					@logLine(e)
				}
			}
		</pre>
	</div>
	<script>
	(function () {
		var input = document.getElementById("log-search");
		var log = document.getElementById("log");
		if (!input || !log) return;
		window.exoFilterLog = function () {
			var q = input.value.trim().toLowerCase();
			var lines = log.querySelectorAll(".logln, .logband");
			for (var i = 0; i < lines.length; i++) {
				lines[i].style.display = (q === "" || lines[i].textContent.toLowerCase().indexOf(q) !== -1) ? "" : "none";
			}
		};
		input.addEventListener("input", window.exoFilterLog);
		var wrap = document.getElementById("logwrap");
		if (wrap) {
			wrap.addEventListener("click", function () {
				var nowrap = log.classList.toggle("nowrap");
				wrap.setAttribute("aria-pressed", nowrap ? "false" : "true");
			});
		}
	})();
	</script>
}

// rerunDialog is the resubmit modal (1c): the facts block (read-only identity
// plus the editable Limit), the OPTIONS toggles (Check mode, Show diff,
// Tolerate unreachable hosts — pre-highlighted when this job failed on
// unreachable hosts), and the footer contract button. ?rerun=1 renders it open
// for JS-off.
templ rerunDialog(vm jobDetailVM) {
	<dialog class="modal" id="job-rerun" aria-labelledby="job-rerun-title" open?={ vm.RerunOpen }>
		<div class="modal-head">
			<div class="modal-title">
				<span class="kicker">RERUN JOB #{ itoa64(vm.Job.ID) }</span>
				<h2 id="job-rerun-title">Queue the same run again</h2>
			</div>
			<button type="button" class="modal-close" data-modal-dismiss aria-label="Close">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
					<path d="M3 3l10 10M13 3L3 13"></path>
				</svg>
			</button>
		</div>
		<div class="modal-body">
			<p class="meta">Same playbook, ref, inventory and secrets as <a href={ templ.SafeURL("/jobs/" + itoa64(vm.Job.ID)) }>#{ itoa64(vm.Job.ID) }</a>. Change only what is listed here.</p>
			<form method="post" action={ rerunAction(vm.Job.ID) } class="writeform">
				<div class="facts">
					<div><span>Playbook</span><b class="mono">{ vm.RunCard.Title }</b></div>
					if vm.Source != "" {
						<div><span>Source</span><b class="mono">{ vm.Source }</b></div>
					}
					<div><span>Ref</span><b class="mono">{ orDash(vm.RefLabel) }</b></div>
					<div><span>Inventory</span><b class="mono">{ orDash(vm.Rerun.Inventory) }</b></div>
				</div>
				<label for="jr-limit">Limit</label>
				<input id="jr-limit" name="limit" type="text" autocomplete="off" placeholder="host or group pattern" value={ vm.Rerun.Limit }/>
				<span class="kicker">OPTIONS</span>
				<div class="toggle-row">
					@toggle("check", "Check mode", vm.Rerun.Check, false)
					<p class="meta">report what would change, change nothing</p>
				</div>
				<div class="toggle-row">
					@toggle("diff", "Show diff", vm.Rerun.Diff, false)
				</div>
				<div class={ "toggle-row", templ.KV("is-suggested", len(vm.RerunFailedOn) > 0) }>
					@toggle("tolerate_unreachable", "Tolerate unreachable hosts", vm.Rerun.Tolerate, false)
					<p class="meta">Offline hosts are skipped and the job settles <span class="wait-text">DEGRADED</span> instead of FAILED when the rest succeed.
						if len(vm.RerunFailedOn) > 0 {
							<span> #{ itoa64(vm.Job.ID) } failed on { andList(vm.RerunFailedOn) }.</span>
						}
						<span> CLI: --tolerate-unreachable</span>
					</p>
				</div>
				<div class="actions">
					<button type="submit" class="btn primary">{ vm.RerunQueueLabel() }</button>
				</div>
				<p class="meta mono rerun-summary">{ vm.Rerun.Summary() }</p>
				<button type="button" class="btn quiet" data-modal-dismiss>Cancel</button>
			</form>
		</div>
	</dialog>
}

templ logLine(e eventLine) {
	if e.Level == "error" {
		<span class="logln err"><span class="ts">{ e.Ts }</span> { e.Msg }</span>
	} else if e.Level == "system" {
		<span class="logln sys"><span class="ts">{ e.Ts }</span> { e.Msg }</span>
	} else {
		<span class="logln"><span class="ts">{ e.Ts }</span> { e.Msg }</span>
	}
}

// jobStream opens the SSE connection for a running job with the browser's own
// EventSource — no framework, the brief's "SSE for live updates". since is
// the Seq of the last event this page already rendered; the server backfills
// everything after it, so nothing written between render and connect is
// skipped. On "done" it reloads rather than just closing: the terminal status
// chip, the full log, and the now-enabled Schedule button are all rendered
// server-side, and a reload is the simplest way to get the true final state
// rather than reconstructing it in JS.
// There is no onerror close: EventSource reconnects on its own, and closing on
// error would turn a transient tunnel drop into a dead tail. onerror surfaces
// the #jobs-stale banner only when the stream is closed for good (a refused
// 503 or an ended socket), never during a transient drop EventSource is
// already retrying; onopen clears it on every successful (re)connect, so a
// long quiet job that only heartbeats never wears a stale banner. The
// reload-on-done is the terminal path.
templ jobStream(id int64, since int64) {
	<script data-job={ itoa64(id) } data-since={ itoa64(since) }>
	(function () {
		var script = document.currentScript;
		var job = script.getAttribute("data-job");
		var since = script.getAttribute("data-since");
		var log = document.getElementById("log");
		var stale = document.getElementById("jobs-stale");
		var es = new EventSource("/jobs/" + job + "/stream?since=" + since);
		es.addEventListener("line", function (ev) {
			var d = JSON.parse(ev.data);
			var span = document.createElement("span");
			span.className = "logln" + (d.level === "error" ? " err" : d.level === "system" ? " sys" : "");
			var ts = document.createElement("span");
			ts.className = "ts";
			ts.textContent = d.ts;
			span.appendChild(ts);
			span.appendChild(document.createTextNode(" " + d.msg));
			log.appendChild(span);
			if (window.exoFilterLog) window.exoFilterLog();
			log.scrollTop = log.scrollHeight;
		});
		es.addEventListener("done", function () { location.reload(); });
		es.onerror = function () {
			// Only a permanently-closed stream is a real failure worth
			// surfacing: EventSource fires onerror on every transient drop
			// while it retries, and a refused (503) stream is closed for good.
			if (es.readyState === EventSource.CLOSED && stale) stale.hidden = false;
		};
		es.onopen = function () {
			// A reconnect is proof the stream is live again, even if the quiet
			// job then emits nothing for a long stretch — the banner must not
			// stay up on a healthy stream.
			if (stale) stale.hidden = true;
		};
	})();
	</script>
}