package web

// schedulesList is the schedules surface: every cron schedule with its kind and
// expression, next fire, and the outcome of the job its last fire enqueued. A
// disabled schedule is dimmed, not hidden (the brief). A drift-check schedule
// (a tofu-plan or play --check kind) reads its last drift result straight off
// the last-job chip.
//
// Schedules carry no secret material, so — unlike tokens and secrets — the
// write controls here are plain operator-scope: no reauth, no confirm_token.
templ schedulesList(vm schedulesVM) {
	@layout(vm.Page) {
		if vm.Operator {
			@modal("schedules-add", "Add a schedule") {
				<p class="meta">Mirrors <code>exocomp schedule add</code>: kind decides which fields apply. Command is whitespace-split (no quoting) — a command needing quoted arguments still wants the CLI.</p>
				<form method="post" action="/schedules/add" class="writeform">
					<label for="sc-name">Name</label>
					<input id="sc-name" name="name" type="text" required autocomplete="off" pattern="[A-Za-z0-9._-]+" value={ vm.Prefill.Name }/>
					<label for="sc-cron">Cron expression</label>
					<input id="sc-cron" name="cron" type="text" required autocomplete="off" placeholder="0 */5 * * * * or @every 5m"/>
					<label for="sc-kind">Kind</label>
					<select id="sc-kind" name="kind">
						<option value="shell" selected?={ vm.Prefill.Kind == "" || vm.Prefill.Kind == "shell" }>shell</option>
						<option value="backup" selected?={ vm.Prefill.Kind == "backup" }>backup</option>
						<option value="play" selected?={ vm.Prefill.Kind == "play" }>play</option>
						<option value="drill" selected?={ vm.Prefill.Kind == "drill" }>drill</option>
					</select>
					<label for="sc-argv">Command (shell/play kinds)</label>
					<input id="sc-argv" name="argv" type="text" autocomplete="off" placeholder="shell: the command; play: playbook.yml [--extra-vars ...]" value={ vm.Prefill.Argv }/>
					<label for="sc-target">Target (backup/drill: target name, empty = every enabled target; play: standing inventory name)</label>
					<input id="sc-target" name="target" type="text" autocomplete="off" value={ vm.Prefill.Target }/>
					<label for="sc-ck">Concurrency key (shell/play only)</label>
					<input id="sc-ck" name="concurrency_key" type="text" autocomplete="off"/>
					<label for="sc-jitter">Jitter seconds (optional)</label>
					<input id="sc-jitter" name="jitter" type="number" min="0" autocomplete="off" placeholder="0"/>
					<label class="checkline"><input type="checkbox" name="check" value="1"/> play kind: run in check mode (config-drift schedule)</label>
					<label class="checkline"><input type="checkbox" name="tolerate_unreachable" value="1"/> play kind: tolerate unreachable hosts (roaming-fleet converge)</label>
					<div class="actions"><button type="submit" class="btn primary">Add schedule</button></div>
				</form>
			}
			if vm.Prefill.Open {
				<script>exoModalOpen("schedules-add");</script>
			}
		}
		<div class="card span2 mt18 tray">
			<div class="kicker">Cron schedules</div>
			<h3>All schedules</h3>
			if !vm.Operator {
				<p class="meta">Read-only: managing schedules needs an operator token.</p>
			}
			if len(vm.Schedules) == 0 {
				<p class="meta">No schedules registered — add one.</p>
			} else {
				<div class="tablewrap stackable">
					<table>
						<thead>
							<tr>
								<th scope="col">Schedule</th>
								<th scope="col">Kind</th>
								<th scope="col">Cron</th>
								<th scope="col">Next fire</th>
								<th scope="col">Last outcome</th>
								if vm.ShowEnabledColumn() {
									<th scope="col">Enabled</th>
								}
								if vm.Operator {
									<th scope="col">Actions</th>
								}
							</tr>
						</thead>
						<tbody>
for _, sc := range vm.Schedules {
							<tr data-modal-row={ "sched-" + sc.Name }>
								<td data-label="Schedule"><button type="button" class="cellact" data-modal-open={ "sched-" + sc.Name }>{ sc.Name }</button></td>
									<td class="mono" data-label="Kind">{ sc.Kind }</td>
									<td class="mono" data-label="Cron">{ sc.Cron }</td>
									<td class="mono" data-label="Next fire">{ sc.Next }</td>
									<td data-label="Last outcome">
										if sc.HasLast {
											<a href={ templ.SafeURL("/jobs/" + itoa64(sc.LastJobID)) }>
												@chip(sc.LastClass(), string(sc.LastState))
											</a>
											<span class="meta">{ workspaceSuffix(sc.LastRunbook) }</span>
										} else {
											<span class="meta">never fired</span>
										}
									</td>
									if vm.ShowEnabledColumn() {
										<td data-label="Enabled">@enabledChip(sc.Enabled, true)</td>
									}
									if vm.Operator {
										<td data-label="Actions">
											if sc.Enabled {
												<form method="post" action={ templ.SafeURL("/schedules/" + sc.Name + "/disable") } class="inline-form">
													<button type="submit" class="btn">Disable</button>
												</form>
											} else {
												<form method="post" action={ templ.SafeURL("/schedules/" + sc.Name + "/enable") } class="inline-form">
													<button type="submit" class="btn">Enable</button>
												</form>
											}
											<form method="post" action={ templ.SafeURL("/schedules/" + sc.Name + "/rm") } class="inline-form" data-confirm={ "Remove schedule " + sc.Name + "?" }>
												<input type="hidden" name="confirmed" value="1"/>
												<button type="submit" class="btn danger">Remove…</button>
											</form>
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
		for _, sc := range vm.Schedules {
			@modal("sched-"+sc.Name, "Schedule — "+sc.Name) {
				<dl class="kv">
					<div><dt>Kind</dt><dd class="mono">{ sc.Kind }</dd></div>
					<div><dt>Cron</dt><dd class="mono">{ sc.Cron }</dd></div>
					<div><dt>Command</dt><dd class="mono wrap">{ orDash(joinArgv(sc.Argv)) }</dd></div>
					<div><dt>Target</dt><dd class="mono">{ orDash(sc.Target) }</dd></div>
					<div><dt>Concurrency key</dt><dd class="mono">{ orDash(sc.ConcurrencyKey) }</dd></div>
					<div><dt>Jitter</dt><dd class="mono">{ itoa(int64(sc.JitterS)) }s</dd></div>
					if sc.Kind == "play" {
						<div><dt>Tolerate unreachable</dt><dd>{ yesNo(sc.TolerateUnreachable) }</dd></div>
					}
					<div><dt>Enabled</dt><dd>@enabledChip(sc.Enabled, false)</dd></div>
					<div><dt>Next fire</dt><dd class="mono">{ sc.Next }</dd></div>
					<div><dt>Last fired</dt><dd class="mono">{ sc.LastRun }</dd></div>
					<div>
						<dt>Last outcome</dt>
						<dd>
							if sc.HasLast {
								<a href={ templ.SafeURL("/jobs/" + itoa64(sc.LastJobID)) }>
									@chip(sc.LastClass(), string(sc.LastState))
								</a>
								<span class="meta">{ workspaceSuffix(sc.LastRunbook) }</span>
							} else {
								<span class="meta">never fired</span>
							}
						</dd>
					</div>
				</dl>
			}
		}
	}
}
