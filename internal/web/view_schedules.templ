package web

// schedulesList is the schedules surface: every cron schedule with its kind and
// expression, next fire, and the outcome of the job its last fire enqueued. A
// disabled schedule is dimmed, not hidden (the brief). A drift-check schedule
// (a tofu-plan or play --check kind) reads its last drift result straight off
// the last-job chip.
templ schedulesList(vm schedulesVM) {
	@layout(vm.Page) {
		<h1>Schedules</h1>
		<div class="card span2" style="margin-top:18px">
			if len(vm.Schedules) == 0 {
				<p class="meta">No schedules registered. Add one with <code>exocomp schedule add</code>.</p>
			} else {
				<div class="tablewrap">
					<table>
						<thead>
							<tr>
								<th scope="col">Schedule</th>
								<th scope="col">Kind</th>
								<th scope="col">Cron</th>
								<th scope="col">Next fire</th>
								<th scope="col">Last outcome</th>
								<th scope="col">Enabled</th>
							</tr>
						</thead>
						<tbody>
							for _, sc := range vm.Schedules {
								<tr>
									<td>{ sc.Name }</td>
									<td class="mono">{ sc.Kind }</td>
									<td class="mono">{ sc.Cron }</td>
									<td class="mono">{ sc.Next }</td>
									<td>
										if sc.HasLast {
											<a href={ templ.SafeURL("/jobs/" + itoa64(sc.LastJobID)) }>
												@chip(sc.LastClass(), string(sc.LastState))
											</a>
											<span class="meta">{ workspaceSuffix(sc.LastRunbook) }</span>
										} else {
											<span class="meta">never fired</span>
										}
									</td>
									<td>
										if sc.Enabled {
											<span class="chip ok"><span class="dot"></span>ENABLED</span>
										} else {
											<span class="chip dim"><span class="dot"></span>DISABLED</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
