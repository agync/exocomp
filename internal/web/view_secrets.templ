package web

// expiryChip renders a secret's staleness marker — never its value. EXPIRED is
// a loud failure, an approaching expiry a wait, a distant or absent one dim,
// mirroring the enabledChip/signedChip pattern: always labelled, never
// colour-only.
templ expiryChip(m expiryMarker) {
	<span class={ "chip", m.Class }><span class="dot"></span>{ m.Label }</span>
}

// secretBindings lists the run-secret bindings that inject a secret and the env
// var each maps it to, or "unbound" when nothing does. It NEVER shows a value:
// the sealed material is resolved from the envelope at execution time, not here.
templ secretBindings(rows []secretBindingRow) {
	if len(rows) == 0 {
		<span class="meta">unbound — safe to remove</span>
	} else {
		for _, b := range rows {
			<div class="meta">used by <span class="mono">{ b.Binding }</span> as <span class="mono">${ b.EnvName }</span></div>
		}
	}
}

// secretLegs lists the /system legs that read a secret (SPEC §7 A2): the leg
// name linking to its page, so a rotation names its consumer. Never a value.
templ secretLegs(rows []usedByRow, base string) {
	for _, u := range rows {
		<div class="meta">used by <a href={ urlWithBase(base, u.Href) }>{ u.Name }</a></div>
	}
}

// secretsList is the secrets surface: the sealed-value inventory (lifecycle
// metadata + bindings, never the value/nonce/ciphertext — invariant 4), plus
// the operator write controls. Sealing needs the envelope; a nil Sealer shows a
// note instead of the form. Add/rotate are gated by a confirm-token re-auth.
templ secretsList(vm secretsVM) {
	@layout(vm.Page) {
		<p class="meta">
			Values are sealed with age and never leave the server — this page is
			metadata only. Runs receive a secret through a binding, never an echo.
		</p>
		if vm.Operator {
			@modal("secrets-add", "Seal a secret") {
				if !vm.SealAvailable {
					<p class="meta">Sealing is not available on this surface (this process holds no envelope).</p>
				} else {
					<p class="meta">The value is sealed into the envelope and never shown again. Confirm with your own access token.</p>
					<form method="post" action={ urlWithBase(vm.Page.Base, "/secrets/add") } class="writeform" id="secrets-add-form" novalidate data-secret-form data-pending="Adding secret">
						@fieldInput(vm.Form.nameField())
						@fieldInput(vm.Form.kindField())
						@fieldInput(vm.Form.valueField())
						<label class="checkline"><input type="checkbox" name="generate" value="1"/> generate a random value instead</label>
						@fieldInput(vm.Form.expiresField())
						<label for="se-cf">Confirm: your access token</label>
						<input id="se-cf" name="confirm_token" type="password" autocomplete="off"/>
						@formStatus(vm.Form.Pending(), vm.Form.ErrFormText(), "Adding secret")
						<div class="actions"><button type="submit" class="btn primary" disabled?={ vm.Form.Pending() }>Seal secret</button></div>
					</form>
					if vm.Form != nil {
						<script>
						exoModalOpen("secrets-add");
						var seBad = document.querySelector('#secrets-add input[aria-invalid="true"]');
						if (seBad) seBad.focus();
						</script>
					}
					@secretFormJS()
				}
			}
		}
		<div class="card span2 mt18 tray">
			<div class="kicker">Sealed values</div>
			<h3>All secrets</h3>
			if !vm.Operator {
				<p class="meta">Read-only: managing secrets needs an operator token. The sealed value never appears on this surface.</p>
			}
			if len(vm.Secrets) == 0 {
				<p class="meta">No secrets sealed.</p>
			} else {
				<div class="tablewrap stackable">
					<table data-focus={ vm.FocusKey }>
						<thead>
							<tr>
								<th scope="col">Name</th>
								<th scope="col">Kind</th>
								<th scope="col">Source</th>
								<th scope="col">Created</th>
								<th scope="col">Last rotated</th>
								<th scope="col">Last used</th>
								<th scope="col">Expiry</th>
								<th scope="col">Used by</th>
								if vm.Operator {
									<th scope="col">Actions</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, sc := range vm.Secrets {
								<tr id={ "secret-" + sc.Name } class={ templ.KV("row-focus", vm.FocusKey == sc.Name) }>
									<td data-label="Name">{ sc.Name }</td>
									<td class="mono" data-label="Kind">{ orDash(sc.Kind) }</td>
									<td data-label="Source">{ orDash(sc.Source) }</td>
									<td class="mono" data-label="Created">{ sc.Created }</td>
									<td class="mono" data-label="Last rotated">{ sc.Rotated }</td>
									<td class="mono" data-label="Last used">{ sc.LastUsed }</td>
									<td data-label="Expiry">@expiryChip(sc.Expiry)</td>
									<td data-label="Used by">
										@secretLegs(sc.UsedBy, vm.Page.Base)
										@secretBindings(sc.Bindings)
									</td>
									if vm.Operator {
										<td data-label="Actions">
											@rowActions(secretRowActions(sc, vm.SealAvailable), vm.Page.Base)
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
					<script>
					(function () {
						var table = document.querySelector('table[data-focus]');
						var key = table ? table.getAttribute("data-focus") : "";
						if (key) {
							var el = document.getElementById("secret-" + key);
							if (el) el.scrollIntoView({ block: "center" });
						}
					})();
					</script>
				</div>
			}
		</div>
		if vm.Operator && vm.SealAvailable {
			for _, sc := range vm.Secrets {
				@modal("secret-rotate-"+sc.Name, "Rotate "+sc.Name) {
					<p class="meta">The value is sealed into the envelope and never shown again. Confirm with your own access token.</p>
					<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/secrets/" + sc.Name + "/rotate")) } class="writeform" id={ "secret-rotate-form-" + sc.Name } novalidate data-secret-rotate data-name={ sc.Name } data-pending="Rotating secret">
						@fieldInput(vm.rotateValueField(sc.Name))
						<label class="checkline"><input type="checkbox" name="generate" value="1"/> generate a random value instead</label>
						@fieldInput(vm.rotateExpiresField(sc.Name))
						<label for={ "scf-" + sc.Name }>Confirm: your access token</label>
						<input id={ "scf-" + sc.Name } name="confirm_token" type="password" autocomplete="off"/>
						@formStatus(vm.rotatePending(), vm.rotateErrForm(), "Rotating secret")
						<div class="actions"><button type="submit" class="btn primary" disabled?={ vm.rotatePending() }>Rotate</button></div>
					</form>
				}
				@modal("secret-bindings-"+sc.Name, "Bindings — "+sc.Name) {
					<p class="meta">Run-secret bindings that inject this secret and the env var each maps it to. Values are never shown.</p>
					@secretBindings(sc.Bindings)
				}
			}
			if vm.Rotate != nil {
				<script data-modal={ "secret-rotate-" + vm.Rotate.Name } data-form={ "secret-rotate-form-" + vm.Rotate.Name }>
				(function () {
					var s = document.currentScript;
					exoModalOpen(s.getAttribute("data-modal"));
					var seRotBad = document.querySelector('#' + s.getAttribute("data-form") + ' input[aria-invalid="true"]');
					if (seRotBad) seRotBad.focus();
				})();
				</script>
			}
		}
	}
}

templ secretReauthNotice(p page) {
	@layout(p) {
		@breadcrumb(breadcrumbCrumb{Label: "Secrets", Href: urlWithBase(p.Base, "/secrets")}, breadcrumbCrumb{Label: "Confirm"})
		<h1>Confirm required</h1>
		<div class="card span2 mt18">
			<p class="error" role="alert">That access token did not match this session. Re-enter your own token to confirm the sealed write.</p>
		</div>
	}
}

// secretFormJS wires the seal and rotate forms' progressive enhancement,
// mirroring the netgroup/source forms: novalidate (the daemon is authoritative),
// submit intercepted and POSTed with fetch — a 422 swaps the form fragment in
// place with the server-rendered refusals (JS-off gets the same bytes as a full
// re-render) — and anything else follows the redirect and its success flash.
// The status line's Retry re-submits the same form. A secret's value never
// re-validates on blur — it must never echo, so only the server re-renders its
// refusal; the name field's shape rule is the one client-side check.
templ secretFormJS() {
	<script>
	(function () {
		function restoreMeta(input) {
			input.removeAttribute("aria-invalid");
			var meta = document.getElementById(input.getAttribute("aria-describedby"));
			if (meta) {
				meta.classList.remove("is-error");
				meta.textContent = input.name === "name"
					? "Letters, digits, dots, hyphens, underscores, slashes."
					: "";
			}
		}
		function showError(input, msg) {
			input.setAttribute("aria-invalid", "true");
			var meta = document.getElementById(input.getAttribute("aria-describedby"));
			if (meta) {
				meta.classList.add("is-error");
				meta.textContent = "▲ " + msg;
			}
		}
		function validateField(input) {
			if (input.value.trim() === "") return;
			if (input.name === "name" && !/^[A-Za-z0-9._\/-]+$/.test(input.value.trim())) {
				showError(input, "Names can't have spaces.");
				return;
			}
			restoreMeta(input);
		}
		function wireForm(form) {
			if (!form || form.dataset.secretWired) return;
			form.dataset.secretWired = "1";
			var primary = form.querySelector('button[type="submit"]');
			var status = form.querySelector(".form-status");
			var pending = form.getAttribute("data-pending") || "Adding secret";
			form.addEventListener("click", function (e) {
				var retry = e.target.closest("[data-retry]");
				if (retry) {
					e.preventDefault();
					form.requestSubmit();
				}
			});
			form.addEventListener("blur", function (e) {
				var input = e.target.closest('input[name="name"]');
				if (input) validateField(input);
			}, true);
			form.addEventListener("submit", function (e) {
				e.preventDefault();
				primary.disabled = true;
				if (status) status.innerHTML = '<span class="dot"></span>' + pending;
				fetch(form.getAttribute("action"), {
					method: "POST",
					body: new FormData(form),
					credentials: "same-origin",
					headers: { "Accept": "text/html" }
				}).then(function (resp) {
					if (resp.status === 422) {
						return resp.text().then(function (html) {
							var doc = new DOMParser().parseFromString(html, "text/html");
							var next = doc.getElementById(form.id);
							if (!next) return;
							form.outerHTML = next.outerHTML;
							form = document.getElementById(form.id);
							if (!form) return;
							wireForm(form);
							var bad = form.querySelector('input[aria-invalid="true"]');
							if (bad) bad.focus();
						});
					}
					var loc = resp.headers.get("Location");
					if (loc) { window.location = loc; return; }
					window.location.reload();
				}).catch(function () {
					primary.disabled = false;
					if (status) status.textContent = "";
				});
			});
		}
		wireForm(document.getElementById("secrets-add-form"));
		var rots = document.querySelectorAll("form[data-secret-rotate]");
		for (var i = 0; i < rots.length; i++) wireForm(rots[i]);
	})();
	</script>
}
