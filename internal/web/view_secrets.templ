package web

// expiryChip renders a secret's staleness marker — never its value. EXPIRED is
// a loud failure, an approaching expiry a wait, a distant or absent one dim,
// mirroring the enabledChip/signedChip pattern: always labelled, never
// colour-only.
templ expiryChip(m expiryMarker) {
	<span class={ "chip", m.Class }><span class="dot"></span>{ m.Label }</span>
}

// secretBindings lists the run-secret bindings that inject a secret and the env
// var each maps it to, or "unbound" when nothing does. It NEVER shows a value:
// the sealed material is resolved from the envelope at execution time, not here.
templ secretBindings(rows []secretBindingRow) {
	if len(rows) == 0 {
		<span class="meta">unbound</span>
	} else {
		for _, b := range rows {
			<div class="meta">used by <span class="mono">{ b.Binding }</span> as <span class="mono">${ b.EnvName }</span></div>
		}
	}
}

// secretsList is the secrets surface: a read-only inventory of the sealed values
// in the envelope — each secret's kind, source, lifecycle timestamps, expiry
// staleness marker, and the run-secret bindings that inject it. The value,
// nonce, and ciphertext are deliberately absent (invariant 4: secrets never
// render anywhere). Creation, rotation and deletion stay CLI verbs; there is no
// mutation control here.
templ secretsList(vm secretsVM) {
	@layout(vm.Page) {
		<h1>Secrets</h1>
		<div class="card span2" style="margin-top:18px">
			<div class="kicker">Read-only · values never shown</div>
			<h3>All secrets</h3>
			<p class="meta">Manage via <code>exocomp secrets add|rotate|rm</code>. The sealed value never appears on this surface.</p>
			if len(vm.Secrets) == 0 {
				<p class="meta">No secrets sealed. Add one with <code>exocomp secrets add</code>.</p>
			} else {
				<div class="tablewrap stackable">
					<table>
						<thead>
							<tr>
								<th scope="col">Name</th>
								<th scope="col">Kind</th>
								<th scope="col">Source</th>
								<th scope="col">Created</th>
								<th scope="col">Last rotated</th>
								<th scope="col">Last used</th>
								<th scope="col">Expiry</th>
								<th scope="col">Used by</th>
							</tr>
						</thead>
						<tbody>
							for _, sc := range vm.Secrets {
								<tr>
									<td data-label="Name">{ sc.Name }</td>
									<td class="mono" data-label="Kind">{ orDash(sc.Kind) }</td>
									<td data-label="Source">{ orDash(sc.Source) }</td>
									<td class="mono" data-label="Created">{ sc.Created }</td>
									<td class="mono" data-label="Last rotated">{ sc.Rotated }</td>
									<td class="mono" data-label="Last used">{ sc.LastUsed }</td>
									<td data-label="Expiry">@expiryChip(sc.Expiry)</td>
									<td data-label="Used by">@secretBindings(sc.Bindings)</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
