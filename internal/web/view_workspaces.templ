package web

// workspacesList is the Workspaces write surface (managed OpenTofu state): every
// registered state (store.Workspace under the hood — the DR-critical name stays
// internal) with its type — state-only (TofuDir empty, exocomp is just the
// encrypted http backend for an external tofu) or runs-in-server (exocomp also
// plans/applies it) — and its newest stored tfstate serial, plus per-row Plan
// and Apply forms for runs-in-server rows. Every row also gets a Backend config
// action: the same ready-to-paste `backend "http"` block `workspace add
// --state-only` prints, computed the identical way (api.NewBackendBlock). The
// header's Configure action opens a how-to modal (OpenTofu/Terraform tabs) with
// the same block shape at the backend's base address.
// A plan runs through PlanWorkspace with the "api" trigger, exactly as a
// bearer-token plan does, so its -out file is sealed into a consumable artifact
// post-run; the Saved plans modal lists the workspace's saved plan artifacts
// and posts one by id into the apply route, consuming that saved plan's
// recorded policy verdict. An apply with no plan is a fresh apply — auto-
// approved unless the workspace has enabled plan policies, in which case it is
// refused (there is nothing for a policy to read). Workspaces carry no secret
// material of their own — the backend config block does, but it is shown to an
// operator exactly as the CLI would print it to them, never logged — so, like
// run and schedules, the controls here are plain operator-scope: no reauth, no
// confirm_token.
templ workspacesList(vm workspacesVM) {
	@layout(vm.Page) {
		<div class="card span2 tray">
			if vm.Operator {
				<div class="kicker">Remote state</div>
			} else {
				<div class="kicker">Read-only</div>
			}
			<h3>States</h3>
			if !vm.Operator {
				<p class="meta">Read-only: registering state, planning, or applying needs an operator token.</p>
			}
			if len(vm.Workspaces) == 0 {
				<p class="meta">No workspace registered — exocomp ws add on the host defines one.</p>
			} else {
				<div class="tablewrap stackable">
					<table>
						<thead>
							<tr>
								<th scope="col">Name</th>
								<th scope="col">Type</th>
								<th scope="col">State</th>
								if vm.Operator {
									<th scope="col">Actions</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, wsr := range vm.Workspaces {
								<tr data-href={ templ.SafeURL("/workspaces/" + wsr.Name) }>
									<td data-label="Name"><a href={ templ.SafeURL("/workspaces/" + wsr.Name) }>{ wsr.Name }</a></td>
									<td data-label="Type">@chip(wsr.TypeClass(), wsr.TypeLabel())</td>
									<td data-label="State">@chip(wsr.StateClass(), wsr.StateLabel())</td>
									if vm.Operator {
										<td data-label="Actions">
											@rowActions(workspaceRowActions(wsr))
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
		if vm.Operator {
			@modal("ws-configure", "Configure remote state backend") {
				<p class="meta">exocomp is the state backend: it holds each workspace's encrypted <code>tfstate</code> and serves it over HTTP. Add the <code>backend "http"</code> block to your config (replace <code>{ configExampleWorkspace }</code> with the workspace name), then initialise. The block is identical for OpenTofu and Terraform; only the init CLI differs. Each row's <b>Backend config</b> gives that workspace's exact block (address and bearer).</p>
				<div class="tabs" role="tablist" aria-label="State tool" id="ws-cfg-tabs">
					<button type="button" class="tab" id="ws-cfg-tab-tofu" role="tab" data-tab="tofu" aria-controls="ws-cfg-tofu" aria-selected="true">OpenTofu</button>
					<button type="button" class="tab" id="ws-cfg-tab-terraform" role="tab" data-tab="terraform" aria-controls="ws-cfg-terraform" aria-selected="false">Terraform</button>
				</div>
				<div id="ws-cfg-tofu" class="tabpanel" role="tabpanel" aria-labelledby="ws-cfg-tab-tofu">
					if vm.Config.Address == "" {
						<p class="meta">No state backend address recorded yet — start `exocomp serve`, or pass --address to `workspace add --state-only`.</p>
					} else {
						@codeblock("OpenTofu backend config", vm.Config.HCL())
						@codeblock("tofu init", "tofu init")
					}
				</div>
				<div id="ws-cfg-terraform" class="tabpanel" role="tabpanel" aria-labelledby="ws-cfg-tab-terraform" hidden>
					if vm.Config.Address == "" {
						<p class="meta">No state backend address recorded yet — start `exocomp serve`, or pass --address to `workspace add --state-only`.</p>
					} else {
						@codeblock("Terraform backend config", vm.Config.HCL())
						@codeblock("terraform init", "terraform init")
					}
				</div>
				<script>
				(function () {
					var scope = document.getElementById("ws-cfg-tabs");
					if (!scope) return;
					var tabs = Array.prototype.slice.call(scope.querySelectorAll('[role="tab"]'));
					tabs.forEach(function (t) {
						t.addEventListener("click", function () {
							tabs.forEach(function (o) {
								var on = o === t;
								o.setAttribute("aria-selected", on ? "true" : "false");
								var panel = document.getElementById(o.getAttribute("aria-controls"));
								if (panel) panel.hidden = !on;
							});
						});
					});
				})();
				</script>
			}
		}
	}
}

// codeblock renders a copyable, horizontally-scrolling code/secret block: the
// pre keeps its formatting and scrolls inside its own box (so a long backend
// address never widens the modal), with a copy-to-clipboard button wired by the
// delegated handler in layoutReady().
templ codeblock(label, content string) {
	<div class="codeblock">
		<pre class="secretbox code" aria-label={ label }>{ content }</pre>
		<button type="button" class="copybtn" aria-label="Copy to clipboard" title="Copy">
			<svg class="copy-i" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
			<svg class="copy-ok" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
		</button>
	</div>
}
