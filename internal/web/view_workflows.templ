package web

// stepDots renders a chain's ordered steps as a compact status strip, one dot
// per step in step order, so the ledger's shape reads at a glance. Each dot
// carries its step kind and status as a title for the pointer and a label for a
// screen reader; the /workflows/{id} view is the full ledger. Shared by the
// workflows surface and the dashboard's in-flight card.
templ stepDots(steps []workflowStepRow) {
	<span class="steprail" role="list" aria-label="workflow steps">
		for _, st := range steps {
			<span class={ "stepdot", st.StatusClass() } role="listitem" title={ st.Kind + " · " + string(st.Status) } aria-label={ st.Kind + " " + string(st.Status) }></span>
		}
	</span>
}

// workflowsList is the step-ledger surface (ADR 0008): the provision->onboard->
// converge and TF->ansible handoff chains, in-flight and recently finished. The
// whole-workflow state is derived from its steps, and the step rail shows the
// ledger's shape without opening it.
templ workflowsList(vm workflowsVM) {
	@layout(vm.Page) {
		<h1>Workflows</h1>
		<div class="card span2 mt18">
			<h3>All workflows</h3>
			if len(vm.Workflows) == 0 {
				<p class="meta">No workflows recorded.</p>
			} else {
				<div class="tablewrap">
					<table>
						<thead>
							<tr>
								<th scope="col">Workflow</th>
								<th scope="col">State</th>
								<th scope="col" class="right">Steps</th>
								<th scope="col">Ledger</th>
							</tr>
						</thead>
						<tbody>
							for _, f := range vm.Workflows {
								<tr data-href={ "/workflows/" + f.ID }>
									<td class="mono"><a href={ templ.SafeURL("/workflows/" + f.ID) }>{ f.ID }</a></td>
									<td>@chip(f.StateClass(), string(f.State))</td>
									<td class="right num">{ f.Progress() }</td>
									<td>@stepDots(f.Steps)</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// workflowDetail is one chain's ordered step ledger: each step's kind, status
// (pending/running/succeeded/failed/blocked), and the job that ran it. The
// status is read from the ledger rows, the single source of truth (ADR 0008),
// never recomputed.
templ workflowDetail(vm workflowVM) {
	@layout(vm.Page) {
		@breadcrumb(breadcrumbCrumb{Label: "Workflows", Href: "/workflows"}, breadcrumbCrumb{Label: "Workflow"})
		<h1>Workflow</h1>
		<p class="meta"><span class="mono">{ vm.ID }</span></p>
		if vm.NotFound {
			<div class="card mt14">
				<p class="meta">No workflow with this id.</p>
			</div>
		} else {
			<p class="meta">@chip(vm.StateClass(), string(vm.State))</p>
			<div class="card span2 mt14">
				<div class="kicker">Step ledger</div>
				<div class="tablewrap">
					<table>
						<thead>
							<tr>
								<th scope="col" class="right">Step</th>
								<th scope="col">Kind</th>
								<th scope="col">Status</th>
								<th scope="col">Job</th>
							</tr>
						</thead>
						<tbody>
							for _, st := range vm.Steps {
								<tr>
									<td class="right num">{ itoa(int64(st.StepNo)) }</td>
									<td class="mono">{ st.Kind }</td>
									<td>@chip(st.StatusClass(), string(st.Status))</td>
									<td>
										if st.JobID != nil {
											<a class="mono" href={ templ.SafeURL("/jobs/" + itoa64(*st.JobID)) }>#{ itoa64(*st.JobID) }</a>
										} else {
											<span class="meta">-</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	}
}
