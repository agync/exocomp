package web

// rulesList is the rules surface: the CEL expressions and actions that turn
// events into jobs, and the guardrails that bound them. Rules are
// CLI-managed — mutation stays on `exocomp rule add|enable|disable|rm` — so
// unlike sources/secrets/runners there are no write controls here at all, for
// any token. Each rule is a two-line row (SPEC §5.3): line one the CEL
// expression (one line, ellipsis — never wraps), line two `then` + the action
// + the 20px guard words (egress / cooldown / gate in wait-tint); LAST FIRED
// reads the rule_fire ledger; the explain glyph expands the full expression
// inline (a client-side <details>, no route).
templ rulesList(vm rulesVM) {
	@layout(vm.Page) {
		<div class="card span2 mt18 tray">
			<div class="kicker">Event → job</div>
			<h3>All rules</h3>
			<p class="meta">Read-only: rules stay CLI-managed — mutate with <code>exocomp rule add|enable|disable|rm</code>.</p>
			if len(vm.Rules) == 0 {
				<p class="meta">No rules registered — rules are written on the CLI.</p>
			} else {
				<div class="rules-list">
					<div class="rule-row tt-col">
						<span>RULE</span>
						<span>WHEN · THEN</span>
						<span>LAST FIRED</span>
						<span class="th-actions">ACTIONS</span>
					</div>
					for _, rl := range vm.Rules {
						<div class="rule-row">
							<div class="rule-id">
								<span class="mono">{ rl.Name }</span>
								@enabledChip(rl.Enabled, false)
							</div>
							<div class="when-then">
								<div class="expr">{ rl.Expr }</div>
								<div class="then">
									<span>then</span>
									<span class="mono">{ rl.Action }</span>
									if rl.HasGuards() {
										<span class="sep">·</span>
										if rl.Egress != "" {
											<span class="guard">{ rl.Egress }</span>
										}
										if rl.RunSecrets != "" {
											<span class="guard">{ rl.RunSecrets }</span>
										}
										if rl.Cooldown != "" {
											<span class="guard">{ rl.Cooldown }</span>
										}
										if rl.Gate != "" {
											<span class="guard guard--gate">{ rl.Gate }</span>
										}
									}
								</div>
							</div>
							<div class="fired">
								if rl.LastFireAt != nil {
									<span class="mono"><time datetime={ rl.LastFireAtISO() } data-time-format="clock">{ rl.LastFire }</time></span>
								} else {
									<span class="mono">{ rl.LastFire }</span>
								}
								if rl.FireFact != "" {
									<span class="mono">{ rl.FireFact }</span>
								}
							</div>
							<details class="rule-explain">
								<summary aria-label="Explain last evaluation" title="Explain last evaluation">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="7.5"></circle><path d="M12 9.5v4.5M12 6v1.8"></path></svg>
									<svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphChevron }></path></svg>
								</summary>
								<div class="expr-full mono">{ rl.Expr }</div>
							</details>
						</div>
					}
				</div>
			}
		</div>
	}
}
