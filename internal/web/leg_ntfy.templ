package web

// glyphSend is the test/send stroke glyph (SCREENS GLYPHS): the paper-plane
// send arrow. The ntfy leg's Test verb renders it.
const glyphSend = "M21 3L10 14M21 3l-7 18-4-7-7-4z"

// ntfyCard is the ntfy leg of the /system self-care page (SPEC §2, artboard
// 1c): the three-word judgment ON / REFUSED / OFF with the topic label as the
// figure, the sealed-key facts, and — on ON — the 3-row fan-out mini table.
// Sealed secrets render as presence only: the topic label is the one unsealed
// display string (notify.ntfy_topic); url and token never render a value.
templ ntfyCard(vm systemVM) {
	<section class="leg" id="ntfy" aria-label="ntfy" data-state={ ntfyRing(vm.Ntfy) }>
		<div class="leg-head">
			<span class="name">@legGlyph(glyphNtfy)<span>ntfy</span></span>
			<span class={ "chip", vm.Ntfy.ChipClass() }><span class="dot"></span>{ vm.Ntfy.Word() }</span>
			<span class="verbs">
				@ntfyCardVerbs(vm.Ntfy, vm.Page.Base, vm.Operator)
			</span>
		</div>
		<div class="leg-figure">
			if vm.Ntfy.State == NtfyStateOn || vm.Ntfy.State == NtfyStateRefused {
				if vm.Ntfy.TopicLabel != "" {
					<span class="value topic">{ vm.Ntfy.TopicLabel }</span>
					<span class="note">topic · { vm.Ntfy.ServerClass } server</span>
				} else {
					<span class="value">—</span>
				}
			} else {
				<span class="value dim">—</span>
				<span class="note">no channel · nothing sealed</span>
			}
		</div>
		<dl class="leg-facts">
			<dt>secrets</dt>
			<dd>
				if vm.Ntfy.State == NtfyStateRefused {
					url · topic <span class="nope">sealed</span> · token <span class="nope">missing</span>
				} else {
					url · topic · token <span class="nope">sealed</span> · <a href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/secrets")) }>rotate in Secrets</a>
				}
			</dd>
			if vm.Ntfy.State == NtfyStateOn {
				<dt>detail</dt>
				<dd>
					if vm.Ntfy.Detail == string(ntfyDetailTerse()) {
						terse · pushes name nothing
					} else {
						descriptive · pushes name the job and host
					}
				</dd>
			}
			if vm.Ntfy.State == NtfyStateRefused {
				<dt>why refused</dt>
				<dd>a public topic without a token would publish approval links to anyone who guesses the name</dd>
				<dt>pages</dt>
				<dd class="nope">nothing · approvals and failures are silent</dd>
			}
		</dl>
		if vm.Ntfy.State == NtfyStateOn {
			<div class="leg-mini" aria-label="Fan-out">
				<div class="on"><span>approvals</span><span class="wait">high</span><span>max on re-notify</span></div>
				<div><span>job failures</span><span>default</span><span>one page per job</span></div>
				<div><span>dead-man tripped</span><span class="wait">high</span><span>once</span></div>
			</div>
		}
		if vm.Ntfy.State == NtfyStateOff {
			<p class="leg-sentence">Approvals still expire and auto-reject on TTL; you will only learn about them from this UI. <code>exocomp setup notify</code> mints a topic, seals it and sends the first push.</p>
		}
	</section>
}

// ntfyRing is the leg's inset state ring: REFUSED wears the fail ring, ON and
// OFF none (SCREENS 1c).
func ntfyRing(n ntfyCardVM) string {
	if n.State == NtfyStateRefused {
		return "fail"
	}
	return ""
}

// ntfyCardVerbs is the card's header verbs: ON carries the Test glyph (a POST
// that sends one push and lands on the drawer with its status), an Edit verb
// opening the contextual setup/edit modal, and the ▾ into the drawer;
// REFUSED's primary is Edit opening the modal; OFF renders Edit if configured,
// otherwise Set up.
templ ntfyCardVerbs(n ntfyCardVM, base string, operator bool) {
	if n.State == NtfyStateOn {
		<form method="post" action={ templ.SafeURL(urlWithBase(base, "/system/ntfy/test")) } class="inline-form">
			<button type="submit" class="raglyph" aria-label="Test — send one push to this channel" title="Test — send one push to this channel">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphSend }></path></svg>
			</button>
		</form>
		if operator {
			<button type="button" class="btn quiet small" data-modal-open="ntfy-modal">Edit</button>
		}
		<a class="raglyph" href={ templ.SafeURL(urlWithBase(base, "/system/ntfy")) } aria-label="Push channel" title="Push channel">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphChevron }></path></svg>
		</a>
	} else if n.State == NtfyStateRefused {
		if operator {
			<button type="button" class="btn primary small" data-modal-open="ntfy-modal">Edit</button>
		}
	} else {
		if operator {
			if n.IsConfigured() {
				<button type="button" class="btn quiet small" data-modal-open="ntfy-modal">Edit</button>
			} else {
				<button type="button" class="btn quiet small" data-modal-open="ntfy-modal">Set up</button>
			}
		}
	}
}

// ntfyModal is the contextual modal for setting up or editing ntfy configuration.
templ ntfyModal(leg ntfyCardVM, form *ntfyModalVM, base string) {
	@modal("ntfy-modal", ntfyModalTitle(leg)) {
		<form method="post" action={ templ.SafeURL(urlWithBase(base, "/system/ntfy/configure")) } class="writeform" id="ntfy-configure-form" novalidate>
			@fieldInput(ntfyURLField(leg, form))
			@fieldInput(ntfyTopicField(leg, form))
			@fieldInput(ntfyTokenField(leg, form))
			@formStatus(false, ntfyModalErrForm(form), "Saving ntfy")
			<div class="actions">
				<button type="button" class="btn" data-modal-dismiss>Cancel</button>
				<button type="submit" class="btn primary">Save</button>
			</div>
		</form>
		if form != nil && form.HasError() {
			<script>
			exoModalOpen("ntfy-modal");
			var ntfyBad = document.querySelector('#ntfy-modal input[aria-invalid="true"]');
			if (ntfyBad) ntfyBad.focus();
			</script>
		}
	}
}

func ntfyModalTitle(n ntfyCardVM) string {
	if n.IsConfigured() {
		return "Configure ntfy"
	}
	return "Set up ntfy"
}

// ntfyDetailTerse names the terse position for the card's detail fact.
func ntfyDetailTerse() string {
	return "terse"
}
