package web

// ntfyCard is the ntfy leg of the /system self-care page (SPEC §2): a STUB
// this round with the §0.1 anatomy, id=ntfy. L-S2 fills it: ON/REFUSED/OFF,
// the drawer, and the Test verb.
templ ntfyCard(vm systemVM) {
	<section class="leg" id="ntfy" aria-label="ntfy">
		<div class="leg-head">
			<span class="name">@legGlyph(glyphNtfy)<span>ntfy</span></span>
			<span class="verbs"></span>
		</div>
		<div class="leg-figure"><span class="value dim">—</span></div>
		<dl class="leg-facts"></dl>
		<p class="leg-sentence"></p>
	</section>
}
