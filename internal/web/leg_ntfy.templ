package web

// glyphSend is the send stroke glyph (SCREENS GLYPHS): the paper-plane arrow.
// The modal's Send test verb renders it.
const glyphSend = "M21 3L10 14M21 3l-7 18-4-7-7-4z"

// ntfyCard is the ntfy leg of the /system self-care page (SPEC §2): the
// three-word judgment ON / REFUSED / OFF, the topic label as the figure, and the
// one Edit/Set up verb that opens the ntfy modal. The tile is deliberately lean
// — the configuration, the push-detail switch, the push preview and the test
// all live in the modal, so the card carries no facts block and no fan-out
// table. The URL and topic are ordinary settings, so the card never claims they
// are sealed.
templ ntfyCard(vm systemVM) {
	<section class="leg" id="ntfy" aria-label="ntfy" data-state={ ntfyRing(vm.Ntfy) }>
		<div class="leg-head">
			<span class="leg-id">
				<span class="name">@legGlyph(glyphNtfy)<span>ntfy</span></span>
				<span class={ "chip", vm.Ntfy.ChipClass() }><span class="dot"></span>{ vm.Ntfy.Word() }</span>
			</span>
			<span class="verbs">
				@ntfyCardVerbs(vm.Ntfy, vm.Operator)
			</span>
		</div>
		<div class="leg-figure">
			if vm.Ntfy.State == NtfyStateOn || vm.Ntfy.State == NtfyStateRefused {
				if vm.Ntfy.TopicLabel != "" {
					<span class="value topic">{ vm.Ntfy.TopicLabel }</span>
					<span class="note">topic · { vm.Ntfy.ServerClass } server</span>
				} else {
					<span class="value">—</span>
				}
			} else {
				<span class="value dim">—</span>
				<span class="note">no channel · nothing set</span>
			}
		</div>
		if vm.Ntfy.State == NtfyStateRefused {
			<p class="leg-sentence">A public topic without a token would publish approval links to anyone who guesses the name — add an access token, or self-host ntfy.</p>
		}
		if vm.Ntfy.State == NtfyStateOff {
			<p class="leg-sentence">Approvals still expire and auto-reject on TTL; you will only learn about them from this UI. <code>exocomp setup notify</code> mints a topic and sends the first push.</p>
		}
	</section>
}

// ntfyRing is the leg's inset state ring: REFUSED wears the fail ring, ON and
// OFF none (SCREENS 1c).
func ntfyRing(n ntfyCardVM) string {
	if n.State == NtfyStateRefused {
		return "fail"
	}
	return ""
}

// ntfyCardVerbs is the card's header verb: Edit (or Set up when nothing is
// configured), opening the one ntfy modal where the whole channel is edited.
// A refused channel's verb is the same quiet Edit — the chip and the ring carry
// the refusal, not the button.
templ ntfyCardVerbs(n ntfyCardVM, operator bool) {
	if operator {
		if n.IsConfigured() {
			<button type="button" class="btn quiet small" data-modal-open="ntfy-modal">Edit</button>
		} else {
			<button type="button" class="btn quiet small" data-modal-open="ntfy-modal">Set up</button>
		}
	}
}

// ntfyModal is the one ntfy surface: the server URL and topic (ordinary
// settings, prefilled), the optional access token (sealed, blank to keep), the
// push-detail switch with its live preview, and the Send test / Save verbs with
// the test-status box. Send test saves the form and posts one push through the
// daemon seam; Save persists and returns to /system. The refusal form (a 422
// re-render) and the test status both re-open the dialog.
templ ntfyModal(leg ntfyCardVM, form *ntfyModalVM, base string, test ntfyTestStatus) {
	@modal("ntfy-modal", ntfyModalTitle(leg)) {
		<form method="post" action={ templ.SafeURL(urlWithBase(base, "/system/ntfy/configure")) } class="writeform" id="ntfy-configure-form" novalidate>
			@fieldInput(ntfyURLField(leg, form))
			@fieldInput(ntfyTopicField(leg, form))
			@fieldInput(ntfyTokenField(leg, form))
			<div class="field">
				<span class="label">Push detail</span>
				<span class="field-seg" data-ntfy-detail>
					<input type="radio" id="ntfy-detail-full" name="detail" value="full" checked?={ leg.Detail != "summary" && leg.Detail != "terse" }/>
					<label for="ntfy-detail-full">full</label>
					<input type="radio" id="ntfy-detail-summary" name="detail" value="summary" checked?={ leg.Detail == "summary" }/>
					<label for="ntfy-detail-summary">summary</label>
					<input type="radio" id="ntfy-detail-terse" name="detail" value="terse" checked?={ leg.Detail == "terse" }/>
					<label for="ntfy-detail-terse">terse</label>
				</span>
				<span class="meta">full names the workspace, host and error, with Approve/Reject · summary hides the detail and the buttons · terse names nothing</span>
			</div>
			<div class="push-preview" role="group" aria-label="What a push says">
				<div class="kicker">WHAT A PUSH SAYS</div>
				<div class="sample" data-detail="full" hidden?={ leg.Detail != "full" }>
					<div class="push-sample">
						<p class="title">1 approval waiting</p>
						<p class="body">apply prod-net · expires in 29m, then auto-rejects</p>
						<p class="push-actions" aria-hidden="true">
							<span class="btn quiet small">Approve</span>
							<span class="btn quiet small">Reject</span>
						</p>
					</div>
				</div>
				<div class="sample" data-detail="summary" hidden?={ leg.Detail != "summary" }>
					<div class="push-sample">
						<p class="title">exocomp</p>
						<p class="body">an approval is waiting — open to decide</p>
						<p class="push-actions" aria-hidden="true"><span class="note">no action buttons in summary or terse</span></p>
					</div>
				</div>
				<div class="sample" data-detail="terse" hidden?={ leg.Detail != "terse" }>
					<div class="push-sample">
						<p class="title">exocomp</p>
						<p class="body">exocomp: action required</p>
						<p class="push-actions" aria-hidden="true"><span class="note">no action buttons in summary or terse</span></p>
					</div>
				</div>
			</div>
			@formStatus(false, ntfyModalErrForm(form), "Saving ntfy")
			<div class="actions">
				<button type="button" class="btn" data-modal-dismiss>Cancel</button>
				<button type="submit" class="btn quiet ntfy-test-btn" formaction={ urlWithBase(base, "/system/ntfy/test") } title="saves the configuration, then sends one push">@legGlyph(glyphSend) Send test</button>
				<button type="submit" class="btn primary">Save</button>
			</div>
		</form>
		@ntfyStatus(test)
		@ntfyModalJS()
	}
}

func ntfyModalTitle(n ntfyCardVM) string {
	if n.IsConfigured() {
		return "Configure ntfy"
	}
	return "Set up ntfy"
}

// ntfyStatus is the modal's test-status box: the ok line, the failure sentence,
// or the resting hint that names what Send test does. It is one box for the
// whole channel so a failed push is debuggable from the modal.
templ ntfyStatus(st ntfyTestStatus) {
	<div class={ "test-box", templ.KV("is-ok", st.Class == "ok"), templ.KV("is-error", st.Class == "fail") } role="status" aria-live="polite">
		if st.Class == "ok" {
			<span class="msg">✓ { st.Msg }</span>
		} else if st.Class == "fail" {
			<span class="msg">{ st.Msg }</span>
		} else {
			<span class="hint">no test yet · Send test saves the configuration, then sends one push</span>
		}
	</div>
}

// ntfyModalJS swaps the push preview to match the detail radio, and re-opens the
// dialog when a refusal or a test status landed on the page.
templ ntfyModalJS() {
	<script>
	(function () {
		var seg = document.querySelector(".field-seg[data-ntfy-detail]");
		if (seg) {
			seg.addEventListener("change", function () {
				var picked = seg.querySelector("input:checked");
				if (!picked) return;
				var samples = document.querySelectorAll("#ntfy-modal .push-preview .sample");
				for (var i = 0; i < samples.length; i++) {
					samples[i].hidden = samples[i].getAttribute("data-detail") !== picked.value;
				}
			});
		}
		if (document.querySelector("#ntfy-modal .is-error, #ntfy-modal .is-ok, #ntfy-modal input[aria-invalid=\"true\"]")) {
			exoModalOpen("ntfy-modal");
			var bad = document.querySelector('#ntfy-modal input[aria-invalid="true"]');
			if (bad) bad.focus();
		}
	})();
	</script>
}
