package web

// dashboard is the glance screen: an at-a-glance grid of summary cards, not
// embedded tables. Each card is itself the link to its full view — the
// dashboard answers "what needs my attention?" first (pending approvals lead
// the grid) and "what's the state of everything else?" second, in one line
// per card. The queue card counts the active queue only; settled job history
// lives at /jobs, never here. Healthy is quiet; waiting-on-human and drifted
// are loud, using the same wait/amber signal the chip ladder already uses.
// Control-plane health and backup freshness live on /system, not here.
templ dashboard(vm dashboardVM) {
	@layout(vm.Page) {
		if vm.Page.Insecure {
			<div class="banner fail" role="alert">
				<span class="keyword">INSECURE HTTP</span>
				<span>This surface is served over cleartext. Tokens on the wire are readable by anyone on the network.</span>
			</div>
		}
		if vm.Banner.Active() {
			<div class={ "banner", templ.KV("fail", vm.Banner.Paused) } role="alert">
				<span class="keyword">{ vm.Banner.Keyword() }</span>
				<span>{ vm.Banner.Message() }</span>
				<span class="count">{ swallowedText(vm.Banner) }</span>
			</div>
		}
		<h1>Dashboard</h1>
		<div class="cards mt18">
			@approvalsCard(vm.Approvals)
			@jobsCard(vm.Jobs)
			@workspacesCard(vm.Workspaces)
			@sourcesCard(vm.Sources)
			@checksCard(vm.Checks)
			@schedulesCard(vm.Schedules)
			if vm.Workflows.InFlight > 0 {
				@workflowsCard(vm.Workflows)
			}
		</div>
	}
}

templ chip(class, label string) {
	<span class={ "chip", class }><span class="dot"></span>{ label }</span>
}

// approvalsCard is the dashboard's pending-approvals summary: the whole card
// is the link to /approvals. A pending count above zero is the primary
// attention item on the glance screen — the card carries the wait/amber
// accent and the soonest item's one-line subline; zero is calm.
templ approvalsCard(vm approvalSummary) {
	<a class={ "card", "cardlink", templ.KV("attn", vm.Pending > 0) } href="/approvals" aria-labelledby="needsyou-h">
		<h3 id="needsyou-h">Pending approvals</h3>
		if vm.Pending > 0 {
			<div class="cardnum warn">{ itoa(int64(vm.Pending)) }</div>
			<p class="cardlabel">waiting on you</p>
			<p class="cardsub warn">{ vm.Subline() }</p>
		} else {
			<p class="cardsub meta">None waiting.</p>
		}
	</a>
}

// jobsCard is the dashboard's queue summary: the active queue only. Settled
// jobs never appear here — that history is /jobs' job, not the glance
// screen's.
templ jobsCard(vm jobSummary) {
	<a class="card cardlink" href="/jobs" aria-labelledby="queue-h">
		<h3 id="queue-h">Queue</h3>
		if vm.Idle() {
			<p class="cardsub meta">Idle.</p>
		} else {
			<div class="cardnum">{ vm.Headline() }</div>
		}
		if vm.FailedRecently > 0 {
			<p class="cardsub fail">{ itoa(int64(vm.FailedRecently)) } failed recently</p>
		}
	</a>
}

// workspacesCard is the dashboard's workspace summary: the managed total,
// with any drift called out in the attention accent — drift is the signal an
// operator scans for here.
templ workspacesCard(vm workspaceSummary) {
	<a class={ "card", "cardlink", templ.KV("attn", vm.Drifted > 0) } href="/workspaces" aria-labelledby="ws-h">
		<h3 id="ws-h">Workspaces</h3>
		if vm.Total == 0 {
			<p class="cardsub meta">No workspaces registered.</p>
		} else {
			<div class="cardnum">{ itoa(int64(vm.Total)) }</div>
			<p class="cardlabel">workspaces</p>
			if vm.Drifted > 0 {
				<p class="cardsub warn">{ itoa(int64(vm.Drifted)) } drifted</p>
			} else {
				<p class="cardsub meta">All in sync.</p>
			}
		}
	</a>
}

// sourcesCard is the dashboard's source summary: the registered total, with
// any needing attention (never synced, or disabled) called out.
templ sourcesCard(vm sourceSummary) {
	<a class={ "card", "cardlink", templ.KV("attn", vm.Attention > 0) } href="/sources" aria-labelledby="sources-h">
		<h3 id="sources-h">Sources</h3>
		if vm.Total == 0 {
			<p class="cardsub meta">No sources registered.</p>
		} else {
			<div class="cardnum">{ itoa(int64(vm.Total)) }</div>
			<p class="cardlabel">sources</p>
			if vm.Attention > 0 {
				<p class="cardsub warn">{ itoa(int64(vm.Attention)) } need attention</p>
			} else {
				<p class="cardsub meta">All synced.</p>
			}
		}
	</a>
}

// checksCard is the dashboard's probe-estate summary: the registered total,
// the targets currently observed up, and — the attention signal — any disabled
// checks. DOWN is normal for an away/roaming host, so it is never the accent;
// a disabled check is (mirrors sourcesCard).
templ checksCard(vm checksSummary) {
	<a class={ "card", "cardlink", templ.KV("attn", vm.Disabled > 0) } href="/checks" aria-labelledby="checks-h">
		<h3 id="checks-h">Checks</h3>
		if vm.Total == 0 {
			<p class="cardsub meta">No checks registered.</p>
		} else {
			<div class="cardnum">{ itoa(int64(vm.Total)) }</div>
			<p class="cardlabel">checks</p>
			if vm.Disabled > 0 {
				<p class="cardsub warn">{ itoa(int64(vm.Disabled)) } disabled</p>
			}
			<p class="cardsub">{ itoa(int64(vm.TargetsUp)) } targets up</p>
		}
	</a>
}

// workflowsCard is the dashboard's in-flight-workflow summary. The dashboard
// renders it only when InFlight is above zero — an empty card that is usually
// empty is noise, not signal, so a quiet estate hides it entirely rather than
// showing a permanent "None".
templ workflowsCard(vm workflowSummary) {
	<a class="card cardlink" href="/workflows" aria-labelledby="flows-h">
		<h3 id="flows-h">Workflows in flight</h3>
		<div class="cardnum">{ itoa(int64(vm.InFlight)) }</div>
		<p class="cardlabel">in flight</p>
	</a>
}

// schedulesCard is the dashboard's schedule summary: the registered total with
// the "N schedules · M disabled" tally, and the attention accent exactly when
// a schedule is disabled — a disabled schedule has silently stopped firing,
// the one signal an operator scans for (mirrors sourcesCard).
templ schedulesCard(vm scheduleSummary) {
	<a class={ "card", "cardlink", templ.KV("attn", vm.Disabled > 0) } href="/schedules" aria-labelledby="sched-h">
		<h3 id="sched-h">Schedules</h3>
		if vm.Total == 0 {
			<p class="cardsub meta">No schedules registered.</p>
		} else {
			<div class="cardnum">{ itoa(int64(vm.Total)) }</div>
			<p class="cardlabel">schedules</p>
			<p class={ "cardsub", templ.KV("warn", vm.Disabled > 0) }>{ itoa(int64(vm.Total)) } schedules · { itoa(int64(vm.Disabled)) } disabled</p>
		}
	</a>
}
