package web

// dashboard is the glance screen. It answers "is everything OK?" without
// scrolling: banner state, what needs a human, the queue, backup freshness,
// and workspace drift. Healthy is quiet; waiting-on-human and stale are loud.
templ dashboard(vm dashboardVM) {
	@layout(vm.Page) {
		if vm.Page.Insecure {
			<div class="banner fail" role="alert">
				<span class="keyword">INSECURE HTTP</span>
				<span>This surface is served over cleartext. Tokens on the wire are readable by anyone on the network.</span>
			</div>
		}
		if vm.Banner.Active() {
			<div class={ "banner", templ.KV("fail", vm.Banner.Paused) } role="alert">
				<span class="keyword">{ vm.Banner.Keyword() }</span>
				<span>{ vm.Banner.Message() }</span>
				<span class="count">{ swallowedText(vm.Banner) }</span>
			</div>
		}
		<h1>Dashboard</h1>
		<div class="cards" style="margin-top:18px">
			<section class="card span2" aria-labelledby="needsyou-h">
				<h3 id="needsyou-h">Pending approvals</h3>
				if len(vm.NeedsYou) == 0 {
					<p class="meta">Nothing is waiting on a decision.</p>
				} else {
					<div class="tablewrap stackable">
						<table>
							<thead>
								<tr><th scope="col">Approval</th><th scope="col">Runbook</th><th scope="col">Workspace</th><th scope="col" class="right">Time left</th><th scope="col"></th></tr>
							</thead>
							<tbody>
								for _, a := range vm.NeedsYou {
									<tr>
										<td class="num" data-label="Approval">#{ itoa(a.ID) }</td>
										<td data-label="Runbook">{ a.Runbook }</td>
										<td data-label="Workspace">{ orDash(a.Workspace) }</td>
										<td class="right" data-label="Time left">
											if a.Expiring {
												<span class="chip wait"><span class="dot"></span>{ a.Deadline }</span>
											} else {
												<span class="num">{ a.Deadline }</span>
											}
										</td>
										<td class="right" data-label=""><a class="btn" href={ templ.SafeURL("/approvals/" + itoa(a.ID)) }>Review</a></td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>

			<section class="card" aria-labelledby="queue-h">
				<h3 id="queue-h">Queue</h3>
				if len(vm.Queue) == 0 {
					<p class="meta">The queue is empty.</p>
				} else {
					<div class="tablewrap stackable">
						<table>
							<thead>
								<tr><th scope="col">Job</th><th scope="col">Runbook</th><th scope="col">State</th><th scope="col" class="right">Age</th></tr>
							</thead>
							<tbody>
								for _, j := range vm.Queue {
									<tr>
										<td class="num" data-label="Job"><a href={ templ.SafeURL("/jobs/" + itoa(j.ID)) }>#{ itoa(j.ID) }</a></td>
										<td data-label="Runbook">{ j.Runbook }</td>
										<td data-label="State">@chip(j.StateClass(), string(j.State))</td>
										<td class="right num" data-label="Age">{ j.Age }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>

			<section class="card" aria-labelledby="backups-h">
				<h3 id="backups-h">Backups</h3>
				if len(vm.Backups) == 0 {
					<p class="meta">No backup targets configured.</p>
				} else {
					<div class="tablewrap">
						<table>
							<thead>
								<tr><th scope="col">Target</th><th scope="col">Snapshot</th><th scope="col" class="right">Age</th></tr>
							</thead>
							<tbody>
								for _, b := range vm.Backups {
									<tr>
										<td>
											{ b.Name }
											if b.Drill {
												<span class="chip dim" style="margin-left:6px">drill</span>
											}
										</td>
										<td class="mono">{ orDash(b.Snapshot) }</td>
										<td class="right">@chip(b.Freshness, b.Age)</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>

			<section class="card span2" aria-labelledby="ws-h">
				<div class="kicker">Workspaces</div>
				<h3 id="ws-h">OpenTofu drift</h3>
				if len(vm.Workspaces) == 0 {
					<p class="meta">No workspaces registered.</p>
				} else {
					<div class="tablewrap stackable">
						<table>
							<thead>
								<tr><th scope="col">Workspace</th><th scope="col" class="right">Serial</th><th scope="col">State</th><th scope="col">Last move</th></tr>
							</thead>
							<tbody>
								for _, w := range vm.Workspaces {
									<tr>
										<td data-label="Workspace">{ w.Name }</td>
										<td class="right num" data-label="Serial">{ itoa64(w.Serial) }</td>
										<td data-label="State">
											if w.Drift {
												<span class="chip wait"><span class="dot"></span>DRIFT</span>
											} else {
												<span class="chip ok"><span class="dot"></span>IN SYNC</span>
											}
										</td>
										<td class="meta" data-label="Last move">{ orDash(w.LastJob) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>

			<section class="card span2" aria-labelledby="flows-h">
				<h3 id="flows-h">Workflows in flight</h3>
				if len(vm.Workflows) == 0 {
					<p class="meta">No workflows are running.</p>
				} else {
					<div class="tablewrap">
						<table>
							<thead>
								<tr><th scope="col">Workflow</th><th scope="col">State</th><th scope="col" class="right">Steps</th><th scope="col">Ledger</th></tr>
							</thead>
							<tbody>
								for _, f := range vm.Workflows {
									<tr>
										<td class="mono"><a href={ templ.SafeURL("/workflows/" + f.ID) }>{ f.ID }</a></td>
										<td>@chip(f.StateClass(), string(f.State))</td>
										<td class="right num">{ f.Progress() }</td>
										<td>@stepDots(f.Steps)</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>

			<section class="card" aria-labelledby="sources-h">
				<h3 id="sources-h">Sources</h3>
				if len(vm.Sources) == 0 {
					<p class="meta">No sources registered.</p>
				} else {
					<div class="tablewrap stackable">
						<table>
							<thead>
								<tr><th scope="col">Source</th><th scope="col">Kind</th><th scope="col">Signed</th><th scope="col" class="right">Sync</th></tr>
							</thead>
							<tbody>
								for _, sc := range vm.Sources {
									<tr>
										<td data-label="Source">
											{ sc.Name }
											if !sc.Enabled {
												<span class="chip dim" style="margin-left:6px">disabled</span>
											}
										</td>
										<td class="mono" data-label="Kind">{ sc.Kind }</td>
										<td data-label="Signed">@signedChip(sc)</td>
										<td class="right mono" data-label="Sync">{ orDash(sc.Short()) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				<p class="meta" style="margin-top:10px"><a href="/sources">All sources →</a></p>
			</section>

			<section class="card" aria-labelledby="sched-h">
				<h3 id="sched-h">Schedules</h3>
				if len(vm.Schedules) == 0 {
					<p class="meta">No schedules registered.</p>
				} else {
					<div class="tablewrap stackable">
						<table>
							<thead>
								<tr><th scope="col">Schedule</th><th scope="col">Cron</th><th scope="col">Last</th></tr>
							</thead>
							<tbody>
								for _, sc := range vm.Schedules {
									<tr>
										<td data-label="Schedule">
											{ sc.Name }
											if !sc.Enabled {
												<span class="chip dim" style="margin-left:6px">disabled</span>
											}
										</td>
										<td class="mono" data-label="Cron">{ sc.Cron }</td>
										<td data-label="Last">
											if sc.HasLast {
												@chip(sc.LastClass(), string(sc.LastState))
											} else {
												<span class="meta">never fired</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				<p class="meta" style="margin-top:10px"><a href="/schedules">All schedules →</a></p>
			</section>

			<section class="card span2" aria-labelledby="self-h">
				<h3 id="self-h">This control plane</h3>
				<div class="tablewrap">
					<table>
						<thead>
							<tr><th scope="col">Signal</th><th scope="col">State</th><th scope="col">Detail</th></tr>
						</thead>
						<tbody>
							<tr>
								<td>Running version</td>
								<td class="mono">{ vm.Self.Version }</td>
								<td class="meta">the binary an upgrade replaces</td>
							</tr>
							<tr>
								<td>Litestream RPO</td>
								<td>@chip(vm.Self.LSClass, vm.Self.LSAge)</td>
								<td class="meta">{ vm.Self.LSDetail }</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>
		</div>
	}
}

templ chip(class, label string) {
	<span class={ "chip", class }><span class="dot"></span>{ label }</span>
}
