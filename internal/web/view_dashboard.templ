package web

// dashboard is the glance screen, ranked (F6): an attention band first (only
// the non-nominal cards, each ringed with its state border and ending in the
// decision that resolves it), then the queue, then quiet counts whose empty
// states name the verb that changes them. Healthy is quiet — a nominal system
// renders one attention band of nothing. Control-plane health and backup
// freshness live on /system, not here.
templ dashboard(vm dashboardVM) {
	@layout(vm.Page) {
		if vm.Page.Insecure {
			<div class="banner fail" role="alert">
				<span class="keyword">INSECURE HTTP</span>
				<span>This page is not secure. Anyone on this network could read your sign-in.</span>
			</div>
		}
		if vm.Banner.Active() {
			<div class={ "banner", templ.KV("fail", vm.Banner.Paused) } role="alert">
				<span class="keyword">{ vm.Banner.Keyword() }</span>
				<span>{ vm.Banner.Message() }</span>
				<span class="count">{ swallowedText(vm.Banner) }</span>
			</div>
		}
		if vm.Approvals.Pending > 0 || vm.Workspaces.Drifted > 0 || vm.Sources.Attention > 0 || vm.Checks.Disabled > 0 || vm.Checks.TargetsDown > 0 || vm.Schedules.Disabled > 0 || vm.Workflows.InFlight > 0 {
			<section class="band" aria-label="Needs attention">
				<div class="band-kicker">Needs attention</div>
				<div class="attn-grid">
					if vm.Approvals.Pending > 0 {
						@approvalsCard(vm.Approvals)
					}
					if vm.Workspaces.Drifted > 0 {
						@workspacesCard(vm.Workspaces)
					}
					if vm.Sources.Attention > 0 {
						@sourcesCard(vm.Sources)
					}
					if vm.Checks.TargetsDown > 0 || vm.Checks.Disabled > 0 {
						@checksCard(vm.Checks)
					}
					if vm.Schedules.Disabled > 0 {
						@schedulesCard(vm.Schedules)
					}
					if vm.Workflows.InFlight > 0 {
						@workflowsCard(vm.Workflows)
					}
				</div>
			</section>
		}
		<section class="band" aria-label="Queue">
			<div class="band-kicker">Queue</div>
			@queueCard(vm.Jobs)
		</section>
		<section class="band" aria-label="Counts">
			<div class="band-kicker">Counts</div>
			<div class="counts-grid">
				@countCard("Approvals", vm.Approvals.Pending, "/approvals", "None waiting.")
				@countCard("Workspaces", vm.Workspaces.Total, "/workspaces", "exocomp ws add")
				@countCard("Schedules", vm.Schedules.Total, "/schedules", "exocomp schedule add")
				@countCard("Rules", vm.Rules, "/rules", "Nothing fires until a rule matches — written on the CLI.")
			</div>
		</section>
	}
}

templ chip(class, label string) {
	<span class={ "chip", class }><span class="dot"></span>{ label }</span>
}

// approvalsCard is the dashboard's pending-approvals summary: the whole card
// is the link to /approvals. A pending count above zero is the primary
// attention item on the glance screen — the card carries the wait/amber
// accent and the soonest item's one-line subline; zero is calm.
templ approvalsCard(vm approvalSummary) {
	<a class="card cardlink attn" href="/approvals" aria-labelledby="needsyou-chip">
		<span class="chip wait" id="needsyou-chip"><span class="dot"></span>{ itoa(int64(vm.Pending)) } PENDING</span>
		<p class="cardsub">{ vm.Subline() }</p>
		<span class="cardact">Open approvals →</span>
	</a>
}

// queueCard is the dashboard's queue summary: the active queue as capped
// two-line rows in the /jobs language — each row its own link to its job, so
// the card cannot be one big anchor — with the running/queued split as the
// meta line, the one settled-history fact the glance queries (the newest
// finished job as a state chip beside its runbook), and the Open all jobs
// footer. Anything older stays on /jobs.
templ queueCard(vm jobSummary) {
	<div class="card queue">
		<h3>Queue</h3>
		if vm.Idle() {
			<p class="cardsub meta">Idle — nothing queued, nothing running.</p>
		} else {
			<p class="cardsub meta">{ vm.Headline() }</p>
			for _, j := range vm.Rows {
				@queueJobRow(j)
			}
		}
		if vm.FailedRecently > 0 {
			<p class="cardsub fail">{ itoa(int64(vm.FailedRecently)) } failed recently</p>
		}
		if vm.LastJob != nil {
			<p class="cardsub">
				@chip(lastJobClass(vm.LastJob.State), lastJobWord(vm.LastJob.State))
				<span>{ RunbookLabel(vm.LastJob.Runbook) }</span>
			</p>
		}
		<a class="cardact" href="/jobs">Open all jobs →</a>
	</div>
}

// queueJobRow is one active job on the dashboard queue card: the /jobs
// two-line row reduced to its glance essentials — runbook over source/meta
// with a state chip — linked through to the job. Active rows carry no reason
// line (D4 names facts only for settled FAILED/DEGRADED runs).
templ queueJobRow(j jobRow) {
	<a class="jobs-row queue-row" href={ templ.SafeURL("/jobs/" + itoa64(j.ID)) }>
		<span class="cell">
			<b class="mono">{ j.Title }</b>
			<small class="mono">{ j.SourceMeta }</small>
		</span>
		<span class="cell cell--state">
			@chip(j.StateClass(), string(j.State))
		</span>
	</a>
}

// workspacesCard is the dashboard's workspace summary: the managed total,
// with any drift called out in the attention accent — drift is the signal an
// operator scans for here.
templ workspacesCard(vm workspaceSummary) {
	<a class="card cardlink attn" href="/workspaces" aria-labelledby="ws-chip">
		<span class="chip wait" id="ws-chip"><span class="dot"></span>{ itoa(int64(vm.Drifted)) } DRIFTED</span>
		<p class="cardsub">{ itoa(int64(vm.Drifted)) } workspaces out of sync — a plan or check moved the state.</p>
		<span class="cardact">Open workspaces →</span>
	</a>
}

// sourcesCard is the dashboard's source summary: the registered total, with
// any needing attention (never synced, or disabled) called out.
templ sourcesCard(vm sourceSummary) {
	<a class="card cardlink attn" href="/sources" aria-labelledby="sources-chip">
		if vm.NeverSynced > 0 {
			<span class="chip wait" id="sources-chip"><span class="dot"></span>{ itoa(int64(vm.NeverSynced)) } NEVER SYNCED</span>
			<p class="cardsub">{ vm.NeverSentence() }</p>
		} else {
			<span class="chip wait" id="sources-chip"><span class="dot"></span>{ itoa(int64(vm.Attention)) } NEEDS LOOK</span>
			<p class="cardsub">A source is disabled or unsigned — nothing runs from it until it is fixed.</p>
		}
		<span class="cardact">Review sources →</span>
	</a>
}

// checksCard is the dashboard's probe-estate summary: the registered total,
// the targets currently observed up, and — the attention signal — any disabled
// checks. DOWN is normal for an away/roaming host, so it is never the accent;
// a disabled check is (mirrors sourcesCard).
templ checksCard(vm checksSummary) {
	<a class="card cardlink attn" href="/checks" aria-labelledby="checks-chip">
		if vm.TargetsDown > 0 {
			<span class="chip fail" id="checks-chip"><span class="dot"></span>{ itoa(int64(vm.TargetsDown)) } DOWN</span>
			<p class="cardsub">{ itoa(int64(vm.TargetsDown)) } of { itoa(int64(vm.TargetsTotal)) } targets down — reachability is the fact the sweep last observed.</p>
		} else {
			<span class="chip wait" id="checks-chip"><span class="dot"></span>{ itoa(int64(vm.Disabled)) } DISABLED</span>
			<p class="cardsub">A check is disabled and no longer probed.</p>
		}
		<span class="cardact">Open checks →</span>
	</a>
}

// workflowsCard is the dashboard's in-flight-workflow summary. The dashboard
// renders it only when InFlight is above zero — an empty card that is usually
// empty is noise, not signal, so a quiet estate hides it entirely rather than
// showing a permanent "None".
templ workflowsCard(vm workflowSummary) {
	<a class="card cardlink attn" href="/workflows" aria-labelledby="flows-chip">
		<span class="chip wait" id="flows-chip"><span class="dot"></span>{ itoa(int64(vm.InFlight)) } IN FLIGHT</span>
		<p class="cardsub">A provision → converge chain is partway through its steps.</p>
		<span class="cardact">Open workflows →</span>
	</a>
}

// schedulesCard is the dashboard's schedule summary: the registered total with
// the "N schedules · M disabled" tally, and the attention accent exactly when
// a schedule is disabled — a disabled schedule has silently stopped firing,
// the one signal an operator scans for (mirrors sourcesCard).
templ schedulesCard(vm scheduleSummary) {
	<a class="card cardlink attn" href="/schedules" aria-labelledby="sched-chip">
		<span class="chip wait" id="sched-chip"><span class="dot"></span>{ itoa(int64(vm.Disabled)) } DISABLED</span>
		<p class="cardsub">A schedule is disabled and no longer fires.</p>
		<span class="cardact">Open schedules →</span>
	</a>
}

// countCard is a quiet count in the dashboard's COUNTS band: a kicker, the
// number, and — only when zero — the verb that changes it (F6). The whole card
// is the link to its full view.
templ countCard(kicker string, n int, href, empty string) {
	<a class="card cardlink count" href={ templ.SafeURL(href) }>
		<div class="count-kicker">{ kicker }</div>
		<div class="countnum">{ itoa(int64(n)) }</div>
		if n == 0 {
			<p class="cardsub meta">{ empty }</p>
		}
	</a>
}
