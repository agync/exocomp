package web

// signedChip states a source's trust posture: a signed source pinned to its own
// allowed-signers is the strong form, signed-only is a step down, unsigned is a
// dim neutral — never color-only, always a label. Shared by the sources surface
// and the dashboard's sources card.
templ signedChip(sc sourceRow) {
	if sc.Signed && sc.Signers {
		<span class="chip ok"><span class="dot"></span>SIGNED · SIGNERS</span>
	} else if sc.Signed {
		<span class="chip ok"><span class="dot"></span>SIGNED</span>
	} else {
		<span class="chip dim"><span class="dot"></span>UNSIGNED</span>
	}
}

// sourcesList is the run-tree sources surface (Decision 0010): where every run's
// tree comes from, its trust posture (signed / allowed-signers), and the commit
// its last sync landed on. An operator gets add/enable/disable/rm controls
// (sources_write.go); a signed/allowed-signers posture and `source sync` stay
// CLI-only (the latter has no queued job kind yet — see sources_write.go).
templ sourcesList(vm sourcesVM) {
	@layout(vm.Page) {
		if vm.Operator {
			@modal("sources-add", "Add a source") {
				<p class="meta">
					A path is read directly (writable is opt-in); a git URL is cloned and
					pinned to a ref via a generated deploy key sealed into the envelope.
				</p>
				<form method="post" action={ urlWithBase(vm.Page.Base, "/sources/add") } class="writeform" id="src-add-form" novalidate data-src-form>
					@fieldInput(vm.Form.nameField())
					@fieldInput(vm.Form.locationField())
					<p class="meta" id="src-hint"></p>
					<div id="src-path-fields">
						<label class="checkline"><input type="checkbox" name="writable" id="src-writable"/> writable (default is read-only)</label>
					</div>
					<div id="src-git-fields" hidden>
						<label for="src-ref">Ref</label>
						<input id="src-ref" name="ref" type="text" autocomplete="off" placeholder="main" value={ vm.Form.effective().Ref }/>
						if !vm.SealAvailable {
							<p class="meta">Sealing is not available on this surface (this process holds no envelope).</p>
						} else {
							<p class="meta">
								A deploy key is generated and sealed into the envelope; its public
								half is shown once — add it to the forge as a read-only key, then
								sync with <code>exocomp source sync</code>.
							</p>
							<button type="button" class="btn" id="src-confirm-open">Add access token to confirm</button>
							<div id="src-confirm-panel" hidden>
								<label for="src-cf">Confirm: your access token</label>
								<input id="src-cf" name="confirm_token" type="password" autocomplete="off"/>
							</div>
						}
					</div>
					@formStatus(vm.Form.Pending(), vm.Form.ErrFormText())
					<div class="actions"><button type="submit" class="btn primary" disabled?={ vm.Form.Pending() }>Add source</button></div>
				</form>
				if vm.Form != nil {
					<script>
					exoModalOpen("sources-add");
					var srcBad = document.querySelector('#sources-add input[aria-invalid="true"]');
					if (srcBad) srcBad.focus();
					</script>
				}
				@sourceFormJS()
				<script>
				(function () {
					var loc = document.getElementById("src-location");
					var hint = document.getElementById("src-hint");
					var pathFields = document.getElementById("src-path-fields");
					var gitFields = document.getElementById("src-git-fields");
					var confirmOpen = document.getElementById("src-confirm-open");
					var confirmPanel = document.getElementById("src-confirm-panel");
					if (!loc || !hint || !pathFields || !gitFields) return;

					// Mirrors source.LooksLikeGitURL loosely: an explicit scheme, or
					// scp-like [user@]host:path. Progressive disclosure only — the
					// server re-derives this from the same field and is authoritative.
					function looksLikeGitURL(raw) {
						var u = (raw || "").trim();
						if (u === "") return false;
						if (/^(https?|ssh|git|ftps?):\/\//i.test(u)) return true;
						var colon = u.indexOf(":");
						if (colon < 0) return false;
						var slash = u.indexOf("/");
						if (slash >= 0 && slash < colon) return false;
						var host = u.slice(0, colon);
						var at = host.lastIndexOf("@");
						if (at >= 0) return true;
						return host.length > 1 && (host.indexOf(".") >= 0 || host === "localhost");
					}

					function refresh() {
						var isGit = looksLikeGitURL(loc.value);
						pathFields.hidden = isGit;
						gitFields.hidden = !isGit;
						hint.textContent = loc.value.trim() === "" ? "" : (isGit ? "→ git source (a deploy key will be generated)" : "→ path source");
					}
					loc.addEventListener("input", refresh);
					refresh();

					if (confirmOpen && confirmPanel) {
						confirmOpen.addEventListener("click", function () {
							confirmPanel.hidden = false;
							confirmOpen.hidden = true;
							var cf = document.getElementById("src-cf");
							if (cf) cf.focus();
						});
					}
				})();
				</script>
			}
		}
		<div class="card span2 mt18 tray">
			if vm.Operator {
				<div class="kicker">Playbook origins</div>
			} else {
				<div class="kicker">Read-only · CLI-managed</div>
			}
			<h3>All sources</h3>
			if !vm.Operator {
				<p class="meta">Read-only: managing sources needs an operator token.</p>
			}
			if len(vm.Sources) == 0 {
				<p class="meta">No sources registered — add one.</p>
			} else {
				<div class="tablewrap stackable">
					<table>
						<thead>
							<tr>
								<th scope="col">Source</th>
								<th scope="col">Kind</th>
								<th scope="col">URI</th>
								<th scope="col">Ref</th>
								<th scope="col">Trust</th>
								<th scope="col" class="right">Last sync</th>
								if vm.ShowEnabledColumn() {
									<th scope="col">Enabled</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, sc := range vm.Sources {
								<tr data-href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + sc.Name)) } class={ templ.KV("attention", sc.NeverSynced()) }>
									<td data-label="Source"><a href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + sc.Name)) }>{ sc.Name }</a></td>
									<td class="mono" data-label="Kind">{ sc.Kind }</td>
									<td class="mono wrap uri" data-label="URI">{ orDash(sc.URI) }</td>
									<td class="mono wrap" data-label="Ref">{ orDash(sc.Ref) }</td>
									<td data-label="Trust">@signedChip(sc)</td>
									<td class="right mono" data-label="Last sync">
										if sc.NeverSynced() {
											<span class="chip wait"><span class="dot"></span>NEVER</span>
										} else {
											{ sc.LastSyncLabel() }
										}
										if vm.Operator && sc.Kind == "git" {
											<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + sc.Name + "/sync")) } class="inline-form">
												<button type="submit" class="btn quiet">Sync now</button>
											</form>
										}
									</td>
									if vm.ShowEnabledColumn() {
										<td data-label="Enabled">@enabledChip(sc.Enabled, true)</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
				<p class="meta mt8">Row opens the source. Disable and delete live on the source page, next to what they affect.</p>
			}
		</div>
	}
}

// sourceGitResult shows a freshly generated deploy key's public half once — the
// operator copies it to the forge as a read-only key. The private half is
// already sealed into the envelope and never appears here.
templ sourceGitResult(vm sourceGitResultVM) {
	@layout(vm.Page) {
		@breadcrumb(breadcrumbCrumb{Label: "Sources", Href: urlWithBase(vm.Page.Base, "/sources")}, breadcrumbCrumb{Label: "Registered " + vm.Name})
		<h1>Registered { vm.Name }</h1>
		<div class="card span2 mt18">
			<div class="kicker">Add this deploy key to the forge — it is not shown again</div>
			<h3>{ vm.Name } · { vm.URL } (ref { vm.Ref })</h3>
			<pre class="secretbox" aria-label="deploy key">{ vm.PublicAuthorizedKey }</pre>
			<p class="meta">Add it as a read-only deploy key on the forge, then sync with <code>exocomp source sync { vm.Name }</code>.</p>
		</div>
	}
}

templ sourceReauthNotice(p page) {
	@layout(p) {
		@breadcrumb(breadcrumbCrumb{Label: "Sources", Href: urlWithBase(p.Base, "/sources")}, breadcrumbCrumb{Label: "Confirm"})
		<h1>Confirm required</h1>
		<div class="card span2 mt18">
			<p class="error" role="alert">That access token did not match this session. Re-enter your own token to confirm the sealed write.</p>
		</div>
	}
}

// sourceFormJS is the add-source form's progressive enhancement, mirroring the
// netgroup form: novalidate (the daemon is authoritative), submit intercepted
// and POSTed with fetch — a 422 swaps the form fragment in place with the
// server-rendered refusals (JS-off gets the same bytes as a full re-render),
// anything else follows the redirect and its success flash. After a refusal a
// field re-validates on blur and clears when right; the primary disables only
// while submitting. The path/git toggle and the confirm-token panel are the
// form's own script (above); this one owns validation and the submit wire.
templ sourceFormJS() {
	<script>
	(function () {
		function sourceFormWire() {
			var form = document.getElementById("src-add-form");
			if (!form || form.dataset.srcWired) return;
			form.dataset.srcWired = "1";

			function restoreMeta(input) {
				input.removeAttribute("aria-invalid");
				var meta = document.getElementById(input.getAttribute("aria-describedby"));
				if (meta) {
					meta.classList.remove("is-error");
					meta.textContent = input.name === "name"
						? "Letters, digits, dots, hyphens, underscores."
						: "An absolute path, or a git@host / https://host clone URL.";
				}
			}

			function showError(input, msg) {
				input.setAttribute("aria-invalid", "true");
				var meta = document.getElementById(input.getAttribute("aria-describedby"));
				if (meta) {
					meta.classList.add("is-error");
					meta.textContent = "▲ " + msg;
				}
			}

			// validateField runs the same client rules the server holds to — a
			// name shape refusal — on blur so a mistake surfaces before submit.
			// Empty is left alone (that's a submit-time required check); the
			// daemon stays authoritative on uniqueness, so submit still asks it.
			function validateField(input) {
				if (input.value.trim() === "") return;
				if (input.name === "name" && !/^[A-Za-z0-9_.-]+$/.test(input.value.trim())) {
					showError(input, "Names can't have spaces or special characters.");
					return;
				}
				restoreMeta(input);
			}

			form.addEventListener("submit", function (e) {
				e.preventDefault();
				var primary = form.querySelector('button[type="submit"]');
				var status = form.querySelector(".form-status");
				primary.disabled = true;
				status.innerHTML = '<span class="dot"></span>Adding';
				fetch(form.getAttribute("action"), {
					method: "POST",
					body: new FormData(form),
					credentials: "same-origin",
					headers: { "Accept": "text/html" }
				}).then(function (resp) {
					if (resp.status === 422) {
						return resp.text().then(function (html) {
							var doc = new DOMParser().parseFromString(html, "text/html");
							var next = doc.getElementById("src-add-form");
							if (!next) return;
							form.outerHTML = next.outerHTML;
							form = document.getElementById("src-add-form");
							form.dataset.srcRefused = "1";
							sourceFormWire();
							var bad = form.querySelector('input[aria-invalid="true"]');
							if (bad) bad.focus();
						});
					}
					var loc = resp.headers.get("Location");
					if (loc) { window.location = loc; return; }
					window.location.reload();
				}).catch(function () {
					primary.disabled = false;
					status.textContent = "";
				});
			});

			// Validate on blur always (not just after a refusal) so a mistake
			// surfaces as soon as the operator leaves the field.
			form.addEventListener("blur", function (e) {
				var input = e.target.closest('input[name="name"], input[name="location"]');
				if (!input) return;
				validateField(input);
			}, true);
		}
		sourceFormWire();
	})();
	</script>
}
