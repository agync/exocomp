package web

// signedChip states a source's trust posture: a signed source pinned to its own
// allowed-signers is the strong form, signed-only is a step down, unsigned is a
// dim neutral — never color-only, always a label. Shared by the sources surface
// and the dashboard's sources card.
templ signedChip(sc sourceRow) {
	if sc.Signed && sc.Signers {
		<span class="chip ok"><span class="dot"></span>SIGNED · SIGNERS</span>
	} else if sc.Signed {
		<span class="chip ok"><span class="dot"></span>SIGNED</span>
	} else {
		<span class="chip dim"><span class="dot"></span>UNSIGNED</span>
	}
}

// sourcesList is the run-tree sources surface (ADR 0010): where every run's
// tree comes from, its trust posture (signed / allowed-signers), and the commit
// its last sync landed on. An operator gets add/enable/disable/rm controls
// (sources_write.go); a signed/allowed-signers posture and `source sync` stay
// CLI-only (the latter has no queued job kind yet — see sources_write.go).
templ sourcesList(vm sourcesVM) {
	@layout(vm.Page) {
		<div class="pageheader">
			<h1>Sources</h1>
			if vm.Operator {
				@addButton("sources-add", "source")
			}
		</div>
		if vm.Operator {
			@modal("sources-add", "Add a source") {
				<p class="meta">
					A path is read directly (writable is opt-in); a git URL is cloned and
					pinned to a ref via a generated deploy key sealed into the envelope.
				</p>
				<form method="post" action="/sources/add" class="writeform" id="src-add-form">
					<label for="src-name">Name</label>
					<input id="src-name" name="name" type="text" required autocomplete="off" pattern="[A-Za-z0-9._-]+"/>
					<label for="src-location">Path or git URL</label>
					<input
						id="src-location"
						name="location"
						type="text"
						required
						autocomplete="off"
						placeholder="/abs/or/relative/path · git@host:org/repo.git · https://host/org/repo.git"
					/>
					<p class="meta" id="src-hint"></p>
					<div id="src-path-fields">
						<label class="checkline"><input type="checkbox" name="writable" id="src-writable"/> writable (default is read-only)</label>
					</div>
					<div id="src-git-fields" hidden>
						<label for="src-ref">Ref</label>
						<input id="src-ref" name="ref" type="text" autocomplete="off" placeholder="main"/>
						if !vm.SealAvailable {
							<p class="meta">Sealing is not available on this surface (this process holds no envelope).</p>
						} else {
							<p class="meta">
								A deploy key is generated and sealed into the envelope; its public
								half is shown once — add it to the forge as a read-only key, then
								sync with <code>exocomp source sync</code>.
							</p>
							<button type="button" class="btn" id="src-confirm-open">Add access token to confirm</button>
							<div id="src-confirm-panel" hidden>
								<label for="src-cf">Confirm: your access token</label>
								<input id="src-cf" name="confirm_token" type="password" autocomplete="off"/>
							</div>
						}
					</div>
					<div class="actions"><button type="submit" class="btn primary">Add source</button></div>
				</form>
				<script>
				(function () {
					var loc = document.getElementById("src-location");
					var hint = document.getElementById("src-hint");
					var pathFields = document.getElementById("src-path-fields");
					var gitFields = document.getElementById("src-git-fields");
					var confirmOpen = document.getElementById("src-confirm-open");
					var confirmPanel = document.getElementById("src-confirm-panel");
					if (!loc || !hint || !pathFields || !gitFields) return;

					// Mirrors source.LooksLikeGitURL loosely: an explicit scheme, or
					// scp-like [user@]host:path. Progressive disclosure only — the
					// server re-derives this from the same field and is authoritative.
					function looksLikeGitURL(raw) {
						var u = (raw || "").trim();
						if (u === "") return false;
						if (/^(https?|ssh|git|ftps?):\/\//i.test(u)) return true;
						var colon = u.indexOf(":");
						if (colon < 0) return false;
						var slash = u.indexOf("/");
						if (slash >= 0 && slash < colon) return false;
						var host = u.slice(0, colon);
						var at = host.lastIndexOf("@");
						if (at >= 0) return true;
						return host.length > 1 && (host.indexOf(".") >= 0 || host === "localhost");
					}

					function refresh() {
						var isGit = looksLikeGitURL(loc.value);
						pathFields.hidden = isGit;
						gitFields.hidden = !isGit;
						hint.textContent = loc.value.trim() === "" ? "" : (isGit ? "→ git source (a deploy key will be generated)" : "→ path source");
					}
					loc.addEventListener("input", refresh);
					refresh();

					if (confirmOpen && confirmPanel) {
						confirmOpen.addEventListener("click", function () {
							confirmPanel.hidden = false;
							confirmOpen.hidden = true;
							var cf = document.getElementById("src-cf");
							if (cf) cf.focus();
						});
					}
				})();
				</script>
			}
		}
		<div class="card span2" style="margin-top:18px">
			if !vm.Operator {
				<div class="kicker">Read-only · CLI-managed</div>
			}
			<h3>All sources</h3>
			if !vm.Operator {
				<p class="meta">Read-only: managing sources needs an operator token.</p>
			}
			if len(vm.Sources) == 0 {
				<p class="meta">No sources registered.</p>
			} else {
				<div class="tablewrap stackable">
					<table>
						<thead>
							<tr>
								<th scope="col">Source</th>
								<th scope="col">Kind</th>
								<th scope="col">URI</th>
								<th scope="col">Ref</th>
								<th scope="col">Trust</th>
								<th scope="col" class="right">Last sync</th>
								<th scope="col">Enabled</th>
								if vm.Operator {
									<th scope="col">Actions</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, sc := range vm.Sources {
								<tr>
									<td data-label="Source">{ sc.Name }</td>
									<td class="mono" data-label="Kind">{ sc.Kind }</td>
									<td class="mono wrap" data-label="URI">{ orDash(sc.URI) }</td>
									<td class="mono wrap" data-label="Ref">{ orDash(sc.Ref) }</td>
									<td data-label="Trust">@signedChip(sc)</td>
									<td class="right mono" data-label="Last sync">{ orDash(sc.Short()) }</td>
									<td data-label="Enabled">@enabledChip(sc.Enabled)</td>
									if vm.Operator {
										<td data-label="Actions">
											if sc.Enabled {
												<form method="post" action={ templ.SafeURL("/sources/" + sc.Name + "/disable") } style="display:inline">
													<button type="submit" class="btn">Disable</button>
												</form>
											} else {
												<form method="post" action={ templ.SafeURL("/sources/" + sc.Name + "/enable") } style="display:inline">
													<button type="submit" class="btn">Enable</button>
												</form>
											}
											<form method="post" action={ templ.SafeURL("/sources/" + sc.Name + "/rm") } style="display:inline">
												<input type="hidden" name="confirmed" value="1"/>
												<button type="submit" class="btn danger">Delete</button>
											</form>
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// sourceGitResult shows a freshly generated deploy key's public half once — the
// operator copies it to the forge as a read-only key. The private half is
// already sealed into the envelope and never appears here.
templ sourceGitResult(vm sourceGitResultVM) {
	@layout(vm.Page) {
		<h1>Registered { vm.Name }</h1>
		<div class="card span2" style="margin-top:18px">
			<div class="kicker">Add this deploy key to the forge — it is not shown again</div>
			<h3>{ vm.Name } · { vm.URL } (ref { vm.Ref })</h3>
			<pre class="secretbox" aria-label="deploy key">{ vm.PublicAuthorizedKey }</pre>
			<p class="meta">Add it as a read-only deploy key on the forge, then sync with <code>exocomp source sync { vm.Name }</code>.</p>
			<div class="actions"><a class="btn" href="/sources">Back to sources</a></div>
		</div>
	}
}

templ sourceReauthNotice(p page) {
	@layout(p) {
		<h1>Confirm required</h1>
		<div class="card span2" style="margin-top:18px">
			<p class="error" role="alert">That access token did not match this session. Re-enter your own token to confirm the sealed write.</p>
			<div class="actions"><a class="btn" href="/sources">Back to sources</a></div>
		</div>
	}
}
