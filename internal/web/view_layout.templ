package web

// layout is the chrome every authenticated screen renders inside. The viewport
// meta is load-bearing: the phone approval surface is designed at 390px and
// must not be zoomed out to a desktop width.
templ layout(p page) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title } · exocomp</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"/>
			<style>
				html{background:#0A0C0D}
				@media (prefers-color-scheme: light){html:not([data-theme="dark"]){background:#F5F2EC}}
				html[data-theme="light"]{background:#F5F2EC}
				html[data-theme="dark"]{background:#0A0C0D}
			</style>
			<link rel="stylesheet" href={ AssetURL("/assets/tokens.css") }/>
			<link rel="stylesheet" href={ AssetURL("/assets/app.css") }/>
			@themeInit()
			@navInit()
			@modalInit()
			@selectInit()
		</head>
		<body>
			<div class="app">
				<div class="scrim" onclick="exoCloseNav()" aria-hidden="true"></div>
				<aside class="sidebar" aria-label="Primary">
					<div class="side-top">
						<a class="brandlink" href="/">
							<span class="brand-slot">@brandMark()</span>
							<span class="wordmark">exocomp</span>
						</a>
						<button type="button" class="railtoggle" id="railbtn" onclick="exoToggleRail(event)" aria-label="Collapse sidebar" title="Collapse sidebar">
							<svg class="railchev" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg>
							<span class="raillabel">Open sidebar</span>
						</button>
					</div>
					<nav class="side-nav">
						@navlink(p.Nav, "dashboard", "/", "Dashboard", iconDashboard)
						@navlink(p.Nav, "approvals", "/approvals", "Approvals", iconApprovals)
						@navlink(p.Nav, "events", "/events", "Events", iconEvents)
						@navlink(p.Nav, "jobs", "/jobs", "Jobs", iconJobs)
						@navlink(p.Nav, "policies", "/policies", "Policies", iconPolicies)
						@navlink(p.Nav, "runners", "/runners", "Runners", iconRunners)
						@navlink(p.Nav, "schedules", "/schedules", "Schedules", iconSchedules)
						@navlink(p.Nav, "secrets", "/secrets", "Secrets", iconSecrets)
						@navlink(p.Nav, "sources", "/sources", "Sources", iconSources)
						@navlink(p.Nav, "tokens", "/tokens", "Tokens", iconTokens)
						@navlink(p.Nav, "workflows", "/workflows", "Workflows", iconWorkflows)
						@navlink(p.Nav, "workspaces", "/workspaces", "Workspaces", iconWorkspaces)
						<div class="navdivider" role="separator" aria-hidden="true"></div>
						@navlink(p.Nav, "system", "/system", "System", iconSystem)
					</nav>
					<div class="side-foot">
						@themeToggle()
					</div>
				</aside>
				<div class="content-col">
					<header class="mobilebar">
						<button type="button" class="hamburger" onclick="exoToggleDrawer()" aria-label="Open navigation">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
						</button>
						<a class="brandlink" href="/">
							@brandMark()
							<span class="wordmark">exocomp</span>
						</a>
					</header>
					<main>
						if p.Flash != "" {
							<p class="flash" role="status">{ p.Flash }</p>
						}
						{ children... }
					</main>
				</div>
			</div>
			@powerline(p)
			@layoutReady()
			<script src={ AssetURL("/assets/htmx.min.js") }></script>
		</body>
	</html>
}

// breadcrumbCrumb is one segment of a breadcrumb trail: a link when Href is
// set, or the trailing current page when it is empty.
type breadcrumbCrumb struct {
	Label string
	Href  string
}

// breadcrumb replaces the ad-hoc "back to X" buttons that used to sit beside a
// detail/result page's <h1>: a trail above the page content, ending in the
// current page (unlinked, aria-current). Render at the top of a page's
// content, above its .pageheader.
templ breadcrumb(crumbs ...breadcrumbCrumb) {
	<nav class="breadcrumb" aria-label="Breadcrumb">
		for i, c := range crumbs {
			if i > 0 {
				<span class="crumb-sep" aria-hidden="true">/</span>
			}
			if c.Href != "" {
				<a href={ templ.SafeURL(c.Href) }>{ c.Label }</a>
			} else {
				<span aria-current="page">{ c.Label }</span>
			}
		}
	</nav>
}

// brandMark is the exocomp mark from the design system (Foundations §01,
// "Carapace and pin"): a four-sided shell with one corner cut away — the tool
// bay — holding a single pin. The shell is ink and never changes; the pin
// (.cell) is the accent fill, the mark's one live element.
templ brandMark() {
	<svg class="brandmark" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M4 6.2A2.2 2.2 0 0 1 6.2 4h8.4L20 9.4v8.4A2.2 2.2 0 0 1 17.8 20H6.2A2.2 2.2 0 0 1 4 17.8Z"></path>
		<circle class="cell" cx="9.4" cy="14.6" r="2.1" fill="currentColor" stroke="none"></circle>
	</svg>
}

// navlink renders one sidebar entry: a glyph plus its label. The active entry
// keeps class before href so the rendered `href="/x" aria-current="page"` stays
// contiguous (asserted by the render tests).
templ navlink(active, key, href, label, icon string) {
	if active == key {
		<a class="navitem active" href={ templ.SafeURL(href) } aria-current="page">
			@navicon(icon)
			<span>{ label }</span>
		</a>
	} else {
		<a class="navitem" href={ templ.SafeURL(href) } aria-label={ label }>
			@navicon(icon)
			<span>{ label }</span>
		</a>
	}
}

templ navicon(d string) {
	<svg class="navglyph" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d={ d }></path>
	</svg>
}

// Section glyphs, one path each so they collapse to an icon rail cleanly.
const (
	iconDashboard = "M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z"
	iconJobs      = "M4 6h16M4 12h16M4 18h10"
	iconApprovals = "M20 6L9 17l-5-5"
	iconEvents    = "M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21a2 2 0 0 0 4 0"
	iconSources   = "M6 3v12M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 9c0 6-6 3-6 9"
	iconSchedules = "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 8v4l3 2"
	iconWorkflows = "M5 4h5v5H5zM14 15h5v5h-5zM10 6.5h4a3 3 0 0 1 3 3V15"
	iconPolicies  = "M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"
	iconSecrets   = "M12 3a4 4 0 0 0-4 4v3H6v11h12V10h-2V7a4 4 0 0 0-4-4zM10 10V7a2 2 0 1 1 4 0v3"
	iconRunners   = "M6 6h12v12H6zM9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M18 9h3M3 15h3M18 15h3"
	iconWorkspaces = "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"
	iconTokens     = "M14 8a4 4 0 1 0-5.5 3.7L4 16v4h4v-2h2v-2h2l1.5-1.5A4 4 0 0 0 14 8z"
	iconSystem     = "M4 4h16v6H4zM4 14h16v6H4zM7.5 7h.01M7.5 17h.01"
)

// powerline is the fixed-bottom status strip: the is-the-control-plane-alive
// signals (dead-man, ntfy, disk) and who is signed in. It sits in the viewport's
// bottom edge, not at end-of-content, so it is always visible; main carries
// bottom padding so no content hides behind it. Minimal by intent — the server
// version lives on /system, not here.
templ powerline(p page) {
	<footer class="powerline" role="contentinfo">
		<span class="pl-item">dead-man { p.Signal.DeadMan }</span>
		<span class="pl-item">ntfy { p.Signal.Ntfy }</span>
		if p.Signal.Warn {
			<span class="pl-item warn">disk { p.Signal.Disk }</span>
		} else {
			<span class="pl-item">disk { p.Signal.Disk }</span>
		}
		if p.Who != "" {
			<span class="pl-who" title="signed in">{ p.Who } · { p.Scope }</span>
		}
	</footer>
}

// themeInit applies the persisted theme before first paint so a light-mode
// operator never sees a dark flash, and defines the three-state toggle: the
// control cycles system -> light -> dark -> system. "system" follows
// prefers-color-scheme with no data-theme and no stored preference; "light" and
// "dark" pin the attribute and persist. Only a light/dark value is honoured on
// read, so a cleared or garbage entry falls back to system.
templ themeInit() {
	<script>
	(function () {
		try {
			var t = localStorage.getItem("exocomp-theme");
			if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
		} catch (e) {}
	})();
	// exoThemeState reads the state the same way in SSR (server has no
	// data-theme, so "system") and after a click, straight from storage.
	function exoThemeState() {
		var stored = null;
		try { stored = localStorage.getItem("exocomp-theme"); } catch (e) {}
		return (stored === "light" || stored === "dark") ? stored : "system";
	}
	// exoNextTheme is the cycle order the button advances on each click.
	function exoNextTheme(state) {
		return { system: "light", light: "dark", dark: "system" }[state] || "light";
	}
	function exoCycleTheme() {
		var next = exoNextTheme(exoThemeState());
		var el = document.documentElement;
		if (next === "system") {
			el.removeAttribute("data-theme");
			try { localStorage.removeItem("exocomp-theme"); } catch (e) {}
		} else {
			el.setAttribute("data-theme", next);
			try { localStorage.setItem("exocomp-theme", next); } catch (e) {}
		}
		exoSyncThemeControl();
	}
	// exoSyncThemeControl shows the current state's glyph, names it in the
	// visible label, and writes an aria-label naming the current state and what
	// a click does. Null-safe so it is harmless before the button exists (it
	// runs for real from the end-of-body script on load, and after each click).
	function exoSyncThemeControl() {
		var btn = document.getElementById("themebtn");
		if (!btn) return;
		var state = exoThemeState();
		var glyphs = btn.querySelectorAll(".themeglyph");
		for (var i = 0; i < glyphs.length; i++) {
			glyphs[i].hidden = glyphs[i].getAttribute("data-glyph") !== state;
		}
		btn.setAttribute("aria-label", "Theme: " + state + ". Switch to " + exoNextTheme(state) + ".");
	}
	</script>
}

// themeToggle is the three-state theme control. It renders in the server's
// default state — "system", since the server sets no data-theme — with all
// three glyphs in the DOM and only the active one shown, so the markup is
// correct before any script runs and the client script only swaps which glyph
// is visible. Each state has a distinct glyph: an auto/monitor mark for system,
// a sun for light, a moon for dark.
templ themeToggle() {
	<button type="button" class="themetoggle" onclick="exoCycleTheme()" aria-label="Theme: system. Switch to light." id="themebtn">
		<span class="themeglyph" data-glyph="system" aria-hidden="true">
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="2.5" width="13" height="9" rx="1"></rect><path d="M5.5 14h5M8 11.5V14"></path></svg>
		</span>
		<span class="themeglyph" data-glyph="light" aria-hidden="true" hidden>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="3"></circle><path d="M8 .9V2.4M8 13.6V15.1M2.6 2.6l1.1 1.1M12.3 12.3l1.1 1.1M.9 8H2.4M13.6 8H15.1M2.6 13.4l1.1-1.1M12.3 3.7l1.1-1.1"></path></svg>
		</span>
		<span class="themeglyph" data-glyph="dark" aria-hidden="true" hidden>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M13.4 9.6A5.6 5.6 0 1 1 6.4 2.6a4.4 4.4 0 0 0 7 7z"></path></svg>
		</span>
	</button>
}

// layoutReady runs once the chrome is in the DOM: it syncs the theme-toggle
// label to the active theme and scrolls the active nav item into view so the
// current page is visible when the nav has scrolled off-screen on a phone.
// navInit applies the persisted sidebar state before first paint (so a rail
// user never sees the full width flash) and defines the rail/drawer controls.
// Rail collapse is a desktop concern; the mobile drawer is a separate transient
// state that never persists.
templ navInit() {
	<script>
	(function () {
		try { if (localStorage.getItem("exocomp-nav") === "rail") document.documentElement.setAttribute("data-nav", "rail"); } catch (e) {}
	})();
	function exoToggleRail(ev) {
		var r = document.documentElement, rail = r.getAttribute("data-nav") === "rail";
		if (rail) { r.removeAttribute("data-nav"); try { localStorage.removeItem("exocomp-nav"); } catch (e) {} }
		else {
			r.setAttribute("data-nav", "rail"); try { localStorage.setItem("exocomp-nav", "rail"); } catch (e) {}
			// A pointer click leaves the button focused, so :focus-within keeps the
			// mark hidden until the next click. Blur on pointer-collapse so the mark
			// shows at once; keyboard activation (detail 0) keeps focus to reveal
			// the reopen control.
			if (ev && ev.detail > 0) { var b = document.getElementById("railbtn"); if (b) b.blur(); }
		}
		exoSyncRail();
	}
	function exoSyncRail() {
		var b = document.getElementById("railbtn");
		if (!b) return;
		var rail = document.documentElement.getAttribute("data-nav") === "rail";
		b.setAttribute("aria-label", rail ? "Expand sidebar" : "Collapse sidebar");
		b.setAttribute("title", rail ? "Open sidebar" : "Collapse sidebar");
	}
	// The mobile drawer opens over the content; the scrim and any nav link close it.
	function exoToggleDrawer() {
		var r = document.documentElement;
		if (r.getAttribute("data-drawer") === "open") r.removeAttribute("data-drawer");
		else r.setAttribute("data-drawer", "open");
	}
	function exoCloseNav() { document.documentElement.removeAttribute("data-drawer"); }
	</script>
}

// selectInit defines the themed-select enhancer, wired once here so it reaches
// every .writeform select on the page — including those inside a closed
// <dialog>, which are already in the DOM at load, so no per-modal re-run is
// needed. The native <select> stays the form field and the JS-off fallback.
templ selectInit() {
	<script>
	// exoEnhanceSelects walks .writeform selects and enhances each once.
	function exoEnhanceSelects(root) {
		var sels = (root || document).querySelectorAll(".writeform select");
		for (var i = 0; i < sels.length; i++) exoEnhanceSelect(sels[i]);
	}
	function exoEnhanceSelect(sel) {
		if (sel.dataset.enhanced) return;
		sel.dataset.enhanced = "1";
		var base = sel.id || ("xsel-" + Math.random().toString(36).slice(2, 8));
		var panelId = base + "-listbox";
		var lbl = sel.id && document.querySelector('label[for="' + sel.id + '"]');
		var name = lbl ? lbl.textContent.trim() : "";

		var wrap = document.createElement("div");
		wrap.className = "xselect";
		sel.parentNode.insertBefore(wrap, sel);
		wrap.appendChild(sel);
		sel.classList.add("visually-hidden");
		sel.setAttribute("tabindex", "-1");
		sel.setAttribute("aria-hidden", "true");

		var trigger = document.createElement("button");
		trigger.type = "button";
		trigger.className = "xselect-trigger";
		trigger.setAttribute("aria-haspopup", "listbox");
		trigger.setAttribute("aria-expanded", "false");
		trigger.setAttribute("aria-controls", panelId);
		if (name) trigger.setAttribute("aria-label", name);
		var value = document.createElement("span");
		value.className = "xselect-value";
		trigger.appendChild(value);
		trigger.insertAdjacentHTML("beforeend",
			'<svg class="xselect-chev" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4"></path></svg>');
		wrap.appendChild(trigger);

		var panel = document.createElement("ul");
		panel.className = "xselect-panel";
		panel.id = panelId;
		panel.setAttribute("role", "listbox");
		panel.setAttribute("tabindex", "-1");
		if (name) panel.setAttribute("aria-label", name);
		panel.hidden = true;
		wrap.appendChild(panel);

		var options = [];
		for (var j = 0; j < sel.options.length; j++) {
			var li = document.createElement("li");
			li.className = "xselect-option";
			li.id = panelId + "-o" + j;
			li.setAttribute("role", "option");
			li.dataset.index = String(j);
			li.textContent = sel.options[j].textContent;
			li.setAttribute("aria-selected", sel.options[j].selected ? "true" : "false");
			panel.appendChild(li);
			options.push(li);
		}
		var active = sel.selectedIndex < 0 ? 0 : sel.selectedIndex;

		function syncValue() {
			var o = sel.options[sel.selectedIndex];
			value.textContent = o ? o.textContent : "";
		}
		function markSelected() {
			for (var k = 0; k < options.length; k++) {
				options[k].setAttribute("aria-selected", k === sel.selectedIndex ? "true" : "false");
			}
		}
		function setActive(idx) {
			active = Math.max(0, Math.min(options.length - 1, idx));
			for (var k = 0; k < options.length; k++) options[k].classList.toggle("active", k === active);
			panel.setAttribute("aria-activedescendant", options[active].id);
			options[active].scrollIntoView({ block: "nearest" });
		}
		function isOpen() { return !panel.hidden; }
		function open() {
			if (isOpen()) return;
			panel.hidden = false;
			trigger.setAttribute("aria-expanded", "true");
			setActive(sel.selectedIndex < 0 ? 0 : sel.selectedIndex);
			panel.focus();
		}
		function close(toTrigger) {
			if (!isOpen()) return;
			panel.hidden = true;
			trigger.setAttribute("aria-expanded", "false");
			if (toTrigger) trigger.focus();
		}
		function commit(idx) {
			if (sel.selectedIndex !== idx) {
				sel.selectedIndex = idx;
				sel.dispatchEvent(new Event("change", { bubbles: true }));
			}
			markSelected();
			syncValue();
		}

		trigger.addEventListener("click", function () { isOpen() ? close(false) : open(); });
		trigger.addEventListener("keydown", function (e) {
			if (e.key === "ArrowDown" || e.key === "ArrowUp" || e.key === "Enter" || e.key === " ") {
				e.preventDefault();
				open();
			}
		});
		panel.addEventListener("keydown", function (e) {
			switch (e.key) {
			case "ArrowDown": e.preventDefault(); setActive(active + 1); break;
			case "ArrowUp": e.preventDefault(); setActive(active - 1); break;
			case "Home": e.preventDefault(); setActive(0); break;
			case "End": e.preventDefault(); setActive(options.length - 1); break;
			case "Enter":
			case " ": e.preventDefault(); commit(active); close(true); break;
			case "Escape": e.preventDefault(); close(true); break;
			case "Tab": commit(active); close(false); break;
			default:
				if (e.key.length === 1) {
					var ch = e.key.toLowerCase();
					for (var k = 1; k <= options.length; k++) {
						var i2 = (active + k) % options.length;
						if (options[i2].textContent.trim().toLowerCase().indexOf(ch) === 0) { setActive(i2); break; }
					}
				}
			}
		});
		panel.addEventListener("click", function (e) {
			var li = e.target.closest(".xselect-option");
			if (!li) return;
			var idx = Number(li.dataset.index);
			setActive(idx);
			commit(idx);
			close(true);
		});
		panel.addEventListener("mousemove", function (e) {
			var li = e.target.closest(".xselect-option");
			if (li) setActive(Number(li.dataset.index));
		});
		document.addEventListener("click", function (e) {
			if (isOpen() && !wrap.contains(e.target)) close(false);
		});
		// Keep the trigger correct if the value is changed on the native element.
		sel.addEventListener("change", function () { markSelected(); syncValue(); });
		syncValue();
	}
	</script>
}

templ layoutReady() {
	<script>
	exoSyncThemeControl();
	exoSyncRail();
	exoEnhanceSelects(document);
	document.querySelectorAll('.side-nav .navitem').forEach(function (a) {
		a.addEventListener('click', exoCloseNav);
	});
	document.querySelector('.side-nav [aria-current="page"]')
		?.scrollIntoView({ block: "center" });
	// Clickable list rows: a mouse enhancement over the row's own #id link, so
	// the whole row is an obvious click target. Clicks on a real link or button
	// inside the row (the Review CTA, a nested job link, etc.) keep their own
	// behaviour instead of triggering the row navigation.
	document.querySelectorAll('tr[data-href]').forEach(function (tr) {
		tr.addEventListener('click', function (e) {
			if (e.target.closest('a,button')) return;
			window.location.href = tr.getAttribute('data-href');
		});
	});
	// Same affordance, but opens a modal instead of navigating — the Schedules
	// row's spec detail, with the same exclusion for nested links/buttons
	// (Enable/Disable/Remove, the Last outcome link).
	document.querySelectorAll('tr[data-modal-row]').forEach(function (tr) {
		tr.addEventListener('click', function (e) {
			if (e.target.closest('a,button')) return;
			exoModalOpen(tr.getAttribute('data-modal-row'));
		});
	});
	// Modal open/dismiss is one delegated listener for the whole page: any
	// [data-modal-open] opens its target dialog; [data-modal-dismiss] (the ×
	// button) closes its enclosing dialog; and a click landing on the dialog
	// element itself is the backdrop region (real form content reports its own
	// target), which closes the modal. Esc is the element's own behaviour.
	document.addEventListener('click', function (e) {
		var opener = e.target.closest('[data-modal-open]');
		if (opener) { exoModalOpen(opener.getAttribute('data-modal-open')); return; }
		var dismiss = e.target.closest('[data-modal-dismiss]');
		if (dismiss) { var d = dismiss.closest('dialog'); if (d) d.close(); return; }
		if (e.target.tagName === 'DIALOG' && e.target.classList.contains('modal')) {
			e.target.close();
		}
	});
	// Copy-to-clipboard: a .copybtn copies its sibling <pre> and shows a check.
	document.addEventListener('click', function (e) {
		var b = e.target.closest('.copybtn');
		if (!b || !navigator.clipboard) return;
		var pre = b.parentNode.querySelector('pre');
		if (!pre) return;
		navigator.clipboard.writeText(pre.textContent).then(function () {
			b.classList.add('copied');
			setTimeout(function () { b.classList.remove('copied'); }, 1200);
		});
	});
	</script>
}

// loginPage bootstraps a browser session from a token. The token is pasted
// once and exchanged for the session cookie; the fingerprint is shown so the
// operator can confirm they are pinning the certificate they minted.
templ loginPage(errMsg, next, fingerprint string, insecure bool) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Sign in · exocomp</title>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"/>
			<style>
				html{background:#0A0C0D}
				@media (prefers-color-scheme: light){html:not([data-theme="dark"]){background:#F5F2EC}}
				html[data-theme="light"]{background:#F5F2EC}
				html[data-theme="dark"]{background:#0A0C0D}
			</style>
			<link rel="stylesheet" href={ AssetURL("/assets/tokens.css") }/>
			<link rel="stylesheet" href={ AssetURL("/assets/app.css") }/>
			@themeInit()
		</head>
		<body>
			<div class="login">
				<div class="card">
					<div class="loginbrand">
						@brandMark()
						<span class="wordmark">exocomp</span>
					</div>
					<h2>Sign in</h2>
					<p class="meta">Paste a token minted with <code>exocomp token new</code>. It is exchanged for a session bound to that token — revoke the token and this session dies.</p>
					if errMsg != "" {
						<p class="error" role="alert">{ errMsg }</p>
					}
					if insecure {
						<p class="error" role="alert">This listener serves cleartext HTTP (--insecure-http). Your token is readable on the wire.</p>
					}
					<form method="post" action="/login">
						<input type="hidden" name="next" value={ next }/>
						<label for="token">Access token</label>
						<input id="token" name="token" type="password" autocomplete="off" autofocus required aria-describedby="fp"/>
						<div class="actions">
							<button type="submit" class="btn primary">Sign in</button>
						</div>
					</form>
					if fingerprint != "" {
						<p id="fp" class="fingerprint" style="margin-top:18px">certificate SHA-256<br/>{ fingerprint }</p>
					}
				</div>
			</div>
		</body>
	</html>
}
