package web

// layout is the chrome every authenticated screen renders inside. The viewport
// meta is load-bearing: the phone approval surface is designed at 390px and
// must not be zoomed out to a desktop width.
templ layout(p page) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title } · exocomp</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"/>
			<link rel="stylesheet" href="/assets/tokens.css"/>
			<link rel="stylesheet" href="/assets/app.css"/>
			@themeInit()
		</head>
		<body>
			<div class="app">
				<header class="appbar">
					<span class="brand">exocomp</span>
					<nav aria-label="Primary">
						@navlink(p.Nav, "dashboard", "/", "Dashboard")
						@navlink(p.Nav, "jobs", "/jobs", "Jobs")
						@navlink(p.Nav, "approvals", "/approvals", "Approvals")
						@navlink(p.Nav, "events", "/events", "Events")
						@navlink(p.Nav, "sources", "/sources", "Sources")
						@navlink(p.Nav, "schedules", "/schedules", "Schedules")
						@navlink(p.Nav, "workflows", "/workflows", "Workflows")
						@navlink(p.Nav, "policies", "/policies", "Policies")
						@navlink(p.Nav, "secrets", "/secrets", "Secrets")
						@navlink(p.Nav, "runners", "/runners", "Runners")
					</nav>
					<span class="spacer"></span>
					if p.Who != "" {
						<span class="who" title="signed in">{ p.Who } · { p.Scope }</span>
					}
					@themeToggle()
				</header>
				<main>
					{ children... }
					@footer(p.Signal)
				</main>
			</div>
			@layoutReady()
			<script src="/assets/htmx.min.js"></script>
		</body>
	</html>
}

templ navlink(active, key, href, label string) {
	if active == key {
		<a href={ templ.SafeURL(href) } aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) }>{ label }</a>
	}
}

templ footer(s SignalLine) {
	<div class="footer-signal" role="contentinfo">
		<span>dead-man { s.DeadMan }</span>
		<span>ntfy { s.Ntfy }</span>
		if s.Warn {
			<span class="warn">disk { s.Disk }</span>
		} else {
			<span>disk { s.Disk }</span>
		}
		<span>{ s.Version }</span>
	</div>
}

// themeInit applies the persisted theme before first paint so a light-mode
// operator never sees a dark flash, and defines the three-state toggle: the
// control cycles system -> light -> dark -> system. "system" follows
// prefers-color-scheme with no data-theme and no stored preference; "light" and
// "dark" pin the attribute and persist. Only a light/dark value is honoured on
// read, so a cleared or garbage entry falls back to system.
templ themeInit() {
	<script>
	(function () {
		try {
			var t = localStorage.getItem("exocomp-theme");
			if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
		} catch (e) {}
	})();
	// exoThemeState reads the state the same way in SSR (server has no
	// data-theme, so "system") and after a click, straight from storage.
	function exoThemeState() {
		var stored = null;
		try { stored = localStorage.getItem("exocomp-theme"); } catch (e) {}
		return (stored === "light" || stored === "dark") ? stored : "system";
	}
	// exoNextTheme is the cycle order the button advances on each click.
	function exoNextTheme(state) {
		return { system: "light", light: "dark", dark: "system" }[state] || "light";
	}
	function exoCycleTheme() {
		var next = exoNextTheme(exoThemeState());
		var el = document.documentElement;
		if (next === "system") {
			el.removeAttribute("data-theme");
			try { localStorage.removeItem("exocomp-theme"); } catch (e) {}
		} else {
			el.setAttribute("data-theme", next);
			try { localStorage.setItem("exocomp-theme", next); } catch (e) {}
		}
		exoSyncThemeControl();
	}
	// exoSyncThemeControl shows the current state's glyph, names it in the
	// visible label, and writes an aria-label naming the current state and what
	// a click does. Null-safe so it is harmless before the button exists (it
	// runs for real from the end-of-body script on load, and after each click).
	function exoSyncThemeControl() {
		var btn = document.getElementById("themebtn");
		if (!btn) return;
		var state = exoThemeState();
		var glyphs = btn.querySelectorAll(".themeglyph");
		for (var i = 0; i < glyphs.length; i++) {
			glyphs[i].hidden = glyphs[i].getAttribute("data-glyph") !== state;
		}
		var names = { system: "System", light: "Light", dark: "Dark" };
		var lbl = document.getElementById("themelabel");
		if (lbl) lbl.textContent = names[state];
		btn.setAttribute("aria-label", "Theme: " + state + ". Switch to " + exoNextTheme(state) + ".");
	}
	</script>
}

// themeToggle is the three-state theme control. It renders in the server's
// default state — "system", since the server sets no data-theme — with all
// three glyphs in the DOM and only the active one shown, so the markup is
// correct before any script runs and the client script only swaps which glyph
// is visible. Each state has a distinct glyph: an auto/monitor mark for system,
// a sun for light, a moon for dark.
templ themeToggle() {
	<button type="button" class="themetoggle" onclick="exoCycleTheme()" aria-label="Theme: system. Switch to light." id="themebtn">
		<span class="themeglyph" data-glyph="system" aria-hidden="true">
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="2.5" width="13" height="9" rx="1"></rect><path d="M5.5 14h5M8 11.5V14"></path></svg>
		</span>
		<span class="themeglyph" data-glyph="light" aria-hidden="true" hidden>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="3"></circle><path d="M8 .9V2.4M8 13.6V15.1M2.6 2.6l1.1 1.1M12.3 12.3l1.1 1.1M.9 8H2.4M13.6 8H15.1M2.6 13.4l1.1-1.1M12.3 3.7l1.1-1.1"></path></svg>
		</span>
		<span class="themeglyph" data-glyph="dark" aria-hidden="true" hidden>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M13.4 9.6A5.6 5.6 0 1 1 6.4 2.6a4.4 4.4 0 0 0 7 7z"></path></svg>
		</span>
		<span id="themelabel">System</span>
	</button>
}

// layoutReady runs once the chrome is in the DOM: it syncs the theme-toggle
// label to the active theme and scrolls the active nav item into view so the
// current page is visible when the nav has scrolled off-screen on a phone.
templ layoutReady() {
	<script>
	exoSyncThemeControl();
	document.querySelector('nav [aria-current="page"]')
		?.scrollIntoView({ inline: "center", block: "nearest" });
	</script>
}

// loginPage bootstraps a browser session from a token. The token is pasted
// once and exchanged for the session cookie; the fingerprint is shown so the
// operator can confirm they are pinning the certificate they minted.
templ loginPage(errMsg, next, fingerprint string, insecure bool) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Sign in · exocomp</title>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"/>
			<link rel="stylesheet" href="/assets/tokens.css"/>
			<link rel="stylesheet" href="/assets/app.css"/>
			@themeInit()
		</head>
		<body>
			<div class="login">
				<div class="card">
					<div class="kicker">exocomp</div>
					<h2>Sign in</h2>
					<p class="meta">Paste a token minted with <code>exocomp token new</code>. It is exchanged for a session bound to that token — revoke the token and this session dies.</p>
					if errMsg != "" {
						<p class="error" role="alert">{ errMsg }</p>
					}
					if insecure {
						<p class="error" role="alert">This listener serves cleartext HTTP (--insecure-http). Your token is readable on the wire.</p>
					}
					<form method="post" action="/login">
						<input type="hidden" name="next" value={ next }/>
						<label for="token">Access token</label>
						<input id="token" name="token" type="password" autocomplete="off" autofocus required aria-describedby="fp"/>
						<div class="actions">
							<button type="submit" class="btn primary">Sign in</button>
						</div>
					</form>
					if fingerprint != "" {
						<p id="fp" class="fingerprint" style="margin-top:18px">certificate SHA-256<br/>{ fingerprint }</p>
					}
				</div>
			</div>
		</body>
	</html>
}
