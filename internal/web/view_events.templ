package web

// eventsList is the Events screen: a last-24h funnel card, filter chips
// (outcome + source split), and a tray table of every received alert with the
// stored payload and evaluation trace inline — so "why didn't it fire?" is
// answerable by scanning (the brief's Event vocabulary). The ?filter= chip is
// a plain GET so a filtered view stays linkable; the empty state hides the
// chips (R7) and the funnel shows a zero bar.
templ eventsList(vm eventsVM) {
	@layout(vm.Page) {
		@eventsFunnel(vm.Funnel.Total(), vm.Funnel.Ignored, vm.Funnel.Matched, vm.Funnel.Suppressed, vm.Funnel.Gated, vm.Funnel.Fired)
		if vm.Empty {
			<div class="card span2 mt18 events-empty">
				<p class="meta">No events yet. Point an alert source at exocomp ingest and they land here.</p>
			</div>
		} else {
			@eventsFilters(vm)
			if vm.NoMatch {
				<p class="meta mt14">No events match <span class="mono">{ vm.Filter }</span>.</p>
			}
			@eventsTray(vm)
		}
		@eventsKeys()
	}
}

// eventsFunnel is the last-24h counts row plus the proportional outcome bar.
// The bar renders only the closed enum's five outcomes (the copy's closed
// set), weighted by the count; a zero outcome is absent, so the ratio never
// implies work of unknown length.
templ eventsFunnel(total, ignored, matched, suppressed, gated, fired int) {
	<div class="card funnel" role="region" aria-label="Alert funnel, last 24 hours">
		<div class="funnel-counts">
			<span class="funnel-in">{ itoa(int64(total)) } in</span>
			<span class="funnel-ct">{ itoa(int64(ignored)) } ignored</span>
			<span class="funnel-ct matched">{ itoa(int64(matched)) } matched</span>
			<span class="funnel-ct wait">{ itoa(int64(suppressed)) } suppressed</span>
			<span class="funnel-ct wait">{ itoa(int64(gated)) } gated</span>
			<span class={ "funnel-ct fired", templ.KV("on", fired > 0) }>{ itoa(int64(fired)) } fired</span>
			<span class="funnel-note">last 24h · nothing ran without being on this page first</span>
		</div>
		<div class="funnel-bar" aria-hidden="true">
			@funnelSeg("ignored", ignored)
			@funnelSeg("matched", matched)
			@funnelSeg("suppressed", suppressed)
			@funnelSeg("gated", gated)
			@funnelSeg("fired", fired)
		</div>
	</div>
}

// funnelSeg is one flex-weighted bar segment; a zero count renders no segment
// at all, so the bar shows only the outcomes that actually happened.
templ funnelSeg(kind string, n int) {
	if n > 0 {
		<span class={ "funnel-seg", kind } style={ "flex-grow:" + itoa(int64(n)) }></span>
	}
}

// eventsFilters is the chip row: source splits first (D4), then the outcome
// chips, then the keyboard hint on the right. Counts are rows in view.
templ eventsFilters(vm eventsVM) {
	<div class="filters">
		<div class="filter-chips" role="group" aria-label="Filter events">
			@filterChip("all", vm.Filter == "all", vm.ChipCount("all"))
			@filterChip("checks", vm.Filter == "checks", vm.ChipCount("checks"))
			@filterChip("alerts", vm.Filter == "alerts", vm.ChipCount("alerts"))
			@filterChip("ignored", vm.Filter == "ignored", vm.ChipCount("ignored"))
			@filterChip("matched", vm.Filter == "matched", vm.ChipCount("matched"))
			@filterChip("suppressed", vm.Filter == "suppressed", vm.ChipCount("suppressed"))
			@filterChip("gated", vm.Filter == "gated", vm.ChipCount("gated"))
			@filterChip("fired", vm.Filter == "fired", vm.ChipCount("fired"))
			@filterChip("error", vm.Filter == "error", vm.ChipCount("error"))
		</div>
		<span class="keys-hint"><kbd>j</kbd> <kbd>k</kbd> move · <kbd>↵</kbd> expand · <kbd>e</kbd> explain</span>
	</div>
}

// filterChip is one outcome or source chip: a link that re-runs the page under
// that filter. The active chip carries the accent (aria-pressed mirrors it for
// a reader that never sees colour).
templ filterChip(key string, active bool, n int) {
	<a class={ "filter-chip", templ.KV("active", active) } href={ templ.SafeURL("/events?filter=" + key) } aria-pressed={ boolAttr(active) }>
		{ key } · { itoa(int64(n)) }
	</a>
}

// eventsTray is the tray table. Each row is one event; the whole row toggles
// the pane below it (payload + evaluation trace). The grid columns are the
// schema: RECEIVED · ALERT · SOURCE · MATCHED RULE · OUTCOME · REASON · chevron.
templ eventsTray(vm eventsVM) {
	<div class="card events-tray">
		<div class="evt-head" aria-hidden="true">
			<span>RECEIVED</span><span>ALERT</span><span>SOURCE</span><span>MATCHED RULE</span><span>OUTCOME</span><span>REASON</span><span class="evt-chev-col"></span>
		</div>
		for i, e := range vm.Rows {
			@eventTrayPair(i, e)
		}
	</div>
	<p class="events-foot">showing latest { itoa(int64(len(vm.Rows))) } of { itoa(vm.Total) } events · retained 90d · the enum is closed: ignored / matched / suppressed / gated / fired</p>
}

// eventTrayPair is one row button and its expand pane. The row keeps the
// keyboard cursor index on data-index; the pane id is the aria-controls target
// so j/k/↵/e and a click agree on what expanded.
templ eventTrayPair(i int, e eventRow) {
	<div class="evt-row" role="button" tabindex="0" data-index={ itoa(int64(i)) } aria-expanded="false" aria-controls={ "evt-pane-" + itoa64(e.ID) }>
		<span class="evt-time">{ e.Received }</span>
		<span class="evt-alert">{ e.Name }</span>
		<span class="evt-source">{ e.Source }</span>
		<span class="evt-rule">{ orDash(e.Rule) }</span>
		<span class={ "evt-outcome", e.TokenClass() }>
			<span class="evt-glyph" aria-hidden="true">{ e.TokenGlyph() }</span>
			<span class="evt-word">{ e.TokenWord() }</span>
		</span>
		if e.ReasonLink != "" {
			<a class="evt-reason" href={ templ.SafeURL(e.ReasonLink) }>{ e.Reason }</a>
		} else {
			<span class="evt-reason">{ e.Reason }</span>
		}
		<span class="evt-chev" aria-hidden="true">▸</span>
	</div>
	<div class="evt-panes" id={ "evt-pane-" + itoa64(e.ID) } hidden>
		<div class="evt-pane pane-payload">
			<div class="pane-kicker">NORMALIZED PAYLOAD</div>
			<pre>{ e.Normalized }</pre>
		</div>
		<div class="evt-pane pane-explain">
			<div class="pane-kicker kicker-accent">EXPLAIN · RULE EVALUATION TRACE</div>
			if len(e.Trace) == 0 {
				<p class="meta">No trace recorded.</p>
			} else {
				<table class="trace-mini">
					for _, s := range e.Trace {
						<tr>
							<td>
								if s.Passed {
									<span class="chip ok"><span class="dot"></span>PASS</span>
								} else {
									<span class="chip fail"><span class="dot"></span>STOP</span>
								}
							</td>
							<td class="mono">{ s.Step }</td>
							<td class="mono">{ orDash(s.Detail) }</td>
							<td class="meta">{ s.Reason }</td>
						</tr>
					}
				</table>
			}
		</div>
	</div>
}

// eventsKeys wires the tray's keyboard map: j/k move the current row, Enter
// and e expand it (e also brings the EXPLAIN pane into view), Esc collapses.
// Clicking a row toggles its pane; clicking the FIRED/GATED reason link inside
// it still navigates — the row handler skips anchor hits.
templ eventsKeys() {
	<script>
	(function () {
		var tray = document.querySelector(".events-tray");
		if (!tray) return;
		var rows = Array.prototype.slice.call(tray.querySelectorAll(".evt-row"));
		if (!rows.length) return;

		function currentRow() {
			for (var i = 0; i < rows.length; i++) {
				if (rows[i].classList.contains("current")) return rows[i];
			}
			return rows[0];
		}
		function setCurrent(row) {
			for (var j = 0; j < rows.length; j++) rows[j].classList.remove("current");
			row.classList.add("current");
			row.focus();
		}
		function isOpen(row) {
			return row.getAttribute("aria-expanded") === "true";
		}
		function toggle(row, focusExplain) {
			var open = !isOpen(row);
			row.setAttribute("aria-expanded", open ? "true" : "false");
			var pane = document.getElementById(row.getAttribute("aria-controls"));
			if (pane) pane.hidden = !open;
			var chev = row.querySelector(".evt-chev");
			if (chev) chev.textContent = open ? "▾" : "▸";
			if (open && focusExplain) {
				var explain = pane && pane.querySelector(".pane-explain");
				if (explain) explain.scrollIntoView({ block: "nearest" });
			}
		}
		rows.forEach(function (row) {
			row.addEventListener("click", function (e) {
				if (e.target.closest("a")) return;
				toggle(row, false);
			});
		});
		document.addEventListener("keydown", function (e) {
			var t = e.target;
			if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT")) return;
			var i = rows.indexOf(currentRow());
			if (e.key === "j" || e.key === "ArrowDown") {
				e.preventDefault();
				setCurrent(rows[Math.min(rows.length - 1, i + 1)]);
			} else if (e.key === "k" || e.key === "ArrowUp") {
				e.preventDefault();
				setCurrent(rows[Math.max(0, i - 1)]);
			} else if (e.key === "Enter") {
				e.preventDefault();
				toggle(currentRow(), false);
			} else if (e.key === "e") {
				e.preventDefault();
				toggle(currentRow(), true);
			} else if (e.key === "Escape") {
				var opened = currentRow();
				if (isOpen(opened)) toggle(opened, false);
			}
		});
	})();
	</script>
}

// eventTrace shows one event's stored evaluation trace: the per-condition
// pass/fail exactly as it was decided, not recomputed.
templ eventTrace(vm traceVM) {
	@layout(vm.Page) {
		@breadcrumb(breadcrumbCrumb{Label: "Events", Href: "/events"}, breadcrumbCrumb{Label: "#" + itoa64(vm.Event.ID)})
		<h1>Event #{ itoa64(vm.Event.ID) }</h1>
		<p class="meta">
			<span class="mono">{ vm.Event.Source }</span> · { vm.Event.Name } ·
			@chip(vm.Event.OutcomeClass(), string(vm.Event.Outcome))
			· { vm.Event.Received }
		</p>
		if vm.Event.JobID != nil {
			<p class="meta mt8">
				enqueued job <a href={ templ.SafeURL("/jobs/" + itoa64(*vm.Event.JobID)) }>#{ itoa64(*vm.Event.JobID) }</a>
			</p>
		}
		if len(vm.CheckObservations) > 0 {
			<div class="card mt14">
				<div class="kicker">Why this counted as a transition</div>
				<pre class="ledger">
					{ vm.LedgerLines() }
				</pre>
				<p class="meta mt8">hysteresis N=3 · one blip is not a transition</p>
				if vm.StartedAt != "" {
					<p class="meta">A status must hold for 3 consecutive observations before it becomes an event. A host already up when the daemon started ({ vm.StartedAt }) produces no event until it changes — absence of history is cold-start, not health.</p>
				} else {
					<p class="meta">A status must hold for 3 consecutive observations before it becomes an event. Absence of history is cold-start, not health.</p>
				}
			</div>
		}
		<div class="card mt14">
			<div class="kicker">Evaluation trace</div>
			if len(vm.Steps) == 0 {
				<p class="meta">No trace recorded.</p>
			} else {
				<div class="tablewrap">
					<table>
						<thead>
							<tr><th scope="col"></th><th scope="col">Step</th><th scope="col">Detail</th><th scope="col">Reason</th></tr>
						</thead>
						<tbody>
							for _, s := range vm.Steps {
								<tr>
									<td>
										if s.Passed {
											<span class="chip ok"><span class="dot"></span>PASS</span>
										} else {
											<span class="chip fail"><span class="dot"></span>STOP</span>
										}
									</td>
									<td class="mono">{ s.Step }</td>
									<td class="mono">{ orDash(s.Detail) }</td>
									<td class="meta">{ s.Reason }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<p class="meta mt14">Reason: { vm.Event.Reason }</p>
		</div>
	}
}