package web

// eventsList is the Events screen: a last-24h funnel card, the filter row
// (source switch + outcome chips, the closed enum always present), and a tray
// of every received alert with the stored payload and evaluation trace inline
// — so "why didn't it fire?" is answerable by expanding. The filter row is a
// plain GET (?source=…&outcome=…) so a filtered view stays linkable; the
// empty store hides the tray (W5) but never the enum.
templ eventsList(vm eventsVM) {
	@layout(vm.Page) {
		@eventsFunnel(vm.Funnel.Total(), vm.Funnel.Ignored, vm.Funnel.Matched, vm.Funnel.Suppressed, vm.Funnel.Gated, vm.Funnel.Fired)
		@eventsFilters(vm)
		if vm.Empty {
			<div class="card span2 mt18 events-empty">
				<p class="meta">No events yet. Point an alert source at exocomp ingest and they land here.</p>
			</div>
		} else {
			@eventsTray(vm)
		}
		@eventsKeys(vm.Page.Base)
	}
}

// eventsFunnel is the last-24h counts plus the proportional outcome bar, the
// one sentence below it, and the keyboard hint (SPEC §1.6) right of the
// counts — the hint leaves the filter row, which carries filters only. Each
// closed outcome renders as a monospace numeral over a small label (SPEC
// §2.5); the bar weights only the five outcomes of the closed enum, never the
// error sink, so the ratio never implies work of unknown length.
templ eventsFunnel(total, ignored, matched, suppressed, gated, fired int) {
	<div class="card funnel" role="region" aria-label="Alert funnel, last 24 hours">
		<div class="counts funnel-counts">
			<span class="funnel-ct funnel-in"><b>{ itoa(int64(total)) }</b><small>in</small></span>
			<span class="funnel-ct"><b>{ itoa(int64(ignored)) }</b><small>ignored</small></span>
			<span class="funnel-ct matched"><b>{ itoa(int64(matched)) }</b><small>matched</small></span>
			<span class="funnel-ct wait"><b>{ itoa(int64(suppressed)) }</b><small>suppressed</small></span>
			<span class="funnel-ct wait"><b>{ itoa(int64(gated)) }</b><small>gated</small></span>
			<span class={ "funnel-ct fired", templ.KV("on", fired > 0) }><b>{ itoa(int64(fired)) }</b><small>fired</small></span>
			<span class="keys" aria-hidden="true"><kbd>j</kbd> <kbd>k</kbd> move · <kbd>↵</kbd> expand · <kbd>e</kbd> explain · <kbd>o</kbd> outcome</span>
		</div>
		<div class="bar funnel-bar" aria-hidden="true">
			@funnelSeg("ignored", ignored)
			@funnelSeg("matched", matched)
			@funnelSeg("suppressed", suppressed)
			@funnelSeg("gated", gated)
			@funnelSeg("fired", fired)
		</div>
	</div>
}

// funnelSeg is one flex-weighted bar segment; a zero count renders no segment
// at all, so the bar shows only the outcomes that actually happened.
templ funnelSeg(kind string, n int) {
	if n > 0 {
		<span class={ "funnel-seg", kind } style={ "flex-grow:" + itoa(int64(n)) }></span>
	}
}

// eventsFilters is the filter row (SPEC §1): the SOURCE segmented switch
// (all · checks · alerts, exactly one on, all = reset, never accent — it is a
// scope), the 1px divider, then the OUTCOME chips in funnel order — all six
// always present, a zero count a <span aria-disabled> hairline ring, never a
// link. The groups are named by role=group + aria-label + title; no visible
// kicker on desktop. data-source/data-outcome name the active state so the
// `o` key can cycle the outcome group (TUI parity).
templ eventsFilters(vm eventsVM) {
	<div class="filters" data-source={ vm.Source } data-outcome={ vm.Outcome }>
		<div class="group" role="group" aria-label="Event source">
			<div class="switch" title="Source — where the event came from">
				<a href={ templ.SafeURL(vm.SourceHref("")) } aria-pressed={ boolAttr(vm.Source == "") }><span>all</span>@countCell(vm.ChipCount("all"))</a>
				<a href={ templ.SafeURL(vm.SourceHref("checks")) } aria-pressed={ boolAttr(vm.Source == "checks") }><span>checks</span>@countCell(vm.ChipCount("checks"))</a>
				<a href={ templ.SafeURL(vm.SourceHref("alerts")) } aria-pressed={ boolAttr(vm.Source == "alerts") }><span>alerts</span>@countCell(vm.ChipCount("alerts"))</a>
			</div>
		</div>
		<span class="divider" aria-hidden="true"></span>
		<div class="group group--outcome chips" role="group" aria-label="Event outcome" title="Outcome — what the pipeline decided">
			for _, o := range outcomeOrder {
				@outcomeChip(vm, o)
			}
		</div>
	</div>
}

// outcomeChip is one outcome chip: the active one is the only accent fill on
// the row, its href the reset (?outcome= removed, the source kept) and its
// trailing × the clear glyph; a zero count renders as a disabled span with
// the hairline ring — no link, no hover — so the enum shape never changes.
templ outcomeChip(vm eventsVM, o string) {
	if o == vm.Outcome {
		<a class="chip" href={ templ.SafeURL(vm.OutcomeHref(o)) } aria-pressed="true" title="Clear filter">
			{ o }
			@countCell(vm.ChipCount(o))
			<svg class="clear" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"></path></svg>
		</a>
	} else if vm.ChipCount(o) == 0 {
		<span class="chip" aria-disabled="true">
			{ o }
			@countCell(0)
		</span>
	} else {
		<a class="chip" href={ templ.SafeURL(vm.OutcomeHref(o)) }>
			{ o }
			@countCell(vm.ChipCount(o))
		</a>
	}
}

// countCell is the count's own tabular cell (SPEC §1.2): the word and the
// number are two columns, never "· N" inline. It carries the full twin
// ("1,204") and the compact k-form ("12.4k"); the stylesheet shows the k-form
// from five digits on desktop and four on phone.
templ countCell(n int) {
	<span class="count"><span class="full">{ commaCount(n) }</span><span class="k">{ compactCount(n) }</span></span>
}

// eventsTray is the stacked list of received alerts (SPEC §1a, SCREENS 1a).
// On desktop each row is ONE 44px line in the seven-column grid RECEIVED ·
// EVENT · SOURCE · MATCHED RULE · OUTCOME · REASON · ▸; the expand pane
// below carries the evaluation trace and the normalized payload. The reason
// (the "why") renders in the row itself with its link; the pane keeps the
// same line so the phone re-flow (which drops the column) still answers why.
// The footer repeats the state and the second reset (SPEC §1.4).
templ eventsTray(vm eventsVM) {
	<div class="card events-tray">
		<div class="events-head" aria-hidden="true">
			<span>RECEIVED</span><span>EVENT</span><span>SOURCE</span><span>MATCHED RULE</span><span>OUTCOME</span><span>REASON</span>
		</div>
		for i, e := range vm.Rows {
			@eventTrayPair(i, e)
		}
	</div>
	<p class="events-foot">
		showing latest { itoa(int64(len(vm.Rows))) } of { commaCount(vm.FooterCount()) }
		if vm.Outcome != "" {
			{ vm.Outcome } · { commaCount(vm.Funnel.Total()) } in view
		}
		· retained 90d
		if vm.Outcome != "" {
			· <a href={ urlWithBase(vm.Page.Base, "/events") }>show all</a>
		}
	</p>
}

// eventTrayPair is one row button and its expand pane. The row is the seven
// grid cells — received clock · age, alert, source, matched rule, the outcome
// glyph + keyword (left-aligned in its 96px slot), the reason (with its link),
// the chevron — and the pane spans the grid below. The row keeps the keyboard
// cursor index on data-index; the pane id is the aria-controls target so
// j/k/↵/e and a click agree on what expanded.
templ eventTrayPair(i int, e eventRow) {
	<div class={ "events-row", templ.KV("evt-rule-dedup", e.Source == e.Rule) } role="button" tabindex="0" data-index={ itoa(int64(i)) } aria-expanded="false" aria-controls={ "evt-pane-" + itoa64(e.ID) }>
		<span class="evt-received" aria-hidden="true">{ e.Received } · { e.Rel } ago</span>
		<span class="evt-alert">{ e.Name }</span>
		<span class="evt-source">{ e.Source }</span>
		<span class="evt-rule">{ orDash(e.Rule) }</span>
		<span class={ "evt-outcome", e.TokenClass() }>
			<span class="evt-glyph" aria-hidden="true">{ e.TokenGlyph() }</span>
			<span class="evt-word">{ e.TokenWord() }</span>
		</span>
		<span class="evt-reason">
			if e.ReasonLink != "" {
				<a href={ templ.SafeURL(e.ReasonLink) }>{ e.Reason }</a>
			} else {
				{ e.Reason }
			}
		</span>
		<span class="evt-chev" aria-hidden="true">▸</span>
		<div class="evt-pane expanded" id={ "evt-pane-" + itoa64(e.ID) } hidden>
			@eventReason(e)
			<div class="pane-kicker kicker-accent pane-trace">EXPLAIN · RULE EVALUATION TRACE</div>
			if len(e.Trace) == 0 {
				<p class="meta">No trace recorded.</p>
			} else {
				<table class="trace-mini">
					for _, s := range e.Trace {
						<tr>
							<td>
								if s.Passed {
									<span class="chip ok"><span class="dot"></span>PASS</span>
								} else {
									<span class="chip fail"><span class="dot"></span>STOP</span>
								}
							</td>
							<td class="mono">{ s.Step }</td>
							<td class="mono">{ orDash(s.Detail) }</td>
							<td class="meta">{ s.Reason }</td>
						</tr>
					}
				</table>
			}
			<button type="button" class="evt-payload-toggle" data-payload={ "evt-payload-" + itoa64(e.ID) }>Show normalized payload →</button>
			<div class="payload" id={ "evt-payload-" + itoa64(e.ID) }>
				<div class="pane-kicker">NORMALIZED PAYLOAD</div>
				<pre>{ e.Normalized }</pre>
			</div>
		</div>
	</div>
}

// eventReason is the pane's one "why" line. A fired or gated reason links to
// the job or approval that followed; every other outcome is plain text.
templ eventReason(e eventRow) {
	if e.ReasonLink != "" {
		<div class="evt-pane-reason">reason · <a href={ templ.SafeURL(e.ReasonLink) }>{ e.Reason }</a></div>
	} else {
		<div class="evt-pane-reason">reason · { e.Reason }</div>
	}
}

// eventsKeys wires the tray's keyboard map: j/k move the current row, Enter
// and e expand it (e also brings the trace into view), o cycles the outcome
// group through none → ignored → matched → suppressed → gated → fired → none
// (TUI parity, so a full pass returns to showing every event), Esc collapses.
// Clicking a row toggles its pane; clicking the payload button or a reason
// link inside it keeps their own behaviour — the row handler skips anchors
// and buttons. The payload button is additive: with no script the pane still
// shows the reason and trace, and the payload card stays inert behind the
// button.
templ eventsKeys(base string) {
	<script data-base={ base }>
	(function () {
		var script = document.currentScript;
		var base = script.getAttribute("data-base") || "";
		var tray = document.querySelector(".events-tray");
		if (!tray) return;
		var rows = Array.prototype.slice.call(tray.querySelectorAll(".events-row[data-index]"));
		if (!rows.length) return;

		function currentRow() {
			for (var i = 0; i < rows.length; i++) {
				if (rows[i].classList.contains("current")) return rows[i];
			}
			return rows[0];
		}
		function setCurrent(row) {
			for (var j = 0; j < rows.length; j++) rows[j].classList.remove("current");
			row.classList.add("current");
			row.focus();
		}
		function isOpen(row) {
			return row.getAttribute("aria-expanded") === "true";
		}
		function toggle(row, focusExplain) {
			var open = !isOpen(row);
			row.setAttribute("aria-expanded", open ? "true" : "false");
			var pane = document.getElementById(row.getAttribute("aria-controls"));
			if (pane) pane.hidden = !open;
			var chev = row.querySelector(".evt-chev");
			if (chev) chev.textContent = open ? "▾" : "▸";
			if (open && focusExplain) {
				var explain = pane && pane.querySelector(".pane-trace");
				if (explain) explain.scrollIntoView({ block: "nearest" });
			}
		}
		rows.forEach(function (row) {
			row.addEventListener("click", function (e) {
				if (e.target.closest("a,button")) return;
				toggle(row, false);
			});
		});
		tray.querySelectorAll(".evt-payload-toggle").forEach(function (btn) {
			btn.addEventListener("click", function () {
				var payload = document.getElementById(btn.getAttribute("data-payload"));
				if (!payload) return;
				payload.style.display = payload.style.display === "block" ? "" : "block";
			});
		});
		document.addEventListener("keydown", function (e) {
			var t = e.target;
			if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT" || t.tagName === "BUTTON" || t.tagName === "A")) return;
			var i = rows.indexOf(currentRow());
			if (e.key === "j" || e.key === "ArrowDown") {
				e.preventDefault();
				setCurrent(rows[Math.min(rows.length - 1, i + 1)]);
			} else if (e.key === "k" || e.key === "ArrowUp") {
				e.preventDefault();
				setCurrent(rows[Math.max(0, i - 1)]);
			} else if (e.key === "Enter") {
				e.preventDefault();
				toggle(currentRow(), false);
			} else if (e.key === "e") {
				e.preventDefault();
				toggle(currentRow(), true);
			} else if (e.key === "o") {
				e.preventDefault();
				var filters = document.querySelector(".filters");
				if (!filters) return;
				var src = filters.getAttribute("data-source") || "";
				var cur = filters.getAttribute("data-outcome") || "";
				var order = ["", "ignored", "matched", "suppressed", "gated", "fired"];
				var idx = order.indexOf(cur);
				var next = idx >= 0 ? order[(idx + 1) % order.length] : order[1];
				var q = [];
				if (src) q.push("source=" + src);
				if (next) q.push("outcome=" + next);
				window.location.href = base + "/events" + (q.length ? "?" + q.join("&") : "");
			} else if (e.key === "Escape") {
				var opened = currentRow();
				if (isOpen(opened)) toggle(opened, false);
			}
		});
	})();
	</script>
}

// eventTrace shows one event's stored evaluation trace: the per-condition
// pass/fail exactly as it was decided, not recomputed.
templ eventTrace(vm traceVM) {
	@layout(vm.Page) {
		@breadcrumb(breadcrumbCrumb{Label: "Events", Href: urlWithBase(vm.Page.Base, "/events")}, breadcrumbCrumb{Label: "#" + itoa64(vm.Event.ID)})
		<h1>Event #{ itoa64(vm.Event.ID) }</h1>
		<p class="meta">
			<span class="mono">{ vm.Event.Source }</span> · { vm.Event.Name } ·
			@chip(vm.Event.OutcomeClass(), string(vm.Event.Outcome))
			· { vm.Event.Received }
		</p>
		if vm.Event.JobID != nil {
			<p class="meta mt8">
				enqueued job <a href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/jobs/" + itoa64(*vm.Event.JobID))) }>#{ itoa64(*vm.Event.JobID) }</a>
			</p>
		}
		if len(vm.CheckObservations) > 0 {
			<div class="card mt14">
				<div class="kicker">Why this counted as a transition</div>
				<pre class="ledger">
					{ vm.LedgerLines() }
				</pre>
				<p class="meta mt8">hysteresis N=3 · one blip is not a transition</p>
				if vm.StartedAt != "" {
					<p class="meta">A status must hold for 3 consecutive observations before it becomes an event. A host already up when the daemon started ({ vm.StartedAt }) produces no event until it changes — absence of history is cold-start, not health.</p>
				} else {
					<p class="meta">A status must hold for 3 consecutive observations before it becomes an event. Absence of history is cold-start, not health.</p>
				}
			</div>
		}
		<div class="card mt14">
			<div class="kicker">Evaluation trace</div>
			if len(vm.Steps) == 0 {
				<p class="meta">No trace recorded.</p>
			} else {
				<div class="tablewrap">
					<table>
						<thead>
							<tr><th scope="col"></th><th scope="col">Step</th><th scope="col">Detail</th><th scope="col">Reason</th></tr>
						</thead>
						<tbody>
							for _, s := range vm.Steps {
								<tr>
									<td>
										if s.Passed {
											<span class="chip ok"><span class="dot"></span>PASS</span>
										} else {
											<span class="chip fail"><span class="dot"></span>STOP</span>
										}
									</td>
									<td class="mono">{ s.Step }</td>
									<td class="mono">{ orDash(s.Detail) }</td>
									<td class="meta">{ s.Reason }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<p class="meta mt14">Reason: { vm.Event.Reason }</p>
		</div>
	}
}
