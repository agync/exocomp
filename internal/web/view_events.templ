package web

// eventsList shows every received alert with its outcome, so "why didn't it
// fire?" is answerable by scanning (the brief's Event vocabulary). The
// ?source= filter narrows the list to one pipeline source; the form is a plain
// GET so a filtered view is a linkable URL.
templ eventsList(vm eventsVM) {
	@layout(vm.Page) {
		<div class="card span2 mt18 tray">
			<div class="kicker">Received alerts</div>
			<h3>All events</h3>
			if len(vm.Events) > 0 || vm.Source != "" {
				<form method="get" action="/events" class="writeform inline" data-autosubmit>
					<label for="ev-source">Source</label>
					<select id="ev-source" name="source">
						<option value="" selected?={ vm.Source == "" }>all</option>
						for _, src := range eventSourceFilterOptions {
							<option value={ src } selected?={ vm.Source == src }>{ src }</option>
						}
					</select>
					<button type="submit" class="btn">Filter</button>
				</form>
			}
			if len(vm.Events) == 0 {
				if vm.Source != "" {
					<p class="meta">No events from <span class="mono">{ vm.Source }</span> — change the source filter to see all events.</p>
				} else {
					<p class="meta">No events yet. Point an alert source at exocomp ingest and they land here.</p>
				}
			} else {
				<div class="tablewrap stackable">
					<table>
						<thead>
							<tr>
								<th scope="col">Event</th>
								<th scope="col">Job</th>
								<th scope="col">Source</th>
								<th scope="col">Alert</th>
								<th scope="col">Outcome</th>
								<th scope="col">Reason</th>
								<th scope="col" class="right">Received</th>
							</tr>
						</thead>
						<tbody>
							for _, e := range vm.Events {
								<tr data-href={ "/events/" + itoa64(e.ID) }>
									<td class="num" data-label="Event"><a href={ templ.SafeURL("/events/" + itoa64(e.ID)) }>#{ itoa64(e.ID) }</a></td>
									<td class="num" data-label="Job">
										if e.JobID != nil {
											<a href={ templ.SafeURL("/jobs/" + itoa64(*e.JobID)) }>#{ itoa64(*e.JobID) }</a>
										} else {
											<span class="meta">-</span>
										}
									</td>
									<td class="mono" data-label="Source">{ e.Source }</td>
									<td data-label="Alert">{ e.Name }</td>
									<td data-label="Outcome">@chip(e.OutcomeClass(), string(e.Outcome))</td>
									<td class="meta" data-label="Reason">{ e.Reason }</td>
									<td class="right num" data-label="Received">{ e.Received }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if vm.HasMore {
					<p class="meta mt14">
						<a href={ templ.SafeURL("/events?limit=" + itoa(int64(vm.NextLimit())) + "&source=" + urlEscape(vm.Source)) }>Load more</a>
					</p>
				}
			}
		</div>
	}
}

// eventTrace renders one event's stored evaluation trace: the per-condition
// pass/fail exactly as it was decided, not recomputed.
templ eventTrace(vm traceVM) {
	@layout(vm.Page) {
		@breadcrumb(breadcrumbCrumb{Label: "Events", Href: "/events"}, breadcrumbCrumb{Label: "#" + itoa64(vm.Event.ID)})
		<h1>Event #{ itoa64(vm.Event.ID) }</h1>
		<p class="meta">
			<span class="mono">{ vm.Event.Source }</span> · { vm.Event.Name } ·
			@chip(vm.Event.OutcomeClass(), string(vm.Event.Outcome))
			· { vm.Event.Received }
		</p>
		if vm.Event.JobID != nil {
			<p class="meta mt8">
				enqueued job <a href={ templ.SafeURL("/jobs/" + itoa64(*vm.Event.JobID)) }>#{ itoa64(*vm.Event.JobID) }</a>
			</p>
		}
		if len(vm.CheckObservations) > 0 {
			<div class="card mt14">
				<div class="kicker">Why this counted as a transition</div>
				<pre class="ledger">
					{ vm.LedgerLines() }
				</pre>
				<p class="meta mt8">hysteresis N=3 · one blip is not a transition</p>
				if vm.StartedAt != "" {
					<p class="meta">A status must hold for 3 consecutive observations before it becomes an event. A host already up when the daemon started ({ vm.StartedAt }) produces no event until it changes — absence of history is cold-start, not health.</p>
				} else {
					<p class="meta">A status must hold for 3 consecutive observations before it becomes an event. Absence of history is cold-start, not health.</p>
				}
			</div>
		}
		<div class="card mt14">
			<div class="kicker">Evaluation trace</div>
			if len(vm.Steps) == 0 {
				<p class="meta">No trace recorded.</p>
			} else {
				<div class="tablewrap">
					<table>
						<thead>
							<tr><th scope="col"></th><th scope="col">Step</th><th scope="col">Detail</th><th scope="col">Reason</th></tr>
						</thead>
						<tbody>
							for _, s := range vm.Steps {
								<tr>
									<td>
										if s.Passed {
											<span class="chip ok"><span class="dot"></span>PASS</span>
										} else {
											<span class="chip fail"><span class="dot"></span>STOP</span>
										}
									</td>
									<td class="mono">{ s.Step }</td>
									<td class="mono">{ orDash(s.Detail) }</td>
									<td class="meta">{ s.Reason }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<p class="meta mt14">Reason: { vm.Event.Reason }</p>
		</div>
	}
}
