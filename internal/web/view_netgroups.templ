package web

// netgroupsPanel is the Netgroups tab body on /checks (F7): named CIDR sets
// that classify an address — a webhook peer or a check target — so a rule
// writes `event.labels["netgroup"] == "home"` instead of a prefix literal. It
// renders without the shell (the checks page owns the tabs), and carries the
// operator add/remove controls. A netgroup holds no secret material, so the
// write controls here are plain operator-scope, like schedules.
templ netgroupsPanel(rows []netgroupRow, operator bool, form *netgroupFormVM) {
	if operator {
		@modal("netgroups-add", "Add a netgroup") {
			<p class="meta">Mirrors <code>exocomp netgroup add</code>: a name and a comma-separated CIDR list.</p>
			<form method="post" action="/netgroups/add" class="writeform" id="netgroup-add-form" novalidate data-netgroup-form>
				@fieldInput(form.nameField())
				@fieldInput(form.cidrField())
				@formStatus(form.Pending(), form.ErrFormText())
				<div class="actions"><button type="submit" class="btn primary" disabled?={ form.Pending() }>Add netgroup</button></div>
			</form>
			@netgroupFormJS()
		}
		if form != nil {
			// A JS-off refusal re-renders the whole page; open the dialog and
			// focus the first invalid control after it is in the DOM.
			<script>
			exoModalOpen("netgroups-add");
			var ngBad = document.querySelector('#netgroups-add input[aria-invalid="true"]');
			if (ngBad) ngBad.focus();
			</script>
		}
	}
	<div class="card span2 mt18 tray">
		<div class="kicker">Address classification</div>
		<h3>Netgroups</h3>
		<p class="meta">Netgroups classify an address for checks and webhook peers — the home/away verdict is a network-path fact, never health.</p>
		if !operator {
			<p class="meta">Read-only: managing netgroups needs an operator token.</p>
		}
		if len(rows) == 0 {
			<p class="meta">No netgroups registered — add one.</p>
		} else {
			<div class="tablewrap stackable">
				<table>
					<thead>
						<tr>
							<th scope="col">Netgroup</th>
							<th scope="col">CIDRs</th>
							if operator {
								<th scope="col">Actions</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, ng := range rows {
							<tr>
								<td data-label="Netgroup"><a href="/events?source=check">{ ng.Name }</a></td>
								<td class="mono wrap" data-label="CIDRs">{ ng.Display() }</td>
								if operator {
									<td data-label="Actions">
										@rowActions(netgroupRowActions(ng))
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// netgroupFormJS is the netgroup-add form's progressive enhancement. The form
// is novalidate (the daemon is authoritative), so submit is intercepted and
// POSTed with fetch: a 422 swaps the form fragment in place with the
// server-rendered refusals (JS-off gets the same bytes as a full re-render),
// anything else follows the redirect and its success flash. After a refusal a
// field re-validates on blur and clears when right; the primary disables only
// while submitting.
templ netgroupFormJS() {
	<script>
	(function () {
		function netgroupFormWire() {
			var form = document.getElementById("netgroup-add-form");
			if (!form || form.dataset.netgroupWired) return;
			form.dataset.netgroupWired = "1";

			function restoreMeta(input) {
				input.removeAttribute("aria-invalid");
				var meta = document.getElementById(input.getAttribute("aria-describedby"));
				if (meta) {
					meta.classList.remove("is-error");
					meta.textContent = input.name === "name"
						? "Letters, digits, dots, hyphens, underscores."
						: "Comma-separated. IPv4 or IPv6.";
				}
			}

			// showError paints a refusal on a field without changing its geometry
			// (the meta line always exists), mirroring the server's human copy.
			function showError(input, msg) {
				input.setAttribute("aria-invalid", "true");
				var meta = document.getElementById(input.getAttribute("aria-describedby"));
				if (meta) {
					meta.classList.add("is-error");
					meta.textContent = "▲ " + msg;
				}
			}

			// validateField runs the same client rules the server holds to — a
			// name/CIDR shape refusal — on blur so a mistake surfaces before
			// submit. Empty is left alone (that's a submit-time required check);
			// the moment a filled value is wrong the field says so, and clearing
			// it right clears the error. The daemon stays authoritative on
			// uniqueness etc., so submit still asks the server.
			function validateField(input) {
				if (input.value.trim() === "") return;
				if (input.name === "name") {
					if (!/^[A-Za-z0-9_.-]+$/.test(input.value.trim())) {
						showError(input, "Names can't have spaces.");
						return;
					}
					restoreMeta(input);
				} else {
					var parts = input.value.split(",");
					var bad = null;
					for (var i = 0; i < parts.length; i++) {
						var p = parts[i].trim();
						if (p === "") { bad = "Add at least one range, like 192.168.0.0/16."; break; }
						if (!/^\d{1,3}(\.\d{1,3}){3}\/\d{1,2}$/.test(p) && !/^[0-9a-fA-F:]+::\/\d{1,3}$/.test(p)) {
							bad = p + " needs four octets — like 192.168.0.0/16.";
							break;
						}
					}
					if (bad) { showError(input, bad); return; }
					restoreMeta(input);
				}
			}

			form.addEventListener("click", function (e) {
				var fill = e.target.closest("[data-fill]");
				if (fill) {
					e.preventDefault();
					var input = form.querySelector('input[name="' + fill.getAttribute("data-fill") + '"]');
					if (input) {
						input.value = fill.getAttribute("data-value");
						restoreMeta(input);
						input.focus();
					}
				}
				var retry = e.target.closest("[data-retry]");
				if (retry) {
					e.preventDefault();
					form.requestSubmit();
				}
			});

			form.addEventListener("submit", function (e) {
				e.preventDefault();
				var primary = form.querySelector('button[type="submit"]');
				var status = form.querySelector(".form-status");
				primary.disabled = true;
				status.innerHTML = '<span class="dot"></span>Adding';
				fetch(form.getAttribute("action"), {
					method: "POST",
					body: new FormData(form),
					credentials: "same-origin",
					headers: { "Accept": "text/html" }
				}).then(function (resp) {
					if (resp.status === 422) {
						return resp.text().then(function (html) {
							var doc = new DOMParser().parseFromString(html, "text/html");
							var next = doc.getElementById("netgroup-add-form");
							if (!next) return;
							form.outerHTML = next.outerHTML;
							form = document.getElementById("netgroup-add-form");
							form.dataset.netgroupRefused = "1";
							netgroupFormWire();
							var bad = form.querySelector('input[aria-invalid="true"]');
							if (bad) bad.focus();
						});
					}
					var loc = resp.headers.get("Location");
					if (loc) { window.location = loc; return; }
					window.location.reload();
				}).catch(function () {
					primary.disabled = false;
					status.textContent = "";
				});
			});

			// Validate on blur always (not just after a refusal) so a mistake
			// surfaces as soon as the operator leaves the field.
			form.addEventListener("blur", function (e) {
				var input = e.target.closest('input[name="name"], input[name="cidrs"]');
				if (!input) return;
				validateField(input);
			}, true);
		}
		netgroupFormWire();
	})();
	</script>
}