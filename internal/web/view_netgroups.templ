package web

// netgroupsList is the netgroups surface: named CIDR sets that classify an
// address — a webhook peer or a check target — with the operator's own
// vocabulary, so a rule says "home" instead of hardcoding the prefixes. Rows
// show the prefixes in full; they are config, not values. A netgroup carries
// no secret material, so — like schedules — the write controls here are plain
// operator-scope: no reauth, no confirm_token.
templ netgroupsList(vm netgroupsVM) {
	@layout(vm.Page) {
		<div class="pageheader">
			<h1>Netgroups</h1>
			if vm.Operator {
				@addButton("netgroups-add", "netgroup")
			}
		</div>
		if vm.Operator {
			@modal("netgroups-add", "Add a netgroup") {
				<p class="meta">Mirrors <code>exocomp netgroup add</code>: a name and a comma-separated CIDR list.</p>
				<form method="post" action="/netgroups/add" class="writeform">
					<label for="ng-name">Name</label>
					<input id="ng-name" name="name" type="text" required autocomplete="off" pattern="[A-Za-z0-9._-]+"/>
					<label for="ng-prefixes">CIDRs (comma-separated)</label>
					<input id="ng-prefixes" name="prefixes" type="text" required autocomplete="off" placeholder="192.168.0.0/16,10.0.0.0/8"/>
					<div class="actions"><button type="submit" class="btn primary">Add netgroup</button></div>
				</form>
			}
		}
		<div class="card span2" style="margin-top:18px">
			<div class="kicker">Address classification</div>
			<h3>All netgroups</h3>
			if !vm.Operator {
				<p class="meta">Read-only: managing netgroups needs an operator token.</p>
			}
			if len(vm.Netgroups) == 0 {
				<p class="meta">No netgroups registered — add one.</p>
			} else {
				<div class="tablewrap stackable">
					<table>
						<thead>
							<tr>
								<th scope="col">Netgroup</th>
								<th scope="col">CIDRs</th>
								if vm.Operator {
									<th scope="col">Actions</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, ng := range vm.Netgroups {
								<tr>
									<td data-label="Netgroup"><a href="/events?source=check">{ ng.Name }</a></td>
									<td class="mono wrap" data-label="CIDRs">{ ng.Join() }</td>
									if vm.Operator {
										<td data-label="Actions">
											<form method="post" action={ templ.SafeURL("/netgroups/" + ng.Name + "/rm") } style="display:inline" data-confirm={ "Remove netgroup " + ng.Name + "?" }>
												<input type="hidden" name="confirmed" value="1"/>
												<button type="submit" class="btn danger">Remove</button>
											</form>
										</td>
									}
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}