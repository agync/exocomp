package web

// The run surface: an operator enqueues a playbook or an ad-hoc command
// straight from the browser, through the SAME service verbs the CLI and the
// /api/v1 write API call (RunPlaybook, RunAdhoc). Unlike tokens/secrets, a run
// is not reauth-gated — it costs no credential, and the operator scope check in
// writeGuard is the whole gate.

templ runPage(vm runVM) {
	@layout(vm.Page) {
		<h1>Run</h1>
		if !vm.Operator {
			<div class="card span2" style="margin-top:18px">
				<div class="kicker">Read-only</div>
				<h3>Playbooks and commands</h3>
				<p class="meta">Enqueuing a run needs an operator-scoped token.</p>
			</div>
		} else {
			<div class="card span2" style="margin-top:18px">
				<h3>Run a playbook</h3>
				<p class="meta">Resolves --source and --inventory the same way the CLI does, then enqueues through the one queue.</p>
				<form method="post" action="/run/playbook" class="writeform">
					<label for="rp-playbook">Playbook path</label>
					<input id="rp-playbook" name="playbook" type="text" required autocomplete="off" placeholder="site.yml or /abs/path/site.yml"/>
					<label for="rp-source">Source (optional)</label>
					<input id="rp-source" name="source" type="text" autocomplete="off" placeholder="registered source name"/>
					<label for="rp-inventory">Inventory</label>
					<input id="rp-inventory" name="inventory" type="text" autocomplete="off" placeholder="registered name or path (empty: localhost)"/>
					<label for="rp-limit">Limit</label>
					<input id="rp-limit" name="limit" type="text" autocomplete="off" placeholder="host or group pattern"/>
					<label for="rp-tags">Tags</label>
					<input id="rp-tags" name="tags" type="text" autocomplete="off"/>
					<label for="rp-secrets">Run secrets binding</label>
					<input id="rp-secrets" name="run_secrets" type="text" autocomplete="off"/>
					<label class="checkline"><input type="checkbox" name="check" value="1"/> check mode (dry run)</label>
					<label class="checkline"><input type="checkbox" name="diff" value="1"/> show diff</label>
					<label for="rp-timeout">Timeout (optional, e.g. 10m)</label>
					<input id="rp-timeout" name="timeout" type="text" autocomplete="off" placeholder="no limit"/>
					<div class="actions"><button type="submit" class="btn primary">Run playbook</button></div>
				</form>
			</div>
			<div class="card span2" style="margin-top:18px">
				<h3>Run a command</h3>
				<p class="meta">The everyday ad-hoc run: a command against a host pattern through the ansible command (or shell) module.</p>
				<form method="post" action="/run/command" class="writeform">
					<label for="rc-host">Host pattern</label>
					<input id="rc-host" name="host" type="text" required autocomplete="off" placeholder="web or fedora:!nas"/>
					<label for="rc-command">Command</label>
					<input id="rc-command" name="command" type="text" required autocomplete="off" placeholder="systemctl status nginx"/>
					<label class="checkline"><input type="checkbox" name="shell" value="1"/> run through the shell module (pipes/redirects)</label>
					<label class="checkline"><input type="checkbox" name="become" value="1"/> become (privilege escalation)</label>
					<label for="rc-source">Source (optional)</label>
					<input id="rc-source" name="source" type="text" autocomplete="off" placeholder="registered source name"/>
					<label for="rc-inventory">Inventory</label>
					<input id="rc-inventory" name="inventory" type="text" autocomplete="off" placeholder="registered name or path (empty: localhost)"/>
					<label for="rc-secrets">Run secrets binding</label>
					<input id="rc-secrets" name="run_secrets" type="text" autocomplete="off"/>
					<label class="checkline"><input type="checkbox" name="require_approval" value="1"/> require approval before it runs</label>
					<label for="rc-timeout">Timeout (optional, e.g. 10m)</label>
					<input id="rc-timeout" name="timeout" type="text" autocomplete="off" placeholder="no limit"/>
					<div class="actions"><button type="submit" class="btn primary">Run command</button></div>
				</form>
			</div>
		}
	}
}
