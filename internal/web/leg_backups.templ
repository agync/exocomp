package web

// backupsCard is the backups leg of the /system self-care page (SPEC §4, A9):
// the targets freshness as the card's figure, the state chip, the Manage verb
// into /system/backups, and the one sentence that a running run does not move
// the age. The rows are the same freshness reads the dashboard card draws
// (vm.Backups), never a second query.
templ backupsCard(vm systemVM) {
	<section class="leg" id="backups" aria-label="Backups">
		<div class="leg-head">
			<span class="leg-id">
				<span class="name">@legGlyph(glyphBackups)<span>Backups</span></span>
				@chip(backupsCardChipClass(vm.Backups), backupsCardChipWord(vm.Backups))
			</span>
			<span class="verbs">
				<a class="btn quiet small" href={ urlWithBase(vm.Page.Base, "/system/backups") }>Manage</a>
			</span>
		</div>
		<div class="leg-figure">
			<span class={ "value", vm.BackupsAgeClass }>{ vm.BackupsAge }</span>
			<span class={ "note", vm.BackupsAgeClass }>since the newest SUCCEEDED run</span>
		</div>
		<div class="bk-card-rows" aria-label="Targets">
			for _, row := range vm.Backups {
				<div class="bk-card-row">
					<span class="bk-name">{ row.Name }</span>
					<span class={ "bk-state", row.StateClass() }>{ row.StateWord() }</span>
					<span class="bk-age">{ row.AgeLine() }</span>
				</div>
			}
		</div>
		<dl class="leg-facts"></dl>
		<p class="leg-sentence">
			any one target recovers the system · restore is the DR path
		</p>
	</section>
}

// The card chip's word and class split so the chip() component gets its two
// arguments.
func backupsCardChipWord(rows []backupRow) string {
	w, _ := backupsCardChip(rows)
	return w
}

func backupsCardChipClass(rows []backupRow) string {
	_, c := backupsCardChip(rows)
	return c
}

// StateClass on backupRow mirrors the target-row palette for the card's state
// word: ok for succeeded, fail for failed, run for a RUNNING breathe, dim for
// a disabled or never-run target.
func (r backupRow) StateClass() string {
	switch r.State {
	case "succeeded":
		return "ok"
	case "failed":
		return "fail"
	case "running":
		return "run"
	case "disabled":
		return "dim"
	default:
		return "dim"
	}
}

// StateWord is the mini table's state word: the UPPERCASE run state, DISABLED
// for a disabled target, NEVER for one that has not run.
func (r backupRow) StateWord() string {
	switch r.State {
	case "succeeded":
		return "SUCCEEDED"
	case "failed":
		return "FAILED"
	case "running":
		return "RUNNING"
	case "disabled":
		return "DISABLED"
	default:
		return "NEVER"
	}
}

// AgeLine is the mini table's age cell: the age (or "never ran"), with a
// RUNNING run's job id named beside its elapsed time (A9).
func (r backupRow) AgeLine() string {
	if r.State == "running" {
		return r.Age + " · job #" + itoa64(r.RunningJobID)
	}
	return r.Age
}
