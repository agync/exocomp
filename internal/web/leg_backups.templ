package web

// backupsCard is the backups leg of the /system self-care page (SPEC §4, A9):
// the targets freshness as the card's figure, the state chip, the Manage verb
// into /system/backups, and the one sentence that a running run does not move
// the age. The rows are the same freshness reads the dashboard card draws
// (vm.Backups), never a second query.
templ backupsCard(vm systemVM) {
	<section class="leg" id="backups" aria-label="Backups">
		<div class="leg-head">
			<span class="name">@legGlyph(glyphBackups)<span>Backups</span></span>
			@chip(backupsCardChipClass(vm.Backups), backupsCardChipWord(vm.Backups))
			<span class="verbs">
				<a class="verb" href={ urlWithBase(vm.Page.Base, "/system/backups") }>Manage</a>
			</span>
		</div>
		<div class="leg-figure">
			<div class="bk-card-rows">
				for _, row := range vm.Backups {
					<div class="bk-card-row">
						<span class="bk-id">
							<span class="bk-name">{ row.Name }</span>
							<span class="bk-kind">{ row.Kind }</span>
							<span class="bk-snap mono">{ row.ShortFact() }</span>
						</span>
						<span class={ "bk-state", row.StateClass() }>{ row.State }</span>
						<span class="bk-age">{ row.Age }</span>
					</div>
				}
			</div>
		</div>
		<dl class="leg-facts"></dl>
		<p class="leg-sentence">
			any one target recovers the system · freshness ok &lt; 24h · wait &lt; 48h · fail ·
			restore is the DR path · a running run does not move the age
		</p>
	</section>
}

// The card chip's word and class split so the chip() component gets its two
// arguments.
func backupsCardChipWord(rows []backupRow) string {
	w, _ := backupsCardChip(rows)
	return w
}

func backupsCardChipClass(rows []backupRow) string {
	_, c := backupsCardChip(rows)
	return c
}

// StateClass on backupRow mirrors the target-row palette for the card's state
// word: ok for succeeded, fail for failed, run for a RUNNING breathe, dim for
// never.
func (r backupRow) StateClass() string {
	switch r.State {
	case "succeeded":
		return "ok"
	case "failed":
		return "fail"
	case "running":
		return "run"
	default:
		return "dim"
	}
}
