package web

// backupsCard is the backups leg of the /system self-care page (SPEC §4): a
// STUB this round with the §0.1 anatomy, id=backups. L-S4 fills it: the
// targets freshness and the Manage verb to /system/backups.
templ backupsCard(vm systemVM) {
	<section class="leg" id="backups" aria-label="Backups">
		<div class="leg-head">
			<span class="name">@legGlyph(glyphBackups)<span>Backups</span></span>
			<span class="verbs"></span>
		</div>
		<div class="leg-figure"><span class="value dim">—</span></div>
		<dl class="leg-facts"></dl>
		<p class="leg-sentence"></p>
	</section>
}
