package web

// sourceDetail is a single source's page: a read-only identity card (kind,
// trust, ref, last sync — and, for an operator, the Disable/Delete controls and
// the "Launch a run…" verb) followed by a right-anchored launch drawer (F4). The
// drawer carries the Playbook | Command tab pair, both POSTing to a
// source-scoped run route (/sources/{name}/run/*), so every browser run reads
// from a registered source's own tree. The tabs are switched by a few lines of
// vanilla JS (hidden toggling + aria-selected); the server picks the first tab
// and prefills the playbook from the query string, so the page is deep-linkable
// (?tab=playbook&playbook=site.yml). JS-off: ?launch=1 renders the drawer's
// open attribute, so the launcher still opens without script.
templ sourceDetail(vm sourceDetailVM) {
	@layout(vm.Page) {
		@breadcrumb(breadcrumbCrumb{Label: "Sources", Href: "/sources"}, breadcrumbCrumb{Label: vm.Source.Name})
		<div class="card span2 mt18">
			<div class="detailmeta">
				<span class="chip"><span class="dot"></span>{ vm.Source.Kind }</span>
				if vm.Source.Kind == "path" {
					if vm.Writable {
						<span class="chip"><span class="dot"></span>WRITABLE</span>
					} else {
						<span class="chip dim"><span class="dot"></span>READ-ONLY</span>
					}
				}
				@signedChip(vm.Source)
				@enabledChip(vm.Source.Enabled, false)
			</div>
			<dl class="kv">
				<div><dt>URI</dt><dd class="mono wrap">{ orDash(vm.Source.URI) }</dd></div>
				<div><dt>Ref</dt><dd class="mono">{ orDash(vm.Source.Ref) }</dd></div>
				<div><dt>Last sync</dt>
					if vm.Source.NeverSynced() {
						<dd class="mono wait-text">never — sync to discover playbooks</dd>
					} else {
						<dd class="mono">{ vm.Source.Short() }</dd>
					}
				</div>
			</dl>
			if vm.Operator {
				<div class="rowactions">
					if vm.Source.NeverSynced() {
						<span class="meta" title="sync is a CLI verb — the web surface only reads a source's tree">
							<code>exocomp source sync { vm.Source.Name }</code>
						</span>
					}
					<button type="button" class="btn primary" data-modal-open="launch">Launch a run…</button>
					if vm.Source.Enabled {
						<form method="post" action={ templ.SafeURL("/sources/" + vm.Source.Name + "/disable") } class="inline-form">
							<button type="submit" class="btn quiet">Disable</button>
						</form>
					} else {
						<form method="post" action={ templ.SafeURL("/sources/" + vm.Source.Name + "/enable") } class="inline-form">
							<button type="submit" class="btn quiet">Enable</button>
						</form>
					}
					<form method="post" action={ templ.SafeURL("/sources/" + vm.Source.Name + "/rm") } class="inline-form" data-confirm={ "Delete source " + vm.Source.Name + "?" }>
						<input type="hidden" name="confirmed" value="1"/>
						<button type="submit" class="btn danger">Delete…</button>
					</form>
				</div>
			}
		</div>
		if !vm.Operator {
			<div class="card span2 mt18">
				<div class="kicker">Read-only</div>
				<h3>Launch a run</h3>
				<p class="meta">Enqueuing a run from this source needs an operator-scoped token.</p>
			</div>
		} else {
			<dialog class="modal drawer" id="launch" aria-labelledby="launch-title" open?={ vm.Launch }>
				<div class="modal-head">
					<h2 id="launch-title">Launch a run</h2>
					<button type="button" class="modal-close" data-modal-dismiss aria-label="Close">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
							<path d="M3 3l10 10M13 3L3 13"></path>
						</svg>
					</button>
				</div>
				<p class="meta">{ vm.LaunchMeta() }</p>
				<div class="modal-body">
					<div class="tabs" role="tablist" aria-label="Launcher">
						<button
							type="button"
							class="tab"
							id="tab-playbook"
							role="tab"
							data-tab="playbook"
							aria-controls="panel-playbook"
							aria-selected={ boolAttr(vm.Tab == "playbook") }
						>Playbook</button>
						<button
							type="button"
							class="tab"
							id="tab-command"
							role="tab"
							data-tab="command"
							aria-controls="panel-command"
							aria-selected={ boolAttr(vm.Tab == "command") }
						>Command</button>
					</div>
					<div id="panel-playbook" class="tabpanel" role="tabpanel" aria-labelledby="tab-playbook" hidden?={ vm.Tab != "playbook" }>
						<form method="post" action={ templ.SafeURL("/sources/" + vm.Source.Name + "/run/playbook") } class="writeform">
							<label for="rp-select">Playbook</label>
							if len(vm.Playbooks) == 0 {
								<select id="rp-select" name="playbook" disabled>
									<option value="">path — none discovered yet</option>
								</select>
								<p class="meta">Unsynced source: give a path relative to the checkout.</p>
							} else {
								<select id="rp-select" name="playbook">
									<option value="">— choose a discovered playbook —</option>
									for _, pb := range vm.Playbooks {
										if vm.PlaybookKnown() && pb == vm.Playbook {
											<option value={ pb } selected>{ pb }</option>
										} else {
											<option value={ pb }>{ pb }</option>
										}
									}
									<option value="__other__">other path…</option>
								</select>
							}
							<label for="rp-path">Or a path relative to the checkout</label>
							<input id="rp-path" name="playbook_path" type="text" autocomplete="off" placeholder="deploy/site.yml" value={ vm.FreePrefill() }/>
							<label for="rp-inventory">Inventory</label>
							<input id="rp-inventory" name="inventory" type="text" autocomplete="off" placeholder="registered name or path (empty: source ansible.cfg / discovery)"/>
							<label for="rp-limit">Limit</label>
							<input id="rp-limit" name="limit" type="text" autocomplete="off" placeholder="host or group pattern"/>
							<label for="rp-tags">Tags</label>
							<input id="rp-tags" name="tags" type="text" autocomplete="off"/>
							<label for="rp-secrets">Run secrets binding</label>
							<input id="rp-secrets" name="run_secrets" type="text" autocomplete="off"/>
							<details class="opts">
								<summary>Options — inventory, limit, tags, secrets</summary>
								@toggle("check", "check mode (dry run)", false, false)
								@toggle("diff", "show diff", false, false)
								<label for="rp-timeout">Timeout (optional, e.g. 10m)</label>
								<input id="rp-timeout" name="timeout" type="text" autocomplete="off" placeholder="no limit"/>
							</details>
							<div class="privileged">
								@toggle("privileged", "Run unsandboxed (privileged)", false, true)
								<p class="meta">Full host access, no kernel sandbox. Operator only; the run is audited and attributed.</p>
							</div>
							<div class="actions">
								<button type="submit" class="btn primary">{ vm.QueueLabel() }</button>
								<p class="meta">enqueued, never executed directly · Esc closes</p>
							</div>
						</form>
					</div>
					<div id="panel-command" class="tabpanel" role="tabpanel" aria-labelledby="tab-command" hidden?={ vm.Tab != "command" }>
						<form method="post" action={ templ.SafeURL("/sources/" + vm.Source.Name + "/run/command") } class="writeform">
							<label for="rc-host">Host pattern</label>
							<input id="rc-host" name="host" type="text" required autocomplete="off" placeholder="web or fedora:!nas"/>
							<label for="rc-command">Command</label>
							<input id="rc-command" name="command" type="text" required autocomplete="off" placeholder="systemctl status nginx"/>
							@toggle("shell", "run through the shell module (pipes/redirects)", false, false)
							@toggle("become", "become (privilege escalation)", false, false)
							<label for="rc-inventory">Inventory</label>
							<input id="rc-inventory" name="inventory" type="text" autocomplete="off" placeholder="registered name or path (empty: source ansible.cfg / discovery)"/>
							<label for="rc-secrets">Run secrets binding</label>
							<input id="rc-secrets" name="run_secrets" type="text" autocomplete="off"/>
							@toggle("require_approval", "require approval before it runs", false, false)
							<div class="privileged">
								@toggle("privileged", "Run unsandboxed (privileged)", false, true)
								<p class="meta">Full host access, no kernel sandbox. Operator only; the run is audited and attributed.</p>
							</div>
							<div class="actions">
								<button type="submit" class="btn primary">{ vm.QueueLabel() }</button>
								<p class="meta">enqueued, never executed directly · Esc closes</p>
							</div>
						</form>
					</div>
					<script>
					(function () {
						var tabs = Array.prototype.slice.call(document.querySelectorAll('#launch .tabs [role="tab"]'));
						if (tabs.length === 0) return;
						function select(key) {
							tabs.forEach(function (t) {
								var on = t.getAttribute("data-tab") === key;
								t.setAttribute("aria-selected", on ? "true" : "false");
								var panel = document.getElementById(t.getAttribute("aria-controls"));
								if (panel) panel.hidden = !on;
							});
						}
						tabs.forEach(function (t) {
							t.addEventListener("click", function () { select(t.getAttribute("data-tab")); });
						});
					})();
					</script>
				</div>
			</dialog>
		}
	}
}
