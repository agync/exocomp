package web

// sourceDetail is a single source's page: a read-only identity card (kind,
// trust, ref, last sync — and, for an operator, the Disable/Delete controls and
// the "Launch a run" verb) followed by a right-anchored launch drawer (F4). The
// drawer carries the Playbook | Command tab pair, both POSTing to a
// source-scoped run route (/sources/{name}/run/*), so every browser run reads
// from a registered source's own tree. The tabs are switched by a few lines of
// vanilla JS (hidden toggling + aria-selected + the roving tabindex), with
// Arrow/Home/End driving the tablist for a keyboard operator; the server picks
// the first tab, prefills the playbook from the query string, and so the page
// is deep-linkable (?tab=playbook&playbook=site.yml). JS-off: ?launch=1 renders
// the drawer's open attribute, so the launcher still opens without script.
templ sourceDetail(vm sourceDetailVM) {
	@layout(vm.Page) {
		@breadcrumb(breadcrumbCrumb{Label: "Sources", Href: urlWithBase(vm.Page.Base, "/sources")}, breadcrumbCrumb{Label: vm.Source.Name})
		<div class="card span2 mt18">
			<div class="detailmeta">
				<span class="chip"><span class="dot"></span>{ vm.Source.Kind }</span>
				if vm.Source.Kind == "path" {
					if vm.Writable {
						<span class="chip"><span class="dot"></span>WRITABLE</span>
					} else {
						<span class="chip dim"><span class="dot"></span>READ-ONLY</span>
					}
				}
				@signedChip(vm.Source)
				@enabledChip(vm.Source.Enabled, false)
			</div>
			<dl class="kv">
				<div><dt>URI</dt><dd class="mono wrap">{ orDash(vm.Source.URI) }</dd></div>
				if vm.Source.Ref != "" {
					<div><dt>Ref</dt><dd class="mono">{ vm.Source.Ref }</dd></div>
				}
				<div><dt>Last sync</dt>
					<dd class={ templ.KV("mono", true), templ.KV("wait-text", vm.Source.NeverSynced()) }>{ vm.Source.LastSyncLabel() }</dd>
				</div>
				if vm.EgressDefaultLabel() != "" {
					<div><dt>Egress ports</dt><dd class="mono">{ vm.EgressDefaultLabel() }</dd></div>
				}
				if vm.DefaultRunSecrets != "" {
					<div><dt>Run-secrets</dt><dd class="mono">{ vm.DefaultRunSecrets }</dd></div>
				}
			</dl>
			if vm.Operator {
				<div class="rowactions">
					<button type="button" class="btn primary" data-modal-open="launch">Launch a run</button>
					if vm.Source.Kind == "git" {
						<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + vm.Source.Name + "/sync")) } class="inline-form">
							<button type="submit" class="btn">Sync now</button>
						</form>
					}
					if vm.Source.Enabled {
						<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + vm.Source.Name + "/disable")) } class="inline-form">
							<button type="submit" class="btn quiet">Disable</button>
						</form>
					} else {
						<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + vm.Source.Name + "/enable")) } class="inline-form">
							<button type="submit" class="btn quiet">Enable</button>
						</form>
					}
					<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + vm.Source.Name + "/rm")) } class="inline-form" data-confirm={ "Delete source " + vm.Source.Name + "? Its cached Python venv and ansible collections are removed with it." }>
						<button type="submit" class="btn danger">Delete</button>
					</form>
				</div>
				if vm.RmRefusal != "" {
					@formStatus(false, vm.RmRefusal)
				}
				if vm.SyncRefusal != "" {
					@formStatus(false, vm.SyncRefusal)
				}
			}
		</div>
		if vm.Source.NeverSynced() {
			<p class="meta mt8">Sync with "Sync now" or run <code>exocomp source sync { vm.Source.Name }</code> on the host to bring the checkout down and read its playbooks.</p>
		}
		if vm.Operator {
			<div class="card span2 mt18">
				<div class="kicker">Egress default</div>
				<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + vm.Source.Name + "/egress")) } class="writeform">
					@fieldInput(vm.EgressDefaultField())
					<p class="meta">Every ansible run from this source inherits these ports, unioned with the ports that run declares. The sandbox filters egress by port, not by destination — a granted port reaches any host on that port, not only the intended one.</p>
					@formStatus(false, vm.EgressRefusal, "Setting egress")
					<div class="actions">
						<button type="submit" class="btn">Set egress default</button>
					</div>
				</form>
				<p class="meta">{ vm.EgressCliEcho() } on the host</p>
			</div>
			<div class="card span2 mt18">
				<div class="kicker">Run-secrets default</div>
				<form method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + vm.Source.Name + "/run-secrets")) } class="writeform">
					@fieldInput(vm.RunSecretsDefaultField())
					<p class="meta">Every ansible run from this source, including one a rule fires or a play schedule names, injects this binding's env unless the run names its own. Handoff and bootstrap plays name no source and do not inherit it. The vault project stays per run.</p>
					@formStatus(false, vm.RunSecretsRefusal, "Setting run-secrets")
					<div class="actions">
						<button type="submit" class="btn">Set run-secrets default</button>
					</div>
				</form>
				<p class="meta">{ vm.RunSecretsCliEcho() } on the host</p>
			</div>
		}
		<div class="card span2 mt18">
			<div class="kicker">Playbooks</div>
			if len(vm.Playbooks) == 0 {
				<p class="meta">{ vm.PlaybooksNote() }</p>
			} else {
				<ul class="playbooklist">
					for _, pb := range vm.Playbooks {
						<li class="mono">
							if vm.Operator {
								<a class="playbook-row" href={ templ.SafeURL(vm.PlaybookHref(pb)) }>{ pb }<span class="chev" aria-hidden="true">›</span></a>
							} else {
								{ pb }
							}
						</li>
					}
				</ul>
			}
		</div>
		if !vm.Operator {
			<div class="card span2 mt18">
				<div class="kicker">Read-only</div>
				<h3>Launch a run</h3>
				<p class="meta">Enqueuing a run from this source needs an operator-scoped token.</p>
			</div>
		} else {
			<dialog class="modal drawer" id="launch" aria-labelledby="launch-title" open?={ vm.Launch }>
				<div class="modal-head">
					<h2 id="launch-title">Launch a run</h2>
					<button type="button" class="modal-close" data-modal-dismiss aria-label="Close">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
							<path d="M3 3l10 10M13 3L3 13"></path>
						</svg>
					</button>
				</div>
				<p class="meta">{ vm.LaunchMeta() }</p>
				<div class="modal-body">
					<div class="tabs" role="tablist" aria-label="Launcher">
						<button
							type="button"
							class="tab"
							id="tab-playbook"
							role="tab"
							data-tab="playbook"
							aria-controls="panel-playbook"
							aria-selected={ boolAttr(vm.Tab == "playbook") }
							if vm.Tab == "playbook" {
								tabindex="0"
							} else {
								tabindex="-1"
							}
						>Playbook</button>
						<button
							type="button"
							class="tab"
							id="tab-command"
							role="tab"
							data-tab="command"
							aria-controls="panel-command"
							aria-selected={ boolAttr(vm.Tab == "command") }
							if vm.Tab == "command" {
								tabindex="0"
							} else {
								tabindex="-1"
							}
						>Command</button>
					</div>
					<div id="panel-playbook" class="tabpanel" role="tabpanel" aria-labelledby="tab-playbook" hidden?={ vm.Tab != "playbook" }>
						<form id="launch-pb-form" method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + vm.Source.Name + "/run/playbook")) } class="writeform">
							<label for="rp-select">Playbook</label>
							if len(vm.Playbooks) == 0 {
								<select id="rp-select" name="playbook" disabled aria-invalid?={ vm.playbookRefused() } aria-describedby="rp-select-meta">
									<option value="">path — none discovered yet</option>
								</select>
								<span id="rp-select-meta" class={ "meta", templ.KV("is-error", vm.playbookRefused()) }>
									if vm.playbookRefused() {
										<span class="msg">{ vm.playbookRefusal() }</span>
									} else {
										{ vm.PlaybooksNote() }
									}
								</span>
							} else {
								// The first found playbook is PRESELECTED — the
								// launcher states one concrete run before any input
								// (SPEC §5.2), so there is no placeholder option.
								// An unknown ?playbook= prefill (a free path)
								// selects the "other path…" sentinel instead. A
								// refusal re-render keeps the form's posted choice.
								<select id="rp-select" name="playbook" aria-invalid?={ vm.playbookRefused() } aria-describedby="rp-select-meta">
									for _, pb := range vm.Playbooks {
										if selectedPlaybook(vm, pb) {
											<option value={ pb } selected>{ pb }</option>
										} else {
											<option value={ pb }>{ pb }</option>
										}
									}
									<option value="__other__" selected?={ otherPathSelected(vm) }>other path…</option>
								</select>
								<span id="rp-select-meta" class={ "meta", templ.KV("is-error", vm.playbookRefused()) }>
									if vm.playbookRefused() {
										<span class="msg">{ vm.playbookRefusal() }</span>
									} else {
										{ vm.PlaybooksMeta() }
									}
								</span>
							}
							@fieldInput(vm.RunForm.limitField())
							@fieldInput(vm.RunForm.egressField(vm.EgressPrefill()))
							<div class="toggle-row">
								@toggle("tolerate_unreachable", "Tolerate unreachable hosts", vm.toggleState("tolerate_unreachable"), false)
								<p class="meta">may end <span class="wait-text">DEGRADED</span></p>
							</div>
							<details class="opts">
								<summary>More <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ glyphChevron }></path></svg></summary>
								<p class="opts-help">path, inventory, tags, secrets, run modes</p>
								<label for="rp-path">Or a path relative to the checkout</label>
								<input id="rp-path" name="playbook_path" type="text" autocomplete="off" placeholder="deploy/site.yml" value={ freePathValue(vm) }/>
								<label for="rp-inventory">Inventory</label>
								<input id="rp-inventory" name="inventory" type="text" autocomplete="off" placeholder="registered name or path (empty: source ansible.cfg / discovery)"/>
								<label for="rp-tags">Tags</label>
								<input id="rp-tags" name="tags" type="text" autocomplete="off"/>
								<label for="rp-secrets">Run secrets binding</label>
								<input id="rp-secrets" name="run_secrets" type="text" autocomplete="off"/>
								@toggle("check", "check mode (dry run)", vm.toggleState("check"), false)
								@toggle("diff", "show diff", vm.toggleState("diff"), false)
								@fieldInput(vm.RunForm.timeoutField("rp-timeout"))
							</details>
							<div class="privileged">
								@toggle("privileged", "Run unsandboxed (privileged)", vm.toggleState("privileged"), true)
								<p class="meta">Full host access, no kernel sandbox. Operator only; the run is audited and attributed. Prefer reaching the host over SSH when only the far side needs elevation — that keeps the sandbox on.</p>
							</div>
							@formStatus(vm.runPending(), vm.runFormText(), "Queueing run")
						</form>
					</div>
					<div id="panel-command" class="tabpanel" role="tabpanel" aria-labelledby="tab-command" hidden?={ vm.Tab != "command" }>
						<form id="launch-cmd-form" method="post" action={ templ.SafeURL(urlWithBase(vm.Page.Base, "/sources/" + vm.Source.Name + "/run/command")) } class="writeform">
							@fieldInput(vm.RunForm.hostField())
							@fieldInput(vm.RunForm.commandField())
							@toggle("shell", "run through the shell module (pipes/redirects)", vm.toggleState("shell"), false)
							@toggle("become", "become (privilege escalation)", vm.toggleState("become"), false)
							<label for="rc-inventory">Inventory</label>
							<input id="rc-inventory" name="inventory" type="text" autocomplete="off" placeholder="registered name or path (empty: source ansible.cfg / discovery)"/>
							@fieldInput(vm.RunForm.timeoutField("rc-timeout"))
							<label for="rc-secrets">Run secrets binding</label>
							<input id="rc-secrets" name="run_secrets" type="text" autocomplete="off"/>
							@toggle("require_approval", "require approval before it runs", vm.toggleState("require_approval"), false)
							<div class="privileged">
								@toggle("privileged", "Run unsandboxed (privileged)", vm.toggleState("privileged"), true)
								<p class="meta">Full host access, no kernel sandbox. Operator only; the run is audited and attributed. Prefer reaching the host over SSH when only the far side needs elevation — that keeps the sandbox on.</p>
							</div>
							@formStatus(vm.runPending(), vm.runFormText(), "Queueing run")
						</form>
					</div>
					<script>
					(function () {
						var tabs = Array.prototype.slice.call(document.querySelectorAll('#launch .tabs [role="tab"]'));
						if (tabs.length === 0) return;
						function select(key) {
							tabs.forEach(function (t) {
								var on = t.getAttribute("data-tab") === key;
								t.setAttribute("aria-selected", on ? "true" : "false");
								// Roving tabindex: the one tab stop follows the selection.
								t.setAttribute("tabindex", on ? "0" : "-1");
								var panel = document.getElementById(t.getAttribute("aria-controls"));
								if (panel) panel.hidden = !on;
							});
							Array.prototype.slice.call(document.querySelectorAll('#launch [data-foot]')).forEach(function (f) {
								f.hidden = f.getAttribute("data-foot") !== key;
							});
						}
						tabs.forEach(function (t, i) {
							t.addEventListener("click", function () { select(t.getAttribute("data-tab")); });
							// Arrow keys step the tablist and wrap; Home/End jump to its ends.
							// The move selects AND focuses: both panels are already in the
							// DOM, so following focus with selection costs nothing.
							t.addEventListener("keydown", function (e) {
								var next = -1;
								if (e.key === "ArrowRight") next = (i + 1) % tabs.length;
								else if (e.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
								else if (e.key === "Home") next = 0;
								else if (e.key === "End") next = tabs.length - 1;
								else return;
								e.preventDefault();
								var target = tabs[next];
								select(target.getAttribute("data-tab"));
								target.focus();
							});
						});
					})();
					</script>
				</div>
				<div class="drawer-actions" data-foot="playbook" hidden?={ vm.Tab != "playbook" }>
					<div class="actions">
						<button type="submit" form="launch-pb-form" class="btn primary" disabled?={ vm.runPending() }>Queue run</button>
					</div>
					<p class="meta drawer-foot">{ vm.CliEcho() } · Esc closes</p>
				</div>
				<div class="drawer-actions" data-foot="command" hidden?={ vm.Tab != "command" }>
					<div class="actions">
						<button type="submit" form="launch-cmd-form" class="btn primary" disabled?={ vm.runPending() }>Queue run</button>
					</div>
					<p class="meta drawer-foot">enqueued, never executed directly · Esc closes</p>
				</div>
			</dialog>
		}
	}
}
