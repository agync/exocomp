package web

// enabledChip states a row's enabled/disabled posture as a labelled chip — dim
// DISABLED when off, ok ENABLED when on. hideEnabled hides the default-enabled
// chip: a table column whose header carries the default shows state only when
// it diverges (the design system's F12 rule for the Checks/Sources columns).
// The chip is never color-only.
templ enabledChip(enabled, hideEnabled bool) {
	if !enabled {
		<span class="chip dim"><span class="dot"></span>DISABLED</span>
	} else if !hideEnabled {
		<span class="chip ok"><span class="dot"></span>ENABLED</span>
	}
}

// addButton is the app bar's right-slot verb: a labeled ghost button (the bar
// holds no filled accent, SPEC §2.6) that opens the surface's add-modal (via
// the data-modal-open convention modalInit wires up). The visible text is the
// accessible name — no glyph-only control.
templ addButton(target string, text string) {
	<button type="button" class="btn addbtn" data-modal-open={ target }>
		{ text }
	</button>
}

// appbarAdd is the app bar's per-tab add region, keyed by the stable id
// "appbar-add". A client-side tab swap replaces only its own surface fragment,
// so a tab whose primary differs (Checks: Add check vs Add netgroup) must carry
// this region in the fragment response too; the swap JS replaces #appbar-add in
// place. Renders nothing when the surface exposes no add verb.
templ appbarAdd(a *pageAdd) {
	if a != nil {
		<span class="appbar-action" id="appbar-add">@addButton(a.Target, a.ButtonText())</span>
	}
}

// toggle is the run-option switch shared by the source launcher and the job
// rerun modal, replacing the plain checklines so every boolean run-option reads
// as one consistent control. The real <input type="checkbox" role="switch"> is
// the form field AND the JS-off fallback (it submits name=value=1 when on,
// nothing when off, exactly like the checkbox it replaces); the track is pure
// CSS on top, driven by :checked, so no script is needed. role="switch" maps
// checked→aria-checked for assistive tech, the label wraps the control so its
// text is the accessible name and a click toggles, and the focus ring lands on
// the track via :focus-visible. warn tints the on-state with the fail signal for
// the privileged (unsandboxed) escalation.
templ toggle(name, label string, checked, warn bool) {
	<label class={ "toggle", templ.KV("warn", warn) }>
		<input type="checkbox" role="switch" name={ name } value="1" class="toggle-cb" checked?={ checked }/>
		<span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
		<span class="toggle-text">{ label }</span>
	</label>
}
