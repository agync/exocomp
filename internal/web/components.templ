package web

// enabledChip states a row's enabled/disabled posture as a labelled chip — ok
// when enabled, dim when not — never color-only. Shared by the sources,
// schedules, and policies surfaces, mirroring how signedChip and chip are shared
// rather than repeating the same conditional in each template.
templ enabledChip(enabled bool) {
	if enabled {
		<span class="chip ok"><span class="dot"></span>ENABLED</span>
	} else {
		<span class="chip dim"><span class="dot"></span>DISABLED</span>
	}
}

// addButton is the "+" affordance a surface's <h1> sits next to; clicking it
// opens the modal with id target (via the data-modal-open convention modalInit
// wires up). label names the thing being added (e.g. "source") for the
// accessible name — the glyph itself carries no visible text.
templ addButton(target, label string) {
	<button type="button" class="addbtn" data-modal-open={ target } aria-label={ "Add " + label }>
		<svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
			<path d="M8 2v12M2 8h12"></path>
		</svg>
	</button>
}

// toggle is the run-option switch shared by the source launcher and the job
// rerun modal, replacing the plain checklines so every boolean run-option reads
// as one consistent control. The real <input type="checkbox" role="switch"> is
// the form field AND the JS-off fallback (it submits name=value=1 when on,
// nothing when off, exactly like the checkbox it replaces); the track is pure
// CSS on top, driven by :checked, so no script is needed. role="switch" maps
// checked→aria-checked for assistive tech, the label wraps the control so its
// text is the accessible name and a click toggles, and the focus ring lands on
// the track via :focus-visible. warn tints the on-state with the fail signal for
// the privileged (unsandboxed) escalation.
templ toggle(name, label string, checked, warn bool) {
	<label class={ "toggle", templ.KV("warn", warn) }>
		<input type="checkbox" role="switch" name={ name } value="1" class="toggle-cb" checked?={ checked }/>
		<span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
		<span class="toggle-text">{ label }</span>
	</label>
}
