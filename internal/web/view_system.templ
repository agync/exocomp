package web

// systemPage is the control-plane's view of itself: the health of the running
// binary (version + Litestream replication RPO) and backup freshness. These
// moved off the glance dashboard and the footer — the dashboard answers "is the
// managed estate OK?", this answers "is the control plane itself OK?".
templ systemPage(vm systemVM) {
	@layout(vm.Page) {
		<div class="cards mt18">
			<section class="card span2 tray" aria-labelledby="self-h">
				<div class="kicker">Control-plane health</div>
				<h3 id="self-h">This control plane</h3>
				<div class="tablewrap">
					<table>
						<thead>
							<tr><th scope="col">Signal</th><th scope="col">State</th><th scope="col">Detail</th></tr>
						</thead>
						<tbody>
							<tr>
								<td>Running version</td>
								<td class="mono">{ vm.Self.Version }</td>
								<td class="meta">the binary an upgrade replaces</td>
							</tr>
							<tr>
								<td>Litestream RPO</td>
								<td>@chip(vm.Self.LSClass, vm.Self.LSAge)</td>
								<td class="meta">{ vm.Self.LSDetail }</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section class="card span2" aria-labelledby="pub-h">
				<h3 id="pub-h">Public URL</h3>
				<p class="meta">The base URL a phone companion dials, and the root of an approval link. It seeds the pairing QR on the tokens page; when unset, pairing falls back to the address the browser reached this page on.</p>
				if vm.PublicURL != "" {
					<p>Current: <span class="mono">{ vm.PublicURL }</span></p>
				} else {
					<p class="meta">Not set.</p>
				}
				if vm.BasePath != "" {
					<p>Base path: <span class="mono">{ vm.BasePath }</span></p>
				} else {
					<p>Base path: <span class="mono">origin root</span></p>
				}
				if vm.Operator {
					<form method="post" action={ urlWithBase(vm.Page.Base, "/system/public-url") } class="writeform">
						<label for="pub-url">Public URL</label>
						<input id="pub-url" name="url" type="url" required autocomplete="off" placeholder="https://exocomp.example.ts.net" value={ vm.PublicURL }/>
						<button type="submit" class="btn primary">Save</button>
					</form>
					<p class="meta mt8"><code>exocomp serve --public-url</code> also sets this.</p>
				}
			</section>

			<section class="card span2 tray" aria-labelledby="backups-h">
				<div class="kicker">Backup freshness</div>
				<h3 id="backups-h">Backups</h3>
				if len(vm.Backups) == 0 {
					<p class="meta">No backup targets configured.</p>
				} else {
					<div class="tablewrap">
						<table>
							<thead>
								<tr><th scope="col">Target</th><th scope="col">Snapshot</th><th scope="col" class="right">Age</th></tr>
							</thead>
							<tbody>
								for _, b := range vm.Backups {
									<tr>
										<td>
											{ b.Name }
											if b.Drill {
												<span class="chip dim ml6">drill</span>
											}
										</td>
										<td class="mono">{ orDash(b.Snapshot) }</td>
										<td class="right">@chip(b.Freshness, b.Age)</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>
		</div>
	}
}
