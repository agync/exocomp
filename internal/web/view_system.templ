package web

// v0.13 system-management glyphs (SCREENS.txt GLYPHS): stroke SVGs, 24
// viewBox, currentColor. A multi-part glyph (bell, archive, doctor) is one
// path with several M subpaths. The litestream replica box is a rounded-rect
// path (the artboard draws it as a rect element).
const (
	glyphDeadman  = "M3 12h4l2-6 4 12 2-6h6"
	glyphNtfy     = "M6 16V11a6 6 0 0 1 12 0v5l2 2H4zM10 21h4"
	glyphReplica  = "M5 3h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM9 21h10a2 2 0 0 0 2-2V9"
	glyphBackups  = "M3 7h18v4H3zM5 11v9h14v-9M10 15h4"
	glyphDoctor   = "M12 3l8 3v6c0 4.5-3.4 7.8-8 9-4.6-1.2-8-4.5-8-9V6zM9 12l2 2 4-4"
	glyphKit      = "M5 6h14v14H5zM7 9h10M7 12h10M7 15h10"
)

// legGlyph renders one stroke-SVG glyph at the 18px size the leg headers and
// header glyphs use.
templ legGlyph(d string) {
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d={ d }></path>
	</svg>
}

// systemPage is the /system self-care surface (SPEC §0, artboard 1a): the
// identity strip and the four leg cards in a 2×2 grid. The four legs render as
// stubs this round — the leg lanes fill the card bodies next. The public-URL
// Change form carries the forms anatomy (SPEC §7 A7): the always-present field
// meta, the 20px status line, and the 422 re-render that keeps the typed value.
templ systemPage(vm systemVM) {
	@layout(vm.Page) {
		<section class="sys-identity" aria-label="Control-plane identity">
			<span class="id">
				<span class="version">exocomp { vm.Version }</span>
				<span class="meta">· { vm.Commit } · { vm.Platform }</span>
				<span class="meta">· on <span class="host">{ vm.Host }</span> · { vm.Uptime }</span>
			</span>
			<span class="right">
				<span class="pub">
					<span class="label">public URL</span>
					if vm.PublicURL != "" {
						<a class="val" href={ vm.PublicURL }>{ vm.PublicURL }</a>
					} else {
						<span class="val none">not set</span>
					}
					if vm.Operator {
						<button type="submit" form="pubform" class="change" data-pub-toggle>Change</button>
					}
				</span>
				<span class="hg">
					<form method="post" action={ urlWithBase(vm.Page.Base, "/system/doctor") } class="hglyphform" aria-label="Doctor — run the self-check">
						<button type="submit" class="hglyph" title="Doctor — run the self-check">@legGlyph(glyphDoctor)</button>
					</form>
					if vm.Doctor.HasRun {
						<a class={ "hglyphmeta", templ.KV("wait", vm.Doctor.Stale) } href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/jobs/" + itoa64(vm.Doctor.JobID))) }>
							doctor { vm.Doctor.Age } ago · { itoa(int64(vm.Doctor.Count)) } findings
						</a>
					}
				</span>
			<span class="hg">
					<button type="button" class="hglyph" data-modal-open="kit" title="Recovery kit — regenerate" aria-label="Recovery kit — regenerate">@legGlyph(glyphKit)</button>
					if vm.Kit.Printed != "" {
						<span class={ "hglyphmeta", templ.KV("wait", vm.Kit.Stale) }>
							kit printed { vm.Kit.Printed } · { itoa(int64(vm.Kit.Changes)) } changes since
						</span>
					}
				</span>
			</span>
		if vm.Operator {
			// The Change form rests CLOSED and lives INSIDE the strip: at rest
			// the server marks it hidden (rendering nothing — no stray input
			// below the strip), and the row's Change toggle expands it to a
			// full-width surface-rail row within the strip. A 422 re-render
			// (data-open) and JS-off (the noscript reveal) both show it. The
			// toggle is the form's own submit via the form attribute, so
			// JS-off posts the same bytes a full re-render does.
			<form method="post" action={ urlWithBase(vm.Page.Base, "/system/public-url") } class="pubform" id="pubform" aria-label="Change public URL" novalidate data-pubform data-open?={ vm.PubForm != nil } hidden?={ vm.PubForm == nil }>
				<input type="url" name="url" id="pub-url" value={ vm.PubForm.ValueFor(vm.PublicURL) } autocomplete="off" spellcheck="false"
					aria-invalid?={ vm.PubForm.ErrMsgText() != "" }
					aria-describedby="pub-url-meta"/>
				<span id="pub-url-meta" class={ "meta", templ.KV("is-error", vm.PubForm.ErrMsgText() != "") }>
					if vm.PubForm.ErrMsgText() != "" {
						<span class="msg">{ vm.PubForm.ErrMsgText() }</span>
					} else {
						approval links and the kit use this
					}
				</span>
				@formStatus(vm.PubForm.Pending(), vm.PubForm.ErrFormText(), "Changing")
			</form>
			<noscript>
				<style>#pubform[hidden]{display:flex !important}</style>
			</noscript>
			@pubFormJS()
		}
	</section>

		<div class="sys-legs">
			@deadmanCard(vm)
			@ntfyCard(vm)
			@litestreamCard(vm.Litestream, vm.Page.Base)
			@backupsCard(vm)
		</div>

		@kitModal(vm)

		<div class="sys-phone">
			<a class="leg-row" href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/system/deadman")) }>
				<span class="name">Dead-man</span>
				<span class="meta">{ vm.Deadman.Figure }</span>
				@chip(vm.Deadman.StateClass, vm.Deadman.StateWord)
				<span class="leg-chev" aria-hidden="true">›</span>
			</a>
			<a class="leg-row" href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/system/ntfy")) }>
				<span class="name">ntfy</span>
				<span class="meta">{ vm.Ntfy.Figure() }</span>
				@chip(vm.Ntfy.ChipClass(), vm.Ntfy.Word())
				<span class="leg-chev" aria-hidden="true">›</span>
			</a>
			<a class="leg-row" href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/system/litestream")) }>
				<span class="name">Litestream</span>
				<span class="meta">{ vm.Litestream.Figure }</span>
				@chip(vm.Litestream.StateClass, vm.Litestream.State)
				<span class="leg-chev" aria-hidden="true">›</span>
			</a>
			<a class="leg-row" href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/system/backups")) }>
				<span class="name">Backups</span>
				<span class="meta">{ vm.BackupsAge }</span>
				@chip(backupsCardChipClass(vm.Backups), backupsCardChipWord(vm.Backups))
				<span class="leg-chev" aria-hidden="true">›</span>
			</a>
		</div>
	}
}

// pubFormJS is the Change form's progressive enhancement: the form rests
// CLOSED (the server renders it hidden; JS-off reveals it through the noscript
// rule) and the row's Change toggle expands it to a full-width row INSIDE the
// strip. Once expanded, the toggle is the form's own submit (form attribute),
// intercepted and POSTed with fetch — a 422 swaps the form fragment in place
// with the server-rendered refusal and the typed value kept (a refusal
// re-renders with data-open, so it never re-collapses), anything else follows
// the redirect and its success flash.
templ pubFormJS() {
	<script>
	(function () {
		function pubFormWire() {
			var form = document.getElementById("pubform");
			if (!form || form.dataset.pubformWired) return;
			form.dataset.pubformWired = "1";
			var toggle = document.querySelector('[data-pub-toggle]');
			if (!toggle) return;
			// A closed form expands on Change; an open one submits.
			toggle.addEventListener("click", function (e) {
				if (!form.hidden) return;
				e.preventDefault();
				form.hidden = false;
				var first = form.querySelector("input");
				if (first) first.focus();
			});
			form.addEventListener("submit", function (e) {
				e.preventDefault();
				var status = form.querySelector(".form-status");
				toggle.disabled = true;
				status.innerHTML = '<span class="dot"></span>Changing';
				fetch(form.getAttribute("action"), {
					method: "POST",
					body: new FormData(form),
					credentials: "same-origin",
					headers: { "Accept": "text/html" }
				}).then(function (resp) {
					if (resp.status === 422) {
						return resp.text().then(function (html) {
							var doc = new DOMParser().parseFromString(html, "text/html");
							var next = doc.getElementById("pubform");
							if (!next) return;
							form.outerHTML = next.outerHTML;
							form = document.getElementById("pubform");
							form.dataset.pubformRefused = "1";
							pubFormWire();
							var bad = form.querySelector('input[aria-invalid="true"]');
							if (bad) bad.focus();
						});
					}
					var loc = resp.headers.get("Location");
					if (loc) { window.location = loc; return; }
					window.location.reload();
				}).catch(function () {
					toggle.disabled = false;
					status.textContent = "";
				});
			});
		}
		pubFormWire();
	})();
	</script>
}

// kitModal is the Recovery-kit dialog (m97): the regenerated kit — recipients,
// salt and the derivation recipe, the envelope's PUBLIC render — in a scrollable
// mono block with the shared Copy glyph, a Download verb that pulls the same
// text as an attachment, and a primary that records the print (the reprint
// POST). The recovery secret never renders here: it exists in memory only at
// mint, and the modal shows KitStructure().Render() and nothing else.
templ kitModal(vm systemVM) {
	@modal("kit", "Recovery kit") {
		<p class="kicker">RECOVERY KIT</p>
		<p class="meta">Regenerated from what is already stored — recipients, salt and the derivation recipe. The recovery secret appears only when it is minted, never on this page.</p>
		<div class="run-cmd">
			<pre class="run-cmd-code">{ vm.KitText }</pre>
			<button type="button" class="copybtn" aria-label="Copy to clipboard" title="Copy">
				<svg class="copy-i" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
				<svg class="copy-ok" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
			</button>
		</div>
		<form method="post" action={ urlWithBase(vm.Page.Base, "/system/kit/reprint") } class="writeform">
			<div class="actions">
				<a class="btn" href={ templ.SafeURL(urlWithBase(vm.Page.Base, "/system/kit")) }>Download</a>
				<button type="submit" class="btn primary">Printed — destroy the old page</button>
			</div>
		</form>
	}
}

// The four leg cards live in leg_deadman.templ / leg_ntfy.templ /
// leg_litestream.templ / leg_backups.templ — each carries the §0.1 anatomy
// (word · figure · facts · one verb). The leg lanes L-S1..L-S4 own those files.
