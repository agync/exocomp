package web

// litestreamCard is the litestream leg of the /system self-care page (SPEC
// §3): the six word-states (REPLICATING · STALE · BEHIND · REMOTE · NO REPLICA
// · NO SIDECAR, plus the wait UNPARSEABLE) with the §0.1 anatomy — chip ·
// figure · facts · sentence — and the two read-only views as header buttons:
// config (the generated yml on the leg page) and the DR-drawer restore link.
// The leg is read-only by design (Decision 0012: the daemon generates config and
// observes, it never runs litestream), so the verbs slot holds no verb that
// mutates anything.
templ litestreamCard(ls litestreamVM, base string) {
	<section class="leg" id="litestream" aria-label="Litestream" data-state={ ls.StateClass }>
		<div class="leg-head">
			<span class="leg-id">
				<span class="name">@legGlyph(glyphReplica)<span>Litestream</span></span>
				@chip(ls.StateClass, ls.State)
			</span>
			<span class="verbs">
				<a class="btn quiet small" href={ templ.SafeURL(urlWithBase(base, "/system/litestream#config")) }>Config</a>
				<a class="btn quiet small" href={ templ.SafeURL(urlWithBase(base, "/system/backups?from=litestream#restore")) }>Restore</a>
			</span>
		</div>
		<div class="leg-figure">
			<span class={ "value", ls.StateClass }>{ ls.Figure }</span>
			<span class={ "note", ls.StateClass }>{ ls.FigureNote }</span>
		</div>
		<dl class="leg-facts">
			if ls.Replica != "" {
				<dt>replica</dt>
				<dd class="ellipsis">{ ls.Replica }</dd>
			}
			if ls.Checkpoint != "" {
				<dt>checkpoint</dt>
				<dd>{ ls.Checkpoint }</dd>
			}
			if ls.Encryption != "" {
				<dt>encryption</dt>
				<dd>{ ls.Encryption }</dd>
			}
			if ls.Sidecar != "" {
				<dt>sidecar</dt>
				<dd>{ ls.Sidecar }</dd>
			}
			if ls.ConfigCmd != "" {
				<dt>config</dt>
				<dd class="ellipsis">{ ls.ConfigCmd }</dd>
			}
			if ls.SetOne != "" {
				<dt>set one</dt>
				<dd class="ellipsis">{ ls.SetOne }</dd>
			}
			if ls.Fix != "" {
				<dt>fix</dt>
				<dd class="ellipsis">{ ls.Fix }</dd>
			}
		</dl>
		if ls.Sentence != "" {
			<p class="leg-sentence">{ ls.Sentence }</p>
		}
	</section>
}
